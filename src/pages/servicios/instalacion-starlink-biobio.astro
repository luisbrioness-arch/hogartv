                <strong class="block text-white">🏠 Casa A</strong>
                <span class="text-slate-400">Wi-Fi y clave propia</span>
              </div>
              <div class="p-2.5 rounded-xl bg-slate-900 border border-slate-700">
                <strong class="block text-white">🏠 Casa B</strong>
                <span class="text-slate-400">UTP (&lt;80m) o Fibra (100–500m)</span>
              </div>
            </div>
          </div>

          <!-- Esquema Cámara Portón -->
          <div class="p-4 rounded-2xl bg-slate-950 border border-indigo-500/30 space-y-2.5">
            <h3 class="text-xs sm:text-sm font-black text-indigo-300 text-center">📹 Cámara en Portón o Galpón Lejano</h3>
            <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 text-xs space-y-1">
