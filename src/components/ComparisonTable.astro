---
interface Props {
  title?: string;
  headers: string[];
  rows: {
    feature: string;
    values: string[];
  }[];
  verdict?: string;
}

const { title = 'Tabla Comparativa Rápida', headers, rows, verdict } = Astro.props;
---

<div class="my-8 overflow-hidden rounded-2xl border border-slate-800 bg-surface-card shadow-xl">
  <div class="bg-slate-900/90 px-6 py-4 border-b border-slate-800 flex items-center justify-between">
    <h3 class="text-base md:text-lg font-bold text-white flex items-center gap-2">
      <svg class="w-5 h-5 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
      </svg>
      <span>{title}</span>
    </h3>
    <span class="text-xs text-slate-400 font-mono hidden sm:inline-block">Chile 2026</span>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left text-xs sm:text-sm">
      <thead class="bg-slate-950/60 text-slate-300 uppercase tracking-wider font-semibold border-b border-slate-800 text-[11px]">
        <tr>
          {headers.map((h, idx) => (
            <th class={`px-4 sm:px-6 py-3.5 ${idx === 0 ? 'text-slate-400' : 'text-brand-300'}`}>
              {h}
            </th>
          ))}
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800/80">
        {rows.map((row, rIdx) => (
          <tr class={rIdx % 2 === 0 ? 'bg-surface-card' : 'bg-slate-900/30'}>
            <td class="px-4 sm:px-6 py-3.5 font-medium text-slate-200 whitespace-nowrap bg-slate-900/40">
              {row.feature}
            </td>
            {row.values.map((val) => (
              <td class="px-4 sm:px-6 py-3.5 text-slate-300">
                {val}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {verdict && (
    <div class="p-4 bg-brand-950/30 border-t border-brand-900/30 text-xs text-brand-200 flex items-start gap-2">
      <span class="text-brand-400 font-bold">💡 Veredicto:</span>
      <span>{verdict}</span>
    </div>
  )}
</div>
