---
interface Props {
  format?: 'banner' | 'rectangle' | 'in-feed' | 'in-article';
  label?: string;
  client?: string;
  slot?: string;
}

const { format = 'in-feed', label = 'Publicidad Recomendada', client, slot } = Astro.props;

const formatClasses = {
  'banner': 'min-h-[100px] sm:min-h-[120px] max-w-4xl',
  'rectangle': 'min-h-[250px] max-w-[336px]',
  'in-feed': 'min-h-[120px] max-w-2xl',
  'in-article': 'min-h-[250px] max-w-2xl',
};

const defaultClient = import.meta.env.PUBLIC_ADSENSE_ID || 'ca-pub-5268337462639131';
const finalClient = (client && !client.includes('XXXXXXXXXXXXXXXX')) ? client : defaultClient;
const hasValidSlot = Boolean(slot && slot !== '1234567890');
const isDev = import.meta.env.DEV;
---

{hasValidSlot ? (
  <div class={`my-8 mx-auto w-full ${formatClasses[format]} flex flex-col items-center justify-center rounded-xl overflow-hidden relative bg-transparent`}>
    <span class="absolute top-0 left-0 text-[9px] text-slate-500 bg-slate-900/50 px-2 py-0.5 rounded-br-md z-10">{label}</span>
    <ins class="adsbygoogle w-full h-full block"
         style="display:block; text-align:center;"
         data-ad-layout={format === 'in-article' ? 'in-article' : undefined}
         data-ad-format={format === 'in-article' ? 'fluid' : 'auto'}
         data-ad-client={finalClient}
         data-ad-slot={slot}
         data-full-width-responsive="true"></ins>
    <script is:inline>
         (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </div>
) : isDev ? (
  <div class={`my-8 mx-auto w-full ${formatClasses[format]} flex flex-col items-center justify-center rounded-xl overflow-hidden relative bg-slate-900/40 border border-dashed border-slate-800 p-4`}>
    <span class="text-[10px] uppercase tracking-widest text-slate-600 mb-1">{label}</span>
    <span class="text-xs text-slate-500 text-center">Espacio AdSense (Auto Ads activo en producción)</span>
  </div>
) : null}
