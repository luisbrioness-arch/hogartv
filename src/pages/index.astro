    price: preciosData['samsung-soundbar-b550'].precioFormateado,
    subPrice: 'Subwoofer inalámbrico incluido',
    image: imgSamsungBar,
    reviewUrl: '/accesorios/mejores-barras-de-sonido-calidad-precio-chile/',
    reviewLabel: 'Ver comparativa de audio →',
    primaryCtaText: 'Mercado Libre',
    primaryCtaUrl: afiliadosData['samsung-soundbar-b550'].url,
    primaryCtaClass: 'bg-[#FFE600] hover:bg-[#F5D600] text-slate-950 border-yellow-400',
    secondaryCtaText: 'Falabella',
    secondaryCtaUrl: afiliadosData['falabella-samsung-soundbar'].url,
    secondaryCtaClass: 'bg-[#008A00] hover:bg-[#007000] text-white border-emerald-400',
  },
];

// Picadas Baratas bajo $45.000 CLP (Compras de Impulso)
const impulseDeals = [
  {
    title: 'Lagarto Verde Movimiento Auto y Moto (Viral)',
    desc: 'Adorno 3D con resorte que baila con el movimiento del auto',
    price: '$ 2.990 - $ 5.990 CLP',
    image: imgLagartija,
