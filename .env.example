# Google Analytics 4 Measurement ID (ejemplo: G-XXXXXXXXXX)
# Si está vacío o no existe, no se inyecta ningún script ni comentario en el HTML.
# El tracking se excluye automáticamente en desarrollo local (import.meta.env.DEV).
PUBLIC_GA4_ID=

# Google Search Console Verification Token (contenido de la etiqueta meta)
# Ejemplo: u8cK9xL2abcdef123456...
# Si está vacío o no existe, no se inyecta el meta tag de verificación.
PUBLIC_GSC_VERIFICATION=

# Enlace de afiliado Mercado Libre para Chromecast (formato https://meli.la/XXXXXXX)
# Si no está definido, utiliza el valor por defecto configurado en src/data/afiliados.json
PUBLIC_CHROMECAST_GOOGLE_TV_URL=
