    <!-- ======================================================================= -->
    <!-- 7. CIERRE DIRECTO Y CLARO + AVISO LEGAL DISCRETO                        -->
    <!-- ======================================================================= -->
    <section class="max-w-4xl mx-auto px-3.5 sm:px-6 lg:px-8 pt-2 pb-4 space-y-5">
      <div class="p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-emerald-950/80 via-slate-900 to-slate-900 border-2 border-emerald-500/50 text-center shadow-2xl space-y-3.5">
        <h2 class="text-xl sm:text-2xl font-black text-white leading-snug">
          ¿Quieres cotizar tu instalación en el Biobío?
        </h2>
        <p class="text-xs sm:text-sm text-slate-300 max-w-xl mx-auto leading-relaxed">
          Toca el botón de WhatsApp, dinos tu comuna y te orientamos rápido y sin compromiso.
        </p>
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-2.5 pt-1">
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-7 py-3.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-sm shadow-lg shadow-emerald-500/25 transition-all inline-flex items-center justify-center gap-2"
          >
            <span>📲 Hablar por WhatsApp</span>
          </a>
          <a
            href="/contacto/?motivo=starlink-biobio#contact-form"
