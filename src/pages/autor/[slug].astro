---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthorAvatar from '../../components/AuthorAvatar.astro';
import autoresData from '../../data/autores.json';

export async function getStaticPaths() {
  const authors = Object.values(autoresData);
  const allArticles = await getCollection('articles');

  return authors.map((author) => {
    const authorArticles = allArticles.filter(
      (article) => (article.data.author || 'luis-briones') === author.slug
    );

    return {
      params: { slug: author.slug },
      props: { author, articles: authorArticles },
    };
  });
}

const { author, articles } = Astro.props;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  'name': author.nombre,
  'jobTitle': author.rol,
  'description': author.bioCompleta,
  'url': author.url,
  'knowsAbout': author.knowsAbout,
  'worksFor': {
    '@type': 'Organization',
    'name': 'HogarTV.cl',
    'url': 'https://hogartv.cl',
  },
};
---

<BaseLayout
  title={`${author.nombre} - ${author.rol} | HogarTV.cl`}
  description={`Perfil profesional y artículos técnicos de ${author.nombre}, especialista en TV Digital Abierta y Smart TVs en Chile.`}
  canonical={author.url}
  breadcrumbs={[
    { name: 'Sobre Nosotros', url: '/sobre-nosotros/' },
    { name: author.nombre, url: `/autor/${author.slug}/` },
  ]}
>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Migas de pan -->
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-8 font-medium">
      <a href="/" class="hover:text-white transition-colors">Inicio</a>
      <span>/</span>
      <span class="text-slate-500">Autores</span>
      <span>/</span>
      <span class="text-brand-400 font-semibold">{author.nombre}</span>
    </nav>

    <!-- Tarjeta Principal del Autor -->
    <header class="bg-surface-card border border-slate-700/80 rounded-3xl p-6 sm:p-10 shadow-2xl mb-12 relative overflow-hidden">
      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 sm:gap-8">
        
        <!-- Avatar / Foto con Fallback accesible (astro:assets con WebP o Iniciales) -->
        <AuthorAvatar slug={author.slug} nombre={author.nombre} size="lg" />

        <div class="flex-1 text-center sm:text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-950/70 border border-brand-800/60 text-brand-300 text-xs font-semibold uppercase tracking-wider mb-3">
            <span>🇨🇱 Autor Técnico Verificado</span>
          </div>

          <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-2">
            {author.nombre}
          </h1>
          
          <p class="text-sm sm:text-base text-brand-300 font-medium mb-4">
            {author.rol}
          </p>

          <p class="text-sm text-slate-300 leading-relaxed mb-6">
            {author.bioCompleta}
          </p>

          <!-- Áreas de especialidad / knowsAbout -->
          <div>
            <span class="text-xs uppercase tracking-wider font-bold text-slate-400 block mb-2">Especialidades técnicas:</span>
            <div class="flex flex-wrap gap-2 justify-center sm:justify-start">
              {author.knowsAbout.map((item: string) => (
                <span class="text-xs px-3 py-1 rounded-lg bg-slate-900 text-slate-300 border border-slate-800 font-medium">
                  ✓ {item}
                </span>
              ))}
            </div>
          </div>
        </div>

      </div>
    </header>

    <!-- Metodología de Trabajo y Transparencia -->
    <section class="bg-slate-900/60 border border-slate-800 rounded-2xl p-6 sm:p-8 mb-12">
      <h2 class="text-xl font-bold text-white mb-3 flex items-center gap-2">
        <span class="text-brand-400">🛡️</span> Metodología de Análisis y Ética Editorial
      </h2>
      <p class="text-sm text-slate-300 leading-relaxed">
        {author.metodologia}
      </p>
    </section>

    <!-- Artículos y Guías Escritas -->
    <section>
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold text-white">
          Guías y Artículos Publicados por {author.nombre}
        </h2>
        <span class="text-xs text-slate-400 font-medium">
          {articles.length} {articles.length === 1 ? 'publicación' : 'publicaciones'}
        </span>
      </div>

      <div class="space-y-4">
        {articles.map((article) => {
          const slug = article.id.replace(/\.(md|mdx)$/, '');
          return (
            <article class="p-6 rounded-2xl bg-surface-card border border-slate-800 hover:border-brand-500/50 transition-all duration-300 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="space-y-1">
                <span class="text-xs font-semibold text-brand-400 uppercase tracking-wider">
                  {article.data.categoryName}
                </span>
                <h3 class="text-lg font-bold text-white hover:text-brand-300 transition-colors">
                  <a href={`/${article.data.category}/${slug}/`}>
                    {article.data.title}
                  </a>
                </h3>
                <p class="text-xs text-slate-400 line-clamp-2">
                  {article.data.description}
                </p>
              </div>

              <div class="flex items-center gap-4 shrink-0 sm:self-center">
                <span class="text-xs text-slate-500 font-mono">
                  {article.data.publishDate}
                </span>
                <a
                  href={`/${article.data.category}/${slug}/`}
                  class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-brand-600 text-white text-xs font-semibold transition-all"
                >
                  Leer guía →
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </section>
  </main>

  <!-- Person Schema JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
</BaseLayout>
