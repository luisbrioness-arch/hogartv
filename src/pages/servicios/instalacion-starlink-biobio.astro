---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQSection from '../../components/FAQSection.astro';

import hogarTvLogo from '../../assets/brand/hogartv-logo.png';
import heroImage from '../../assets/servicios/instalacion-starlink-biobio/hero.jpg';
import imgMastil from '../../assets/servicios/instalacion-starlink-biobio/montaje-mastil-starlink-biobio.webp';
import imgCanaleta from '../../assets/servicios/instalacion-starlink-biobio/canaleta-cableado-estructurado-limpio.webp';
import imgCamaraPorton from '../../assets/servicios/instalacion-starlink-biobio/camara-poe-porton-parcela.webp';
import imgRackWifi from '../../assets/servicios/instalacion-starlink-biobio/rack-router-wifi6-instalacion.webp';
import imgFibraDrop from '../../assets/servicios/instalacion-starlink-biobio/enlace-fibra-drop-vecinos-biobio.webp';
import imgCajaEstanca from '../../assets/servicios/instalacion-starlink-biobio/caja-estanca-ip65-conduit-exterior.webp';

const siteUrl = 'https://hogartv.cl';
const pageUrl = `${siteUrl}/servicios/instalacion-starlink-biobio/`;
const waBase = 'https://wa.me/56931926886?text=';
const defaultWaText = 'Hola HogarTV, quiero cotizar una instalación de Starlink o redes en mi comuna en la Región del Biobío.';
const waUrl = `${waBase}${encodeURIComponent(defaultWaText)}`;

const comunasBiobio = [
  'Coronel',
  'Concepción',
  'San Pedro de la Paz',
  'Lota',
  'Chiguayante',
  'Talcahuano',
  'Hualqui',
  'Tomé',
  'Penco',
  'Santa Juana',
  'Florida',
  'Yumbel',
  'Cabrero',
  'Quillón',
  'Los Ángeles',
  'Arauco',
  'Santa Bárbara',
];

const comunasDestacadas = [
  'Concepción',
  'Coronel',
  'San Pedro de la Paz',
  'Santa Juana',
  'Florida',
  'Yumbel',
  'Los Ángeles',
  'Arauco',
];

const coberturaZonas = [
  {
    zone: 'Gran Concepción y Costa',
    communes: ['Concepción', 'San Pedro de la Paz', 'Coronel', 'Lota', 'Chiguayante', 'Talcahuano', 'Hualqui', 'Tomé', 'Penco'],
  },
  {
    zone: 'Parcelas e Interior',
    communes: ['Santa Juana', 'Florida', 'Yumbel', 'Cabrero', 'Quillón', 'Condominios y caminos rurales'],
  },
  {
    zone: 'Provincia de Biobío y Arauco',
    communes: ['Los Ángeles', 'Arauco', 'Santa Bárbara', 'Sectores rurales y empresas aledañas'],
  },
];

// 5 servicios claros para el cliente, con resumen corto + detalles desplegables
const servicios = [
  {
    id: 'starlink',
    icon: '📡',
    badge: 'Más solicitado',
    badgeClass: 'bg-emerald-500 text-slate-950',
    borderClass: 'border-emerald-500/45',
    title: 'Instalación de Starlink (Gen 3 y Mini)',
    summary: 'Montamos tu antena en altura para esquivar árboles y que tu internet funcione firme con lluvia y viento.',
    waMsg: 'Hola HogarTV, quiero cotizar la instalación de Starlink en la Región del Biobío.',
    details: [
      'Mástil firme de acero y anclajes calculados para temporales de viento del Biobío.',
      'Alineación con cielo despejado para evitar microcortes en videollamadas o TV.',
      'Pasada de muro/techo sellada contra filtraciones y configuración completa del Wi-Fi.',
      'Compatible con Starlink Standard Gen 3, generaciones anteriores y Starlink Mini.',
    ],
    ideal: 'Casas, parcelas, cabañas y negocios sin fibra óptica.',
  },
  {
    id: 'compartido-50-50',
    icon: '🤝',
    badge: 'Ahorra 50% al mes',
    badgeClass: 'bg-cyan-400 text-slate-950',
    borderClass: 'border-cyan-500/40',
    title: 'Compartir Starlink 50/50 entre Vecinos',
    summary: 'Una sola antena alimenta 2 casas o parcelas cercanas. Cada familia tiene su propio Wi-Fi privado y pagan la mitad.',
    waMsg: 'Hola HogarTV, quiero cotizar compartir una antena Starlink 50/50 entre dos casas en el Biobío.',
    details: [
      'Hasta 80 metros: enlace por cable UTP exterior blindado doble chaqueta UV.',
      'De 100 a 500 metros: tendido aéreo de fibra óptica drop monomodo (sin pérdida de velocidad e inmune a tormentas).',
      'Reparto equitativo 50/50: las descargas pesadas de una casa nunca frenan a la otra.',
      'Redes 100% separadas: cada vivienda usa su propio router, nombre de Wi-Fi y contraseña.',
    ],
    ideal: 'Vecinos, familiares en el mismo terreno o parcelas contiguas.',
  },
  {
    id: 'cableado-canaletas',
    icon: '🔌',
    badge: 'Cero cables sueltos',
    badgeClass: 'bg-sky-400 text-slate-950',
    borderClass: 'border-sky-500/40',
    title: 'Cableado Estructurado y Canaletas Limpias',
    summary: 'Llevamos internet estable por cable (Cat6 / Cat6A) a piezas, oficinas o locales, 100% ordenado y estético.',
    waMsg: 'Hola HogarTV, quiero cotizar cableado estructurado con canaletas en la Región del Biobío.',
    details: [
      'Puntos de red LAN Gigabit certificados (Cat6 / Cat6A) para PCs, televisores y oficinas.',
      'Terminación limpia con canaletas PVC interiores a medida (sin cables colgando).',
      'Tubería conduit interior/exterior y cajas estancas IP65/IP66 resistentes al clima costero.',
      'Ordenamiento de racks de comunicaciones, patch panels, switches y rotulado de cables.',
    ],
    ideal: 'Casas de 2 pisos, oficinas, locales comerciales y talleres.',
  },
  {
    id: 'camaras-porton',
    icon: '📹',
    badge: 'Vigilancia 24/7',
    badgeClass: 'bg-indigo-400 text-slate-950',
    borderClass: 'border-indigo-500/40',
    title: 'Cámaras de Seguridad y Portones Lejanos',
    summary: 'Instalamos cámaras CCTV / IP PoE para ver tu casa, negocio o portón de entrada en vivo desde el celular.',
    waMsg: 'Hola HogarTV, quiero cotizar instalación de cámaras de seguridad o cámara en portón en el Biobío.',
    details: [
      'Portón hasta 100 metros: cable exterior blindado con inyector PoE desde tu casa (no necesitas enchufe 220V en el portón).',
      'Más de 100 metros (hasta 500m): fibra óptica drop dedicada hasta el portón, galpón o bodega con caja estanca IP65.',
      'Sistemas CCTV / IP PoE para perímetro, accesos y negocios.',
      'Dejamos la aplicación configurada y probada en los celulares de tu familia.',
    ],
    ideal: 'Portones de parcelas, galpones, bodegas, casas y negocios.',
  },
  {
    id: 'wifi-ups',
    icon: '📶',
    badge: 'Señal en toda la casa',
    badgeClass: 'bg-amber-400 text-slate-950',
    borderClass: 'border-amber-500/40',
    title: 'Wi-Fi Mesh y Respaldo para Cortes de Luz (UPS)',
    summary: 'Eliminamos los sectores sin señal en casas grandes y sumamos respaldo con batería para seguir conectado sin luz.',
    waMsg: 'Hola HogarTV, quiero cotizar mejora de Wi-Fi Mesh o respaldo UPS en la Región del Biobío.',
    details: [
      'Instalación de sistemas Wi-Fi Mesh y Access Points cableados para viviendas amplias o de dos pisos.',
      'Configuración en modo puente (bypass) para exprimir al máximo tu router principal.',
      'Integración de respaldo eléctrico UPS para que tu Starlink y cámaras sigan activos durante cortes de luz.',
    ],
    ideal: 'Casas grandes con muros gruesos y sectores con cortes frecuentes de luz.',
  },
];

const pasosTrabajo = [
  {
    num: '1',
    title: 'Escríbenos por WhatsApp',
    desc: 'Indícanos tu comuna y qué necesitas (puedes mandar una foto del techo o del sector).',
  },
  {
    num: '2',
    title: 'Presupuesto claro',
    desc: 'Te cotizamos materiales, canalización y mano de obra antes de ir, sin cobros sorpresa.',
  },
  {
    num: '3',
    title: 'Instalamos y probamos todo',
    desc: 'Dejamos la instalación limpia, funcionando al 100% y con garantía técnica en terreno.',
  },
];

const galeriaTrabajos = [
  {
    img: imgMastil,
    tag: 'Starlink en altura',
    title: 'Montaje en Mástil Firme',
    alt: 'Montaje profesional de antena Starlink en mástil reforzado en altura en la Región del Biobío',
  },
  {
    img: imgCanaleta,
    tag: 'Sin cables sueltos',
    title: 'Canaletas y Cableado Cat6',
    alt: 'Instalación limpia de cableado estructurado Cat6 con canaletas PVC en vivienda y oficina del Biobío',
  },
  {
    img: imgCamaraPorton,
    tag: 'Seguridad 24/7',
    title: 'Cámara PoE en Portón',
    alt: 'Cámara de seguridad IP PoE instalada en portón de entrada de parcela en la Región del Biobío',
  },
  {
    img: imgRackWifi,
    tag: 'Orden y Wi-Fi 6',
    title: 'Rack y Router Wi-Fi',
    alt: 'Ordenamiento de rack de comunicaciones, patch panel y router Wi-Fi 6 en Concepción y Biobío',
  },
  {
    img: imgFibraDrop,
    tag: 'Compartido 50/50',
    title: 'Enlace Fibra Drop',
    alt: 'Tendido de fibra óptica drop monomodo para compartir internet Starlink entre parcelas vecinas en el Biobío',
  },
  {
    img: imgCajaEstanca,
    tag: 'Clima del sur',
    title: 'Caja Estanca IP65',
    alt: 'Instalación de caja estanca IP65 y tubería conduit exterior para redes y cámaras en clima del Biobío',
  },
];

const faqs = [
  {
    question: '¿Cuánto cuesta instalar Starlink o cableado en la Región del Biobío?',
    answer: 'El valor depende de cada casa o parcela: altura del techo, si necesita mástil elevado para esquivar árboles, metros de canaleta o cable/fibra y si se agregan cámaras o puntos de red. Escríbenos por WhatsApp con tu comuna y te damos un presupuesto claro y sin compromiso antes de agendar.',
  },
  {
    question: '¿Instalan Starlink Standard (Gen 3) y Starlink Mini?',
    answer: 'Sí. Instalamos Starlink Standard Gen 3, generaciones anteriores y Starlink Mini, con mástiles reforzados, soportes de muro/techo y configuración completa de tu red Wi-Fi.',
  },
  {
    question: '¿Cómo evitan que queden cables colgando o feos a la vista?',
    answer: 'Usamos canaletas PVC a medida en interiores, tubería conduit en exteriores, pasamuros sellados contra lluvia y cajas estancas IP65/IP66. Nuestro foco es dejar una terminación limpia y prolija.',
  },
  {
    question: '¿Realmente se puede compartir Starlink 50/50 con un vecino sin que se ponga lento?',
    answer: 'Sí. Conectamos las 2 viviendas con cable exterior blindado UV (hasta 80m) o fibra óptica drop (100 a 500m) y configuramos control de tráfico 50/50 con dos routers independientes. Cada casa tiene su Wi-Fi privado y velocidad protegida.',
  },
  {
    question: '¿Puedo poner una cámara en el portón si ahí no tengo enchufe?',
    answer: 'Sí. Si tu portón está a menos de 100 metros de la casa, llevamos internet y energía por un solo cable blindado usando un inyector PoE desde la vivienda. Si está a más de 100 metros (hasta 500m), usamos fibra óptica drop con alimentación en el portón, caseta o kit solar.',
  },
  {
    question: '¿Qué pasa con los temporales de lluvia, viento o cortes de luz en el Biobío?',
    answer: 'Nuestros mástiles y cajas estancas están pensados para la lluvia y ráfagas de viento de la zona. Además, podemos incorporar una pequeña batería UPS para que tu internet y cámaras sigan funcionando si se corta la luz.',
  },
  {
    question: '¿En qué comunas de la Región del Biobío atienden?',
    answer: 'Atendemos en Coronel, Concepción, San Pedro de la Paz, Lota, Chiguayante, Talcahuano, Hualqui, Tomé, Penco, Santa Juana, Florida, Yumbel, Cabrero, Quillón, Los Ángeles, Arauco, Santa Bárbara y sectores rurales aledaños.',
  },
];

// Schema JSON-LD sin exponer nombre personal ni número de teléfono en texto abierto
const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': ['ProfessionalService', 'HomeAndConstructionBusiness'],
  '@id': `${siteUrl}/#servicio-starlink-biobio`,
  'name': 'HogarTV.cl — Instalación de Starlink, Cableado Estructurado y Cámaras Biobío',
  'description': 'Servicio técnico en terreno en la Región del Biobío para instalación de Starlink (Gen 3 y Mini), cableado estructurado Cat6/Cat6A con canaletas limpias, enlaces 50/50 y cámaras de seguridad IP PoE.',
  'url': pageUrl,
  'priceRange': '$$',
  'image': `${siteUrl}${heroImage.src}`,
  'logo': `${siteUrl}/favicon-512x512.png`,
  'address': {
    '@type': 'PostalAddress',
    'addressLocality': 'Región del Biobío',
    'addressRegion': 'Región del Biobío',
    'addressCountry': 'CL',
  },
  'geo': {
    '@type': 'GeoCoordinates',
    'latitude': -36.827,
    'longitude': -73.0503,
  },
  'areaServed': [
    { '@type': 'AdministrativeArea', 'name': 'Región del Biobío' },
    ...comunasBiobio.map((comuna) => ({
      '@type': 'City',
      'name': `${comuna}, Región del Biobío`,
    })),
  ],
  'sameAs': [
    'https://www.tiktok.com/@hogartv.cl',
    'https://www.instagram.com/hogartv.cl/',
  ],
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'serviceType': 'Instalación de Starlink, Cableado Estructurado, Canalización y Cámaras de Seguridad',
  'name': 'Instalación Profesional de Starlink y Redes en la Región del Biobío',
  'description': 'Instalación en altura de Starlink Standard Gen 3 y Mini, cableado estructurado Cat6/Cat6A con canaletas PVC y conduit, cámaras IP PoE en portones lejanos, enlaces compartidos 50/50 y Wi-Fi Mesh con respaldo UPS en la Región del Biobío.',
  'url': pageUrl,
  'provider': {
    '@id': `${siteUrl}/#servicio-starlink-biobio`,
  },
  'areaServed': {
    '@type': 'AdministrativeArea',
    'name': 'Región del Biobío, Chile',
  },
  'hasOfferCatalog': {
    '@type': 'OfferCatalog',
    'name': 'Servicios de Starlink, Redes y Seguridad en Biobío',
    'itemListElement': servicios.map((s) => ({
      '@type': 'Offer',
      'itemOffered': {
        '@type': 'Service',
        'name': s.title,
        'description': s.summary,
      },
    })),
  },
};
---

<BaseLayout
  title="Instalación Starlink Biobío y Concepción | Redes HogarTV"
  description="Instalación profesional de Starlink (Gen 3 y Mini), cableado estructurado con canaletas y cámaras en Concepción y todo el Biobío. Cotiza por WhatsApp."
  canonical={pageUrl}
  ogImage={heroImage.src}
  disableAds={true}
  breadcrumbs={[
    { name: 'Instalación Starlink Biobío', url: '/servicios/instalacion-starlink-biobio/' },
  ]}
>
  <div class="w-full max-w-full overflow-x-clip pb-24 md:pb-10">

    <!-- ======================================================================= -->
    <!-- 1. HERO SIMPLE, CLARO Y DIRECTO A WHATSAPP                              -->
    <!-- ======================================================================= -->
    <section class="pt-4 sm:pt-8 pb-8 sm:pb-12 border-b border-slate-800/80 bg-gradient-to-b from-slate-950 via-surface-dark to-surface-dark">
      <div class="max-w-6xl mx-auto px-3.5 sm:px-6 lg:px-8">

        <nav class="flex flex-wrap items-center gap-1.5 text-xs text-slate-400 font-medium mb-4" aria-label="Migas de pan">
          <a href="/" class="hover:text-white transition-colors">Inicio</a>
          <span class="text-slate-600" aria-hidden="true">/</span>
          <span class="text-emerald-400 font-bold">Instalación Starlink y Redes Biobío</span>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center">
          <!-- Texto principal + CTA -->
          <div class="lg:col-span-7 space-y-4 min-w-0">
            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/40 text-emerald-300 text-[11px] font-black uppercase tracking-wider">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse" aria-hidden="true"></span>
              <span>Servicio Técnico en Terreno · 8ª Región</span>
            </span>

            <h1 class="text-2xl sm:text-4xl font-black text-white tracking-tight leading-tight">
              Instalación Profesional de <span class="text-emerald-400">Starlink</span> y Redes en la Región del Biobío
            </h1>

            <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
              Instalamos <strong class="text-white">Starlink (Gen 3 y Mini)</strong> en altura, <strong class="text-sky-300">cableado de red con canaletas limpias</strong>, enlaces compartidos <strong class="text-emerald-300">50/50 entre vecinos</strong> y <strong class="text-indigo-300">cámaras de seguridad</strong> para casas, parcelas y empresas.
            </p>

            <!-- Caja simple: Elige tu comuna + Botón WhatsApp (sin mostrar número) -->
            <div class="p-3.5 sm:p-4 rounded-2xl bg-slate-900/95 border border-emerald-500/40 shadow-xl space-y-2.5">
              <div class="flex flex-col sm:flex-row gap-2.5">
                <div class="sm:w-52 shrink-0">
                  <label for="hero-comuna-select" class="sr-only">Elige tu comuna en el Biobío</label>
                  <select
                    id="hero-comuna-select"
                    class="w-full px-3.5 py-3 rounded-xl bg-slate-950 border border-slate-700 text-slate-100 text-xs sm:text-sm font-semibold focus:outline-none focus:border-emerald-400"
                  >
                    <option value="">📍 Elige tu comuna</option>
                    {comunasBiobio.map((c) => (
                      <option value={c}>{c}</option>
                    ))}
                    <option value="otro sector del Biobío">Otro sector del Biobío</option>
                  </select>
                </div>
                <a
                  id="hero-wa-cta"
                  href={waUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-sm shadow-lg shadow-emerald-500/25 transition-all"
                >
                  <span>📲 Cotizar por WhatsApp</span>
                </a>
              </div>

              <div class="flex flex-wrap items-center justify-between gap-2 text-xs pt-0.5">
                <a href="#servicios" class="font-bold text-slate-200 hover:text-emerald-300 transition-colors">
                  Ver servicios y detalles ↓
                </a>
                <a href="/contacto/?motivo=starlink-biobio#contact-form" class="text-slate-400 hover:text-white underline underline-offset-4">
                  Cotizar por formulario →
                </a>
              </div>
            </div>

            <!-- 4 Sellos de confianza cortos -->
            <ul class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-[11px] font-bold text-slate-200" aria-label="Ventajas del servicio">
              <li class="px-2.5 py-2 rounded-xl bg-slate-900/80 border border-slate-800 text-center">✓ +8 años en terreno</li>
              <li class="px-2.5 py-2 rounded-xl bg-slate-900/80 border border-slate-800 text-center">✓ Sin cables sueltos</li>
              <li class="px-2.5 py-2 rounded-xl bg-slate-900/80 border border-slate-800 text-center">✓ Garantía en terreno</li>
              <li class="px-2.5 py-2 rounded-xl bg-slate-900/80 border border-slate-800 text-center">✓ Todo el Biobío</li>
            </ul>
          </div>

          <!-- Imagen Hero LCP limpia -->
          <div class="lg:col-span-5 min-w-0">
            <div class="rounded-3xl overflow-hidden border-2 border-emerald-500/40 bg-slate-900 shadow-2xl">
              <div class="relative aspect-[16/10] sm:aspect-[4/3] w-full overflow-hidden bg-slate-950">
                <Image
                  src={heroImage}
                  alt="Instalación profesional de antena Starlink en altura con mástil reforzado en la Región del Biobío"
                  width={900}
                  height={675}
                  format="webp"
                  quality={88}
                  loading="eager"
                  fetchpriority="high"
                  class="w-full h-full object-cover"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-transparent to-transparent"></div>
                <span class="absolute top-3 left-3 px-2.5 py-1 rounded-full bg-slate-950/90 border border-emerald-500/50 text-emerald-300 text-[11px] font-mono font-bold">
                  ⚡ 100 a 250 Mbps Reales
                </span>
                <p class="absolute bottom-3 left-3.5 right-3.5 text-xs font-bold text-white drop-shadow m-0">
                  Mástil en altura · Canaletas limpias · Cámaras IP PoE
                </p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ======================================================================= -->
    <!-- 2. QUÉ INSTALAMOS (TARJETAS CLARAS CON BOTÓN "VER DETALLES")            -->
    <!-- ======================================================================= -->
    <section id="servicios" class="max-w-6xl mx-auto px-3.5 sm:px-6 lg:px-8 py-9 sm:py-12 border-b border-slate-800/70 scroll-mt-20">
      <div class="mb-6 sm:mb-8">
        <span class="text-xs font-black uppercase tracking-wider text-emerald-400 block mb-1">Nuestros Servicios</span>
        <h2 class="text-xl sm:text-3xl font-black text-white tracking-tight">
          ¿Qué necesitas instalar? Elige y toca «Ver detalles»
        </h2>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">
          Explicado simple y directo. Abre cada servicio para ver qué incluye y cotizar al instante.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {servicios.map((srv, idx) => (
          <article class={`rounded-2xl bg-surface-card border ${srv.borderClass} p-4 sm:p-5 flex flex-col justify-between gap-3 shadow-lg ${idx === 4 ? 'md:col-span-2' : ''}`}>
            <div class="space-y-2">
              <div class="flex items-center justify-between gap-2">
                <span class="text-2xl leading-none" aria-hidden="true">{srv.icon}</span>
                <span class={`px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase ${srv.badgeClass}`}>
                  {srv.badge}
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-black text-white leading-snug">
                {srv.title}
              </h3>
              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                {srv.summary}
              </p>
            </div>

            <!-- Botón desplegable nativo "Ver detalles" -->
            <details name="servicio-detalle" class="group rounded-xl bg-slate-950/75 border border-slate-800 open:border-emerald-500/40 overflow-hidden">
              <summary class="flex items-center justify-between gap-2 px-3.5 py-2.5 cursor-pointer list-none select-none text-xs font-extrabold text-emerald-300 hover:text-white transition-colors">
                <span>Ver detalles de qué incluye</span>
                <svg class="w-4 h-4 text-emerald-400 group-open:rotate-180 transition-transform shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
