                    class="mt-1 w-4 h-4 shrink-0 accent-[#26C6F5]"
                  />
                  <span class="min-w-0 flex-1">
                    <span class="flex items-center justify-between gap-2">
                      <span class="text-xs sm:text-sm font-extrabold text-white leading-snug">{pkg.name}</span>
                      {pkg.featured && (
                        <span class="px-2 py-0.5 rounded-full bg-[#FF7010] text-white text-[9px] font-black uppercase shrink-0">Más pedido</span>
                      )}
                    </span>
                    <span class="block text-xs font-mono font-bold text-[#26C6F5] mt-0.5">{pkg.priceLabel}</span>
                  </span>
                </label>
              ))}
            </div>
          </fieldset>

          <!-- Paso 2: Comuna (<select> agrupado con font-size >= 16px anti-zoom iOS) -->
          <div class="space-y-2">
            <label for="calc-comuna" class="text-sm sm:text-base font-black text-white flex items-center gap-2">
              <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-[#26C6F5] text-[#0F1824] text-xs font-black">2</span>
              <span>¿En qué comuna está tu casa o parcela?</span>
            </label>
            <select
              id="calc-comuna"
              name="comuna"
              class="w-full min-h-[50px] px-4 py-3 rounded-2xl bg-[#0F1824] border border-slate-600 text-white text-base font-semibold focus:outline-none focus:border-[#26C6F5] focus:ring-2 focus:ring-[#26C6F5]/30"
            >
              {zones.map((z) => (
                <optgroup label={z.label}>
                  {z.communes.map((c) => (
                    <option
                      value={c.name}
                      data-min={c.min}
                      data-max={c.max}
                      data-zone={c.zoneType}
                      selected={c.name === 'Coronel'}
                    >
                      {c.name} {c.min === 0 ? '($0 traslado)' : `(+$${c.min.toLocaleString('es-CL')} – $${c.max.toLocaleString('es-CL')})`}
                    </option>
                  ))}
                </optgroup>
              ))}
            </select>
            <p id="calc-rural-tip" class="text-xs text-slate-200 bg-[#0F1824]/90 border border-slate-700 rounded-xl px-3.5 py-2.5 m-0 leading-relaxed">
              <strong class="text-[#26C6F5]">Traslado transparente:</strong> Incluye ida y vuelta con materiales desde Coronel/Concepción (sin cobros sorpresa en terreno).
            </p>
          </div>

          <!-- Paso 3: ¿Ya tienes antena? (2 radios visibles) -->
          <fieldset class="space-y-2.5 border-0 p-0 m-0">
            <legend class="text-sm sm:text-base font-black text-white mb-2 flex items-center gap-2">
              <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-[#26C6F5] text-[#0F1824] text-xs font-black">3</span>
              <span>¿Ya tienes tu antena Starlink?</span>
            </legend>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              <label class="flex items-center gap-3 p-3.5 min-h-[50px] rounded-2xl bg-[#0F1824] border border-slate-700 hover:border-[#26C6F5]/70 cursor-pointer has-[:checked]:border-[#26C6F5] has-[:checked]:ring-2 has-[:checked]:ring-[#26C6F5]/35">
                <input type="radio" name="antena" value="Sí, ya la compré" checked class="w-4 h-4 shrink-0 accent-[#26C6F5]" />
                <span class="text-sm font-bold text-white">Sí, ya la compré</span>
              </label>
              <label class="flex items-center gap-3 p-3.5 min-h-[50px] rounded-2xl bg-[#0F1824] border border-slate-700 hover:border-[#26C6F5]/70 cursor-pointer has-[:checked]:border-[#26C6F5] has-[:checked]:ring-2 has-[:checked]:ring-[#26C6F5]/35">
                <input type="radio" name="antena" value="Todavía no, necesito orientación" class="w-4 h-4 shrink-0 accent-[#26C6F5]" />
                <span class="text-sm font-bold text-white">Todavía no, necesito orientación</span>
              </label>
            </div>
          </fieldset>

          <!-- Resultado en vivo (aria-live polite) -->
          <div role="status" aria-live="polite" class="rounded-2xl bg-[#0F1824] border-2 border-[#26C6F5]/50 p-4 sm:p-6 space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs border-b border-slate-800 pb-4">
              <div>
                <span class="text-slate-400 block">Instalación estimada:</span>
                <strong id="out-install" class="text-sm sm:text-base font-mono text-white">$150.000 – $180.000</strong>
              </div>
              <div>
                <span class="text-slate-400 block">Traslado (<span id="out-comuna">Coronel</span>):</span>
                <strong id="out-travel" class="text-sm sm:text-base font-mono text-[#26C6F5]">$0 (Zona Base)</strong>
              </div>
              <div>
                <span class="text-slate-400 block">Total estimado (sin antena):</span>
                <strong id="out-total" class="text-lg sm:text-xl font-mono font-black text-[#25D366]">$150.000 – $180.000</strong>
              </div>
            </div>

            <div id="out-note" class="text-xs text-[#FF7010] font-bold">
              Reservas tu fecha con $25.000 descontables y pagas el saldo al terminar funcionando.
            </div>

            <a
              id="calc-wa-btn"
              href={waDirectUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="min-h-[54px] w-full inline-flex items-center justify-center gap-2.5 px-6 py-4 rounded-2xl bg-[#25D366] hover:bg-[#1ebe5d] text-[#09140E] font-black text-sm sm:text-base shadow-[0_10px_28px_rgba(37,211,102,0.35)] transition-all hover:scale-[1.01]"
            >
              <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12.031 2c-5.516 0-9.969 4.453-9.969 9.969 0 1.766.469 3.484 1.344 5l-1.406 5.156 5.281-1.391c1.469.797 3.109 1.219 4.75 1.219 5.516 0 9.969-4.453 9.969-9.969S17.547 2 12.031 2zm5.813 14.125c-.25.703-1.438 1.328-2 1.406-.516.078-1.172.109-1.891-.125-.438-.141-1-.328-1.719-.641-3.031-1.313-5.016-4.375-5.172-4.578-.156-.203-1.234-1.641-1.234-3.125s.781-2.219 1.063-2.516c.281-.297.609-.375.813-.375h.578c.188 0 .438-.078.688.516.25.609.859 2.094.938 2.25.078.156.125.344.016.547-.109.203-.156.344-.313.516-.156.188-.328.406-.469.547-.156.156-.328.328-.141.641.188.313.844 1.391 1.813 2.25 1.25 1.109 2.297 1.453 2.609 1.609.313.156.5.125.688-.078.188-.203.781-.906.984-1.219.203-.313.406-.266.688-.156.281.109 1.797.844 2.109 1 .313.156.516.234.594.359.078.125.078.734-.172 1.438z"/>
              </svg>
              <span>Enviar esta cotización por WhatsApp</span>
            </a>
          </div>
        </form>
      </div>
    </section>

