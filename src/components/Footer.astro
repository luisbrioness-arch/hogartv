---
import sitioData from '../data/sitio.json';

const currentYear = new Date().getFullYear();
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL || sitioData.emailContacto;
---

<footer class="bg-surface-dark border-t border-slate-800/80 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
      
      <!-- Columna 1: Marca e Identidad -->
      <div class="md:col-span-1 space-y-4">
        <a href="/" class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-brand-600 flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </div>
          <span class="text-lg font-bold text-white">Hogar<span class="text-brand-400">TV</span>.cl</span>
        </a>
        <p class="text-xs text-slate-400 leading-relaxed">
          Portal técnico independiente en Chile para elegir Smart TV, comparar plataformas de streaming y sintonizar televisión digital abierta (TVD) gratuita.
        </p>
        <div class="pt-1">
          <a href="/autor/luis-briones" class="inline-flex items-center gap-2 text-xs text-brand-400 hover:text-brand-300 font-medium transition-colors">
            <span>👤 Autor técnico: Luis Briones</span>
          </a>
        </div>
      </div>

      <!-- Columna 2: Categorías -->
      <div>
        <p class="text-sm font-semibold text-white uppercase tracking-wider mb-3">Categorías</p>
        <ul class="space-y-2 text-xs">
          <li><a href="/smart-tv" class="text-slate-400 hover:text-white transition-colors">Smart TVs en Chile</a></li>
          <li><a href="/streaming" class="text-slate-400 hover:text-white transition-colors">Streaming y TV Online</a></li>
          <li><a href="/tv-abierta" class="text-slate-400 hover:text-white transition-colors">Canales TVD Chile</a></li>
          <li><a href="/accesorios" class="text-slate-400 hover:text-white transition-colors">TV Sticks y Accesorios</a></li>
        </ul>
      </div>

      <!-- Columna 3: Información Legal y Políticas -->
      <div>
        <p class="text-sm font-semibold text-white uppercase tracking-wider mb-3">Transparencia y Legal</p>
        <ul class="space-y-2 text-xs">
          <li><a href="/sobre-nosotros" class="text-slate-400 hover:text-white transition-colors">Sobre Nosotros y Metodología</a></li>
          <li><a href="/contacto" class="text-slate-400 hover:text-white transition-colors">Contacto y Soporte</a></li>
          <li><a href="/divulgacion-afiliados" class="text-slate-400 hover:text-white transition-colors">Divulgación de Afiliados</a></li>
          <li><a href="/privacidad" class="text-slate-400 hover:text-white transition-colors">Política de Privacidad (Chile)</a></li>
          <li><a href="/terminos" class="text-slate-400 hover:text-white transition-colors">Términos y Condiciones</a></li>
        </ul>
      </div>

      <!-- Columna 4: Aviso de Afiliados -->
      <div>
        <p class="text-sm font-semibold text-brand-300 uppercase tracking-wider mb-3">Aviso de Afiliación</p>
        <div class="bg-slate-900/80 p-3.5 rounded-xl border border-slate-800 text-[11px] text-slate-400 leading-relaxed space-y-2">
          <p>
            HogarTV.cl participa en programas de afiliados (Mercado Libre Chile, etc.). Si compras a través de nuestros enlaces, podemos recibir una comisión sin ningún coste extra para ti.
          </p>
          <a href="/divulgacion-afiliados" class="text-brand-400 underline hover:text-brand-300 block font-medium">
            Leer política de transparencia completa →
          </a>
        </div>
      </div>

    </div>

    <!-- Barra inferior con enlaces legales -->
    <div class="pt-8 border-t border-slate-800/60 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>© {currentYear} HogarTV.cl - Todos los derechos reservados. Editado para usuarios en Chile 🇨🇱.</p>
      <nav class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2" aria-label="Enlaces legales">
        <a href="/sobre-nosotros" class="hover:text-slate-300 transition-colors">Sobre Nosotros</a>
        <a href="/contacto" class="hover:text-slate-300 transition-colors">Contacto</a>
        <a href="/divulgacion-afiliados" class="hover:text-slate-300 transition-colors">Afiliados</a>
        <a href="/privacidad" class="hover:text-slate-300 transition-colors">Privacidad</a>
        <a href="/terminos" class="hover:text-slate-300 transition-colors">Términos</a>
      </nav>
    </div>
  </div>
</footer>
