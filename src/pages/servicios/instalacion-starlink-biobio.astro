---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import afiliadosData from '../../data/afiliados.json';

import hogarTvLogo from '../../assets/brand/hogartv-logo.png';
import luisPhoto from '../../assets/autores/luis-briones.webp';
import heroImage from '../../assets/servicios/instalacion-starlink-biobio/hero.jpg';
import imgMastil from '../../assets/servicios/instalacion-starlink-biobio/montaje-mastil-starlink-biobio.webp';
import imgCanaleta from '../../assets/servicios/instalacion-starlink-biobio/canaleta-cableado-estructurado-limpio.webp';
import imgCamaraPorton from '../../assets/servicios/instalacion-starlink-biobio/camara-poe-porton-parcela.webp';
import imgRackWifi from '../../assets/servicios/instalacion-starlink-biobio/rack-router-wifi6-instalacion.webp';
import imgFibraDrop from '../../assets/servicios/instalacion-starlink-biobio/enlace-fibra-drop-vecinos-biobio.webp';
import imgCajaEstanca from '../../assets/servicios/instalacion-starlink-biobio/caja-estanca-ip65-conduit-exterior.webp';

const siteUrl = 'https://hogartv.cl';
const pageUrl = `${siteUrl}/servicios/instalacion-starlink-biobio/`;
const waBase = 'https://wa.me/56931926886?text=';
const waDirectUrl = `${waBase}${encodeURIComponent(
  'Hola Luis, vi la página de HogarTV.cl y quiero cotizar una instalación de Starlink en la Región del Biobío.'
)}`;

const packages = [
  {
    id: 'base',
    name: 'Base Techo o Muro',
    priceLabel: '$95.000 – $110.000',
    min: 95000,
    max: 110000,
    tag: 'Casas despejadas',
    featured: false,
    desc: 'Ideal cuando tu casa o cabaña tiene buena vista al cielo sin árboles altos encima (usa cable original del kit).',
    bullets: [
      'Soporte firme en techo o muro (resiste lluvia y viento)',
      'Bajada de cable prolija y sellada contra filtraciones + canaleta básica',
      'Configuración completa del Wi-Fi y prueba real en tus celulares',
    ],
  },
  {
    id: 'parcela-full',
    name: 'Parcela Full Mástil en Altura',
    priceLabel: '$150.000 – $180.000',
    min: 150000,
    max: 180000,
    tag: 'MÁS PEDIDO · PARCELAS',
    featured: true,
    desc: 'Elevamos tu antena por sobre pinos o eucaliptos con mástil reforzado y canalización exterior sellada para temporales.',
    bullets: [
      'Mástil de acero galvanizado en altura para librar árboles y evitar cortes',
      'Fijaciones y vientos pensados para ráfagas de viento del Biobío',
      'Canalización exterior UV sellada y configuración Wi-Fi (router extra opcional)',
    ],
  },
  {
    id: 'camara-porton',
    name: 'Cámara al Portón (hasta 100m)',
    priceLabel: '$140.000 – $220.000',
    min: 140000,
    max: 220000,
    tag: 'Sin enchufe en el portón',
    featured: false,
    desc: 'Mira quién llega a tu parcela 24/7 desde el celular con un solo cable blindado que lleva internet y energía.',
    bullets: [
      'Tendido exterior blindado hasta 100m (lleva internet y electricidad juntos)',
      'Caja estanca sellada contra lluvia + configuración en tu celular 24/7',
      'Desde $140.000 si ya tienes la cámara · hasta $220.000 llave en mano con cámara',
    ],
  },
  {
    id: 'combo-parcela',
    name: 'Combo Starlink + Portón o Fibra (100–500m)',
    priceLabel: 'Desde $320.000',
    min: 320000,
    max: null,
    tag: 'Proyectos completos',
    featured: false,
    desc: 'Instalación Starlink en altura sumando cámara en portón lejano o enlace de fibra hacia bodega, quincho o 2ª cabaña.',
    bullets: [
      'Antena Starlink en altura + cámara al portón o fibra óptica 100–500m sin pérdida',
      'Cajas estancas selladas contra lluvia y canaletas ordenadas en muros',
      'Opción de reforzar Wi-Fi en 2º piso, quincho o bodega dentro de tu parcela',
    ],
  },
];

const zones = [
  {
    label: 'Zona Base ($0 traslado)',
    communes: [
      { name: 'Coronel', min: 0, max: 0, zoneType: 'base' },
      { name: 'Lota', min: 0, max: 0, zoneType: 'base' },
      { name: 'San Pedro de la Paz', min: 0, max: 0, zoneType: 'base' },
      { name: 'Concepción', min: 0, max: 0, zoneType: 'base' },
    ],
  },
  {
    label: 'Zona Media (+$20.000 – $25.000 traslado)',
    communes: [
      { name: 'Santa Juana', min: 20000, max: 25000, zoneType: 'media' },
      { name: 'Chiguayante', min: 20000, max: 25000, zoneType: 'media' },
      { name: 'Hualqui', min: 20000, max: 25000, zoneType: 'media' },
      { name: 'Patagual', min: 20000, max: 25000, zoneType: 'media' },
    ],
  },
  {
    label: 'Zona Rural (+$30.000 – $35.000 traslado)',
    communes: [
      { name: 'Yumbel', min: 30000, max: 35000, zoneType: 'rural' },
      { name: 'Florida', min: 30000, max: 35000, zoneType: 'rural' },
      { name: 'Quillón', min: 30000, max: 35000, zoneType: 'rural' },
      { name: 'Arauco', min: 30000, max: 35000, zoneType: 'rural' },
    ],
  },
  {
    label: 'Zona Rural Lejana (+$45.000 – $50.000 traslado)',
    communes: [
      { name: 'Cabrero', min: 45000, max: 50000, zoneType: 'rural-lejana' },
      { name: 'Los Ángeles', min: 45000, max: 50000, zoneType: 'rural-lejana' },
    ],
  },
];

const galleryItems = [
  {
    img: imgMastil,
    badge: 'Firme ante temporales',
    title: 'Mástil en altura sobre árboles',
    desc: 'Fijación sólida en techo pensada para las ráfagas de viento y lluvia del Biobío.',
    alt: 'Montaje profesional de antena Starlink en mástil reforzado en altura en la Región del Biobío',
  },
  {
    img: imgCanaleta,
    badge: 'Cero cables colgando',
    title: 'Canaletas ordenadas en muros',
    desc: 'Terminación prolija por dentro y por fuera, respetando la estética de tu casa.',
    alt: 'Instalación limpia con canaletas PVC ordenadas sin cables colgando en vivienda del Biobío',
  },
  {
    img: imgCamaraPorton,
    badge: 'Portón vigilado 24/7',
    title: 'Cámara hasta el portón de entrada',
    desc: 'Mira quién llega a tu parcela directo desde el celular, incluso sin enchufe en el portón.',
    alt: 'Cámara de seguridad instalada en portón de entrada de parcela en la Región del Biobío',
  },
  {
    img: imgRackWifi,
    badge: 'Wi-Fi en toda la casa',
    title: 'Router y red ordenados',
    desc: 'Equipos organizados y señal potente en dormitorios, living y segundo piso.',
    alt: 'Instalación ordenada de router Wi-Fi de largo alcance y equipos de red en hogar del Biobío',
  },
  {
    img: imgFibraDrop,
    badge: 'Larga distancia sin pérdida',
    title: 'Fibra hacia bodega, quincho o portón',
    desc: 'Tendido de fibra óptica de hasta 500 metros dentro de tu terreno manteniendo máxima velocidad.',
    alt: 'Tendido de fibra óptica aérea de larga distancia en parcela de la Región del Biobío',
  },
  {
    img: imgCajaEstanca,
    badge: 'Sellado contra lluvia',
    title: 'Cajas selladas para exterior',
    desc: 'Conexiones protegidas contra humedad costera, sol y temporales del sur.',
    alt: 'Caja estanca exterior sellada contra lluvia y tubería conduit en instalación del Biobío',
  },
];

const faqs = [
  {
    question: '¿Cuánto sale comprar la antena Starlink y cuánto cuesta la mensualidad?',
    answer: 'La antena la compras tú directo en tienda (como Mercado Libre, Falabella o Starlink.com) y puedes pagarla en cuotas; suele rondar entre $180.000–$210.000 (Starlink Mini) y $265.000–$340.000 (Starlink Estándar 4 X / Gen 3) según promociones. Antes de comprar te asesoramos gratis para elegir el modelo exacto. El plan mensual residencial ilimitado lo pagas directo a Starlink sin contratos de amarre (aprox. $35.000 a $47.000 al mes).',
  },
  {
    question: '¿Funciona bien con lluvia intensa y temporales de viento en el Biobío?',
    answer: 'Sí. La antena Starlink está hecha para el clima pesado y tiene calefacción interna contra escarcha. Lo que marca la diferencia en el Biobío es que quede bien anclada en un mástil firme y con sus cajas y pasadas selladas contra la lluvia, que es justamente nuestro estándar en terreno.',
  },
  {
    question: '¿Puedo llevar Wi-Fi firme a mi segundo piso, quincho o cámaras en el portón?',
    answer: 'Sí, totalmente. Si tu casa tiene muros gruesos, dos pisos, quincho o bodega, dejamos puntos de red ordenados con canaletas para que el Wi-Fi llegue fuerte a todos los rincones. Y para tu portón de entrada instalamos cámaras hasta 100 metros con un solo cable (sin necesitar enchufe en el portón) o hasta 500 metros con fibra óptica.',
  },
  {
    question: '¿Qué pasa si tengo muchos árboles altos alrededor de mi parcela?',
    answer: 'Si hay pinos o eucaliptos cerca de la casa, la antena necesita ver el cielo despejado para que no tenga microcortes. Por eso antes de ir revisamos tu terreno con fotos o ubicación y, si hace falta, montamos un mástil elevado firme para despejar el horizonte.',
  },
  {
    question: '¿Cómo se paga la instalación y qué garantía tiene?',
    answer: 'Reservas tu hora de fin de semana con solo $25.000 (que se descuentan del total) para asegurar materiales y agenda. El saldo lo pagas al terminar la instalación, cuando ya probaste el Wi-Fi y la velocidad funcionando en tu celular. Además puedes pedir boleta de honorarios y todo trabajo incluye garantía en terreno.',
  },
  {
    question: '¿Atienden sábados y domingos en parcelas de fin de semana?',
    answer: 'Sí. Sabemos que muchas familias solo pueden ir a su parcela los fines de semana, por eso tenemos agenda dedicada sábados y domingos en Coronel, Concepción, San Pedro, Santa Juana, Yumbel, Florida, Quillón y comunas cercanas.',
  },
];

const allCommunesList = [
  'Región del Biobío',
  'Coronel',
  'Concepción',
  'San Pedro de la Paz',
  'Lota',
  'Santa Juana',
  'Chiguayante',
  'Hualqui',
  'Patagual',
  'Yumbel',
  'Florida',
  'Quillón',
  'Cabrero',
  'Los Ángeles',
  'Arauco',
];

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'HomeAndConstructionBusiness'],
  '@id': `${siteUrl}/#servicio-starlink-biobio`,
  'name': 'HogarTV.cl — Instalación Profesional de Starlink y Redes en el Biobío',
  'description': 'Instalación profesional de internet satelital Starlink (Mini y Estándar 4 X) en altura, asesoría de compra, cableado ordenado con canaletas, cobertura Wi-Fi y cámaras de seguridad al portón en la Región del Biobío.',
  'url': pageUrl,
  'telephone': '+56931926886',
  'priceRange': '$95.000 - $320.000+ CLP',
  'image': `${siteUrl}${heroImage.src}`,
  'logo': `${siteUrl}/favicon-512x512.png`,
  'address': {
    '@type': 'PostalAddress',
    'addressLocality': 'Coronel y Concepción',
    'addressRegion': 'Región del Biobío',
    'addressCountry': 'CL',
  },
  'geo': {
    '@type': 'GeoCoordinates',
    'latitude': -36.827,
    'longitude': -73.0503,
  },
  'openingHoursSpecification': [
    {
      '@type': 'OpeningHoursSpecification',
      'dayOfWeek': ['Saturday', 'Sunday'],
      'opens': '08:30',
      'closes': '20:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      'dayOfWeek': ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      'opens': '09:00',
      'closes': '19:30',
    },
  ],
  'areaServed': allCommunesList.map((place, idx) =>
    idx === 0
      ? { '@type': 'AdministrativeArea', 'name': place }
      : { '@type': 'City', 'name': `${place}, Región del Biobío` }
  ),
  'sameAs': [
    'https://www.tiktok.com/@hogartv.cl',
    'https://www.instagram.com/hogartv.cl/',
    `${siteUrl}/sobre-nosotros/`,
  ],
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'serviceType': 'Instalación de Internet Satelital Starlink, Redes Wi-Fi y Cámaras en Parcelas',
  'name': 'Instalación de Starlink y Cámaras en la Región del Biobío',
  'description': 'Instalación profesional de Starlink en techo o mástil en altura, asesoría de compra, cableado estructurado, fibra óptica hasta 500m y cámaras de seguridad al portón en el Biobío.',
  'url': pageUrl,
  'provider': { '@id': `${siteUrl}/#servicio-starlink-biobio` },
  'areaServed': { '@type': 'AdministrativeArea', 'name': 'Región del Biobío, Chile' },
  'hasOfferCatalog': {
    '@type': 'OfferCatalog',
    'name': 'Paquetes de Instalación Starlink Biobío',
    'itemListElement': packages.map((pkg) => ({
      '@type': 'Offer',
      'priceCurrency': 'CLP',
      'price': String(pkg.min),
      'itemOffered': {
        '@type': 'Service',
        'name': pkg.name,
        'description': pkg.desc,
      },
    })),
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map((item) => ({
    '@type': 'Question',
    'name': item.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': item.answer,
    },
  })),
};
---

<BaseLayout
  title="Instalación Starlink Biobío desde $95.000 | HogarTV.cl"
  description="¿Internet lento en tu parcela del Biobío? Te asesoramos en la compra e instalamos Starlink en 1 día, Wi-Fi en toda tu casa y cámaras al portón. Fines de semana."
  canonical={pageUrl}
  ogImage={heroImage.src}
  disableAds={true}
  breadcrumbs={[
    { name: 'Instalación Starlink Biobío', url: '/servicios/instalacion-starlink-biobio/' },
  ]}
>
  <div class="w-full max-w-full overflow-x-clip pb-24 md:pb-8">

    <!-- ======================================================================= -->
    <!-- 1. HERO DE ALTO IMPACTO (FONDO AZUL MARINO PROFUNDO #0F1824)            -->
    <!-- ======================================================================= -->
    <section class="bg-[#0F1824] text-white pt-4 sm:pt-8 pb-10 sm:pb-14 border-b border-slate-800/80 relative overflow-hidden">
      <!-- Acentos sutiles de marca (#26C6F5 y #FF7010) -->
      <div class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-[#26C6F5]/10 blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="absolute -bottom-24 -left-24 w-72 h-72 rounded-full bg-[#FF7010]/10 blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <!-- Breadcrumb limpio -->
        <nav class="flex flex-wrap items-center gap-1.5 text-xs text-slate-400 mb-4 font-medium" aria-label="Migas de pan">
          <a href="/" class="hover:text-[#26C6F5] transition-colors">Inicio</a>
          <span class="text-slate-600" aria-hidden="true">/</span>
          <span class="text-[#26C6F5] font-bold">Instalación Starlink Biobío</span>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-7 lg:gap-9 items-center">
          <!-- Columna Principal -->
          <div class="lg:col-span-7 space-y-4 sm:space-y-5 min-w-0">
            <div class="inline-flex flex-wrap items-center gap-2 px-3 py-1.5 rounded-full bg-[#1D2731] border border-[#26C6F5]/40 text-[#26C6F5] text-[11px] sm:text-xs font-extrabold tracking-wide">
              <span class="w-2 h-2 rounded-full bg-[#25D366] animate-pulse shrink-0" aria-hidden="true"></span>
              <span>Técnico en terreno · Región del Biobío · Agenda Sábados y Domingos</span>
            </div>

            <h1 class="text-[1.7rem] sm:text-4xl lg:text-[2.6rem] font-black text-white tracking-tight leading-[1.14]">
              ¿Internet lento o sin señal en tu parcela o campo? <span class="text-[#26C6F5]">Dejamos hasta 250 Megas firmes en 1 día.</span>
            </h1>

            <p class="text-sm sm:text-base lg:text-lg text-slate-200 leading-relaxed max-w-2xl">
              Te asesoramos gratis para elegir tu antena e instalamos Starlink con mástil firme sobre árboles, <strong class="text-[#FF7010]">Wi-Fi ordenado en toda tu casa</strong> y cámaras de seguridad hasta el portón.
            </p>

            <!-- 2 CTAs Principales -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-1">
              <a
                href="#cotizador"
                class="min-h-[50px] inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-[#25D366] hover:bg-[#1ebe5d] text-[#09140E] font-black text-sm sm:text-base shadow-[0_8px_24px_rgba(37,211,102,0.3)] transition-all hover:-translate-y-0.5"
              >
                <span>Calcular mi instalación en 15 seg</span>
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                </svg>
              </a>
              <a
                href={waDirectUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="min-h-[50px] inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-2xl bg-[#1D2731] hover:bg-slate-800 text-white border border-slate-600/80 font-bold text-sm transition-colors"
              >
                <svg class="w-4 h-4 text-[#25D366] shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12.031 2c-5.516 0-9.969 4.453-9.969 9.969 0 1.766.469 3.484 1.344 5l-1.406 5.156 5.281-1.391c1.469.797 3.109 1.219 4.75 1.219 5.516 0 9.969-4.453 9.969-9.969S17.547 2 12.031 2zm5.813 14.125c-.25.703-1.438 1.328-2 1.406-.516.078-1.172.109-1.891-.125-.438-.141-1-.328-1.719-.641-3.031-1.313-5.016-4.375-5.172-4.578-.156-.203-1.234-1.641-1.234-3.125s.781-2.219 1.063-2.516c.281-.297.609-.375.813-.375h.578c.188 0 .438-.078.688.516.25.609.859 2.094.938 2.25.078.156.125.344.016.547-.109.203-.156.344-.313.516-.156.188-.328.406-.469.547-.156.156-.328.328-.141.641.188.313.844 1.391 1.813 2.25 1.25 1.109 2.297 1.453 2.609 1.609.313.156.5.125.688-.078.188-.203.781-.906.984-1.219.203-.313.406-.266.688-.156.281.109 1.797.844 2.109 1 .313.156.516.234.594.359.078.125.078.734-.172 1.438z"/>
                </svg>
                <span>Hablar por WhatsApp directo</span>
              </a>
            </div>

            <!-- Micro-pruebas de confianza en 1 fila -->
            <ul class="flex flex-wrap items-center gap-x-4 gap-y-2 pt-1 text-xs sm:text-[13px] font-bold text-slate-200" aria-label="Garantías principales">
              <li class="inline-flex items-center gap-1.5">
                <span class="text-[#26C6F5]" aria-hidden="true">✓</span>
                <span>Instalación desde $95.000</span>
              </li>
              <li class="inline-flex items-center gap-1.5">
                <span class="text-[#26C6F5]" aria-hidden="true">✓</span>
                <span>Pagas al terminar funcionando</span>
              </li>
              <li class="inline-flex items-center gap-1.5">
                <span class="text-[#FF7010]" aria-hidden="true">✓</span>
                <span>Ideal para parcelas de fin de semana</span>
              </li>
            </ul>
          </div>

          <!-- Imagen Hero LCP Optimizada -->
          <div class="lg:col-span-5 min-w-0">
            <div class="rounded-3xl overflow-hidden border border-[#26C6F5]/35 bg-[#1D2731] shadow-2xl">
              <div class="relative aspect-[16/10] sm:aspect-[4/3] w-full overflow-hidden bg-[#0F1824]">
                <Image
                  src={heroImage}
                  alt="Instalación profesional de antena Starlink en parcela de la Región del Biobío con mástil firme"
                  width={900}
                  height={675}
                  format="webp"
                  quality={88}
                  loading="eager"
                  fetchpriority="high"
                  class="w-full h-full object-cover"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#0F1824] via-[#0F1824]/20 to-transparent"></div>
                <div class="absolute top-3 left-3 right-3 flex items-center justify-between gap-2">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#0F1824]/90 border border-[#26C6F5]/50 text-[#26C6F5] text-[11px] font-extrabold">
                    Hasta 250 Megas reales
                  </span>
                  <Image
                    src={hogarTvLogo}
                    alt="Sello HogarTV.cl"
                    width={36}
                    height={36}
                    format="webp"
                    loading="eager"
                    class="w-9 h-9 rounded-full object-contain drop-shadow-md"
                  />
                </div>
                <div class="absolute bottom-3 left-4 right-4">
                  <p class="text-xs sm:text-sm font-bold text-white drop-shadow m-0">
                    Dejamos tu casa o parcela conectada en 1 día · Trabajo limpio y garantizado
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ======================================================================= -->
    <!-- 2. "EXPLICADO CON PERAS Y MANZANAS" (SECCIÓN CLARA ALTO CONTRASTE)      -->
    <!-- ======================================================================= -->
    <section id="como-funciona" class="bg-[#F4F7FB] text-[#0F1824] py-11 sm:py-16 border-b border-slate-200">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mb-8">
          <span class="inline-block px-3 py-1 rounded-full bg-[#26C6F5]/15 text-[#0369A1] text-xs font-black uppercase tracking-wider mb-2">
            Sin palabras enredadas
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-[#0F1824] tracking-tight leading-tight">
            Cómo funciona Starlink explicado con peras y manzanas
          </h2>
          <p class="text-sm sm:text-base text-slate-600 mt-2 leading-relaxed">
            No necesitas saber nada de tecnología. En 3 pasos simples pasas de no tener señal a ver películas, teletrabajar y mirar tus cámaras desde el celular.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
          <!-- Paso 1 -->
