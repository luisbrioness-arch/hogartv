      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 sm:gap-5">
        {pasosTrabajo.map((p) => (
          <div class="p-4 sm:p-5 rounded-2xl bg-surface-card border border-slate-800 flex sm:flex-col items-start gap-3.5 shadow-lg">
            <span class="w-9 h-9 rounded-xl bg-emerald-500/15 border border-emerald-500/40 text-emerald-400 font-mono font-black text-sm flex items-center justify-center shrink-0">
