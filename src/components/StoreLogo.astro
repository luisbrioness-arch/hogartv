---
interface Props {
  network?: string;
  storeName?: string;
  url?: string;
  class?: string;
}

const {
  network: networkProp,
  storeName = '',
  url = '',
  class: className = 'h-6 sm:h-7',
} = Astro.props;

let network = networkProp || '';
if (!network && url) {
  if (url.includes('meli.la') || url.includes('mercadolibre.cl')) network = 'mercadolibre';
  else if (url.includes('creators.falabella.com') || url.includes('falabella.com')) network = 'falabella';
  else if (url.includes('aliexpress.com')) network = 'aliexpress';
}
if (!network && storeName) {
  const s = storeName.toLowerCase();
  if (s.includes('mercado') || s.includes('meli')) network = 'mercadolibre';
  else if (s.includes('falabella')) network = 'falabella';
  else if (s.includes('aliexpress')) network = 'aliexpress';
}
---

{network === 'mercadolibre' ? (
  <img
    src="/images/logos/logo-mercadolibre.webp"
    alt="Mercado Libre"
    width="124"
    height="42"
    loading="lazy"
    decoding="async"
    class={`w-auto object-contain shrink-0 !m-0 !border-0 inline-block ${className}`}
  />
) : network === 'falabella' ? (
  <img
    src="/images/logos/logo-falabella.webp"
    alt="falabella.com"
    width="140"
    height="38"
    loading="lazy"
    decoding="async"
    class={`w-auto object-contain shrink-0 !m-0 !border-0 inline-block ${className}`}
  />
) : network === 'aliexpress' ? (
  <span class={`inline-flex items-center justify-center shrink-0 rounded bg-[#FF4747] border border-rose-400 shadow-sm px-1.5 py-0.5 text-white font-black text-xs tracking-tight ${className}`} title="AliExpress">
    AliExpress
  </span>
) : (
  <span class="inline-flex items-center justify-center shrink-0 text-slate-400 w-4 h-4">
    <svg class="w-full h-full" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
    </svg>
  </span>
)}
