---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import FAQSection from '../components/FAQSection.astro';
import AdSlot from '../components/AdSlot.astro';
import sitioData from '../data/sitio.json';
import afiliadosData from '../data/afiliados.json';
import preciosData from '../data/precios.json';

// Imágenes optimizadas para el Bento Grid y Vitrina de Más Vendidos
import heroCinePieza from '../assets/como-armar-cine-en-casa-barato-pieza-chile/hero.webp';
import heroTvVieja from '../assets/como-convertir-televisor-antiguo-en-smart-tv-chile/hero.webp';
import heroTv32y40 from '../assets/mejores-smart-tv-32-40-pulgadas-baratos-chile/hero.webp';
import heroTv65 from '../assets/mejores-smart-tv-65-pulgadas-chile/hero.webp';

import imgMagcubic from '../assets/accesorios/proyector-magcubic-hy320.webp';
import imgXiaomiBox from '../assets/products/xiaomi-tv-box-s-4k.webp';
import imgTcl55 from '../assets/smart-tv/mejores-smart-tv-calidad-precio-chile/tcl-c655-55.webp';
import imgSamsungBar from '../assets/accesorios/samsung-soundbar-b550.webp';
import imgLucesLed from '../assets/products/luces-led-tv-ambilight.webp';
import imgAntenaTvd from '../assets/tv-abierta/como-sintonizar-canales-hd-tvd-chile/antena-tvd-chile.webp';
import imgSoporteMuro from '../assets/accesorios/soporte-tv-articulado-pesado.webp';
import imgRoku4k from '../assets/accesorios/roku-vs-chromecast-chile-cual-conviene/roku-express-4k.webp';
import imgLagartija from '../assets/products/lagartija-chillona-bicicleta.webp';

const allArticles = await getCollection('articles');
const featuredArticles = allArticles.sort((a, b) => {
  const dateDiff = new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime();
  if (dateDiff !== 0) return dateDiff;
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return 0;
});

const allHeroes = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/hero.{png,jpg,jpeg,webp,avif}', { eager: true });

const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL || sitioData.emailContacto;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  'name': 'HogarTV.cl',
  'url': 'https://hogartv.cl',
  'logo': 'https://hogartv.cl/favicon.svg',
  'description': 'Portal en Chile especializado en datos, picadas tecnológicas, comparativas de Smart TVs, proyectores portátiles, streaming y televisión digital abierta (TVD).',
  'address': {
    '@type': 'PostalAddress',
    'addressCountry': 'CL',
    'addressRegion': 'Región del Biobío',
    'addressLocality': 'Concepción, Región del Biobío, Chile',
  },
  'contactPoint': {
    '@type': 'ContactPoint',
    'contactType': 'customer support',
    'email': contactEmail,
    'availableLanguage': ['Spanish'],
  },
  'knowsAbout': [
    'Smart TV',
    'Proyectores Portátiles',
    'Televisión Digital Abierta Chile (TVD)',
    'Norma ISDB-Tb',
    'Streaming y TV Boxes',
    'Instalación de Antenas y Soportes de TV',
  ],
  'sameAs': [
    'https://hogartv.cl/sobre-nosotros/',
    'https://hogartv.cl/autor/luis-briones/',
