---
interface Props {
  network?: string;
  storeName?: string;
  url?: string;
  class?: string;
}

const {
  network: networkProp,
  storeName = '',
  url = '',
  class: className = 'w-4 h-4',
} = Astro.props;

let network = networkProp || '';
if (!network && url) {
  if (url.includes('meli.la') || url.includes('mercadolibre.cl')) network = 'mercadolibre';
  else if (url.includes('creators.falabella.com') || url.includes('falabella.com')) network = 'falabella';
  else if (url.includes('aliexpress.com')) network = 'aliexpress';
}
if (!network && storeName) {
  const s = storeName.toLowerCase();
  if (s.includes('mercado') || s.includes('meli')) network = 'mercadolibre';
  else if (s.includes('falabella')) network = 'falabella';
  else if (s.includes('aliexpress')) network = 'aliexpress';
}
---

{network === 'mercadolibre' ? (
  <span class={`inline-flex items-center justify-center shrink-0 rounded bg-[#FFE600] border border-yellow-400/90 shadow-sm p-0.5 ${className}`} title="Mercado Libre Chile">
    <svg viewBox="0 0 24 24" class="w-full h-full fill-[#2D3277]" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M19.5 8.25c-.2-.45-.6-.75-1.1-.85l-3.9-.65-1.4-1.4c-.65-.65-1.7-.65-2.35 0L8.7 7.4l-3.9.65c-.5.1-.9.4-1.1.85-.2.45-.1.95.2 1.3l4.3 4.3c.35.35.8.55 1.3.55h.35c.5 0 .95-.2 1.3-.55l.85-.85.85.85c.35.35.8.55 1.3.55h.35c.5 0 .95-.2 1.3-.55l4.3-4.3c.3-.35.4-.85.2-1.3zM12 16.5l-2.6-2.6-1.4 1.4 3.3 3.3c.4.4 1 .4 1.4 0l3.3-3.3-1.4-1.4L12 16.5z"/>
    </svg>
  </span>
) : network === 'falabella' ? (
  <span class={`inline-flex items-center justify-center shrink-0 rounded bg-[#008A00] border border-emerald-400 shadow-sm p-0.5 ${className}`} title="Falabella Chile">
    <svg viewBox="0 0 24 24" class="w-full h-full" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M15.5 4h-3.2c-2.4 0-3.8 1.6-3.8 4.2v2.3H6v3.2h2.5V20h3.8v-6.3h3.8l.6-3.2h-4.4V8.4c0-.9.4-1.3 1.3-1.3h2.2V4z" fill="white"/>
      <circle cx="18" cy="18.5" r="1.8" fill="#C6FF00"/>
    </svg>
  </span>
) : network === 'aliexpress' ? (
  <span class={`inline-flex items-center justify-center shrink-0 rounded bg-[#FF4747] border border-rose-400 shadow-sm p-0.5 ${className}`} title="AliExpress">
    <svg viewBox="0 0 24 24" class="w-full h-full fill-white" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M19 6h-2c0-2.8-2.2-5-5-5S7 3.2 7 6H5c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-7-3c1.7 0 3 1.3 3 3H9c0-1.7 1.3-3 3-3zm7 17H5V8h14v12z"/>
    </svg>
  </span>
) : (
  <span class={`inline-flex items-center justify-center shrink-0 text-slate-400 ${className}`}>
    <svg class="w-full h-full" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
    </svg>
  </span>
)}
