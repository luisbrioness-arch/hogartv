  <!-- Script ligero del Cotizador en 15 segundos (0 dependencias externas) -->
  <script is:inline>
    (function() {
      const form = document.getElementById('starlink-calculator');
      if (!form) return;

      const pkgMap = {
        'base': { name: 'Paquete 1: Base Techo o Muro', min: 95000, max: 110000 },
        'parcela-full': { name: 'Paquete 2: Parcela Full Mástil en Altura', min: 150000, max: 180000 },
        'camara-porton': { name: 'Paquete 3: Cámara al Portón (hasta 100m sin enchufe)', min: 140000, max: 220000 },
        'combo-parcela': { name: 'Paquete 4: Combo Starlink + Portón o Fibra (100–500m)', min: 320000, max: null },
      };

      const comunaSelect = document.getElementById('calc-comuna');
      const outInstall = document.getElementById('out-install');
      const outComuna = document.getElementById('out-comuna');
      const outTravel = document.getElementById('out-travel');
      const outTotal = document.getElementById('out-total');
      const outNote = document.getElementById('out-note');
      const waBtn = document.getElementById('calc-wa-btn');
      const stickyWaBtn = document.getElementById('sticky-wa-btn');

      const fmt = (n) => '$' + Number(n).toLocaleString('es-CL');

      function updateCalc() {
        const checkedPkg = form.querySelector('input[name="paquete"]:checked');
        const checkedAnt = form.querySelector('input[name="antena"]:checked');
        const pkgId = checkedPkg ? checkedPkg.value : 'parcela-full';
        const antenaState = checkedAnt ? checkedAnt.value : 'Sí, ya la compré';
        const pkg = pkgMap[pkgId] || pkgMap['parcela-full'];

        const opt = comunaSelect.options[comunaSelect.selectedIndex];
        const comunaName = opt ? opt.value : 'Coronel';
        const tMin = Number(opt?.getAttribute('data-min') || 0);
        const tMax = Number(opt?.getAttribute('data-max') || 0);

        const installStr = pkg.max ? `${fmt(pkg.min)} – ${fmt(pkg.max)}` : `Desde ${fmt(pkg.min)}`;
        const travelStr = tMin === 0 ? '$0 (Zona Base)' : `+${fmt(tMin)} – ${fmt(tMax)}`;
        const totalMin = pkg.min + tMin;
        const totalMax = pkg.max ? pkg.max + tMax : null;
        const totalStr = totalMax ? `${fmt(totalMin)} – ${fmt(totalMax)}` : `Desde ${fmt(totalMin)}`;

        if (outInstall) outInstall.textContent = installStr;
        if (outComuna) outComuna.textContent = comunaName;
        if (outTravel) outTravel.textContent = travelStr;
        if (outTotal) outTotal.textContent = totalStr;

        if (outNote) {
          if (pkgId === 'camara-porton') {
            outNote.textContent = 'Valor según distancia y si ya tienes tu cámara o la llevamos lista llave en mano · Reservas con $25.000 descontables.';
          } else {
            outNote.textContent = 'Reservas tu fecha con $25.000 descontables y pagas el saldo al terminar funcionando.';
          }
        }

        const msg = [
          'Hola Luis, hice mi cotización en HogarTV.cl:',
          `• Servicio: ${pkg.name}`,
          `• Comuna: ${comunaName} (Traslado: ${travelStr})`,
          `• Total estimado: ${totalStr} (sin antena)`,
          `• Antena Starlink: ${antenaState}`,
          '¿Qué disponibilidad tienes este sábado o domingo?',
        ].join('\n');

        const url = 'https://wa.me/56931926886?text=' + encodeURIComponent(msg);
        if (waBtn) waBtn.setAttribute('href', url);
        if (stickyWaBtn) stickyWaBtn.setAttribute('href', url);
      }

      form.addEventListener('change', updateCalc);
      form.addEventListener('submit', (e) => e.preventDefault());

      // Botones de los paquetes seleccionan automáticamente la opción en el cotizador
      document.querySelectorAll('.pkg-jump-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetPkg = btn.getAttribute('data-select-pkg');
          const radio = form.querySelector(`input[name="paquete"][value="${targetPkg}"]`);
          if (radio) {
            radio.checked = true;
            updateCalc();
          }
          document.getElementById('cotizador')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      updateCalc();
    })();
  </script>

