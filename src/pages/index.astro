---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import FAQSection from '../components/FAQSection.astro';
import AdSlot from '../components/AdSlot.astro';

const allArticles = await getCollection('articles');
const featuredArticles = allArticles.sort(
  (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  'name': 'HogarTV.cl',
  'url': 'https://hogartv.cl',
  'logo': 'https://hogartv.cl/favicon.svg',
  'description': 'Portal técnico independiente en Chile para guías de compra de Smart TVs, tutoriales de TV Digital Abierta (TVD) y streaming.',
  'address': {
    '@type': 'PostalAddress',
    'addressCountry': 'CL',
    'addressLocality': 'Santiago',
  },
  'contactPoint': {
    '@type': 'ContactPoint',
    'contactType': 'customer support',
    'email': 'contacto@hogartv.cl',
    'availableLanguage': ['Spanish'],
  },
  'knowsAbout': [
    'Smart TV',
    'Televisión Digital Abierta Chile',
    'Norma ISDB-Tb',
    'Streaming y TV Sticks',
  ],
  'sameAs': [
    'https://hogartv.cl/sobre-nosotros',
    'https://hogartv.cl/autor/luis-briones',
  ],
};

const categories = [
  {
    name: 'Smart TV',
    slug: 'smart-tv',
    icon: '📺',
    desc: 'Los mejores televisores de 50", 55" y 65" pulgadas analizados para Chile.',
    badge: 'Popular',
    color: 'from-blue-600/20 to-indigo-600/10 border-blue-500/30 text-blue-400',
  },
  {
    name: 'Streaming y TV Online',
    slug: 'streaming',
    icon: '🍿',
    desc: 'Zapping TV, DGO, fútbol chileno y comparativa de planes.',
    badge: 'En tendencia',
    color: 'from-purple-600/20 to-pink-600/10 border-purple-500/30 text-purple-400',
  },
  {
    name: 'TV Abierta Digital (TVD)',
    slug: 'tv-abierta',
    icon: '📡',
    desc: 'Canales nacionales gratis en Full HD (TVN, Mega, Canal 13, CHV).',
    badge: 'Gratis',
    color: 'from-emerald-600/20 to-teal-600/10 border-emerald-500/30 text-emerald-400',
  },
  {
    name: 'Accesorios y TV Sticks',
    slug: 'accesorios',
    icon: '🔌',
    desc: 'Roku, Chromecast con Google TV, antenas HD y barras de sonido.',
    badge: 'Gadgets',
    color: 'from-amber-600/20 to-orange-600/10 border-amber-500/30 text-amber-400',
  },
];
---

<BaseLayout
  title="HogarTV.cl | Guía de Televisión, Streaming y Smart TVs en Chile"
  description="El portal #1 en Chile para elegir tu Smart TV, comparar plataformas de streaming (Zapping, DGO) y sintonizar canales HD abiertos gratis con TVD."
>
  
  <!-- HERO SECTION -->
  <section class="relative overflow-hidden pt-12 pb-20 border-b border-slate-800/80 bg-gradient-to-b from-slate-950 via-surface-dark to-surface-dark">
    <!-- Efecto de luz ambiental de fondo -->
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[600px] h-[350px] bg-brand-600/20 blur-[120px] rounded-full pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-900 border border-slate-700/80 text-xs font-semibold text-slate-300 shadow-sm mb-6">
        <span class="flex h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Portal Especializado en Televisión y Streaming para Chile 🇨🇱 · Edición 2026</span>
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-white tracking-tight leading-tight max-w-4xl mx-auto mb-6">
        Tu guía experta en <span class="bg-clip-text text-transparent bg-gradient-to-r from-brand-400 via-indigo-300 to-brand-500">Smart TVs, Streaming</span> y Televisión en el Hogar
      </h1>

      <p class="text-base sm:text-lg md:text-xl text-slate-300 max-w-2xl mx-auto mb-10 leading-relaxed font-normal">
        Aprende a sintonizar canales HD gratis, compara plataformas de TV online y encuentra el mejor televisor para tu casa sin pagar de más.
      </p>

      <!-- Botones de Acción Rápida -->
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/smart-tv/mejores-smart-tv-calidad-precio-chile/"
          class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-brand-600 to-indigo-600 hover:from-brand-500 hover:to-indigo-500 text-white font-bold text-sm shadow-lg shadow-brand-600/30 hover:shadow-brand-600/50 transition-all transform hover:-translate-y-0.5"
        >
          🔥 Ver Mejores Smart TV 2026
        </a>
        <a
          href="/tv-abierta/como-sintonizar-canales-hd-tvd-chile/"
          class="px-6 py-3.5 rounded-xl bg-surface-card hover:bg-slate-800 text-slate-200 border border-slate-700 text-sm font-semibold transition-all hover:border-slate-600"
        >
          📡 Cómo ver TV Digital Gratis
        </a>
      </div>

    </div>
  </section>

  <!-- CATEGORÍAS PRINCIPALES -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">¿Qué estás buscando hoy?</h2>
        <p class="text-xs sm:text-sm text-slate-400">Selecciona el tema que te interesa para ver guías y recomendaciones actualizadas</p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {categories.map((cat) => (
        <a
          href={`/${cat.slug}/`}
          class={`group relative p-6 rounded-2xl bg-surface-card border border-slate-800 hover:border-slate-600 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl bg-gradient-to-b ${cat.color} flex flex-col justify-between`}
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-3xl p-3 bg-slate-900/80 rounded-xl border border-slate-800 group-hover:scale-110 transition-transform">
                {cat.icon}
              </span>
              <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-slate-900/90 text-slate-300 border border-slate-700/60">
                {cat.badge}
              </span>
            </div>
            <h3 class="text-lg font-bold text-white group-hover:text-brand-300 transition-colors mb-2">
              {cat.name}
            </h3>
            <p class="text-xs text-slate-400 leading-relaxed mb-4">
              {cat.desc}
            </p>
          </div>
          <span class="text-xs font-bold text-brand-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
            <span>Explorar guías</span>
            <span>→</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- RECOMENDACIÓN DESTACADA DE LA SEMANA (Afiliados) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="bg-gradient-to-r from-slate-900 via-surface-card to-slate-900 rounded-3xl p-6 sm:p-10 border border-slate-800 shadow-2xl relative overflow-hidden">
      
      <div class="max-w-2xl mb-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-950 border border-brand-800 text-brand-300 text-xs font-semibold uppercase tracking-wider mb-2">
          <span>⭐ Elección Editorial de la Semana</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
          La Smart TV más recomendada en Chile para 2026
        </h2>
        <p class="text-xs sm:text-sm text-slate-400">
          Evaluada por calidad de pantalla QLED, sonido Dolby Atmos y compatibilidad total con apps locales vía Google TV.
        </p>
      </div>

      <ProductCard
        productKey="tcl-c655-55"
        isFirst={true}
        title='Smart TV TCL 55" QD-Mini LED UHD 4K P8L (Línea 2026)'
        brand="TCL"
        badge="🏆 N°1 Calidad / Precio en Chile 2026"
        specs={["55 Pulgadas 4K", "Panel QD-Mini LED", "Tasa de Refresco 144Hz", "Google TV Oficial", "Dolby Vision & Atmos", "Full Array"]}
        pros={[
          "Tecnología QD-Mini LED: brillo extremo y negros cinematográficos",
          "Panel nativo a 144Hz ideal para partidos de fútbol y consolas (PS5 / Xbox)",
          "Google TV oficial con Play Store Chile (Zapping, DGO, Netflix, etc.)",
          "Comando de voz manos libres con Google Assistant integrado"
        ]}
        cons={[
          "Para sacar el máximo provecho a sus 144Hz se recomienda conectar vía HDMI 2.1"
        ]}
      />

    </div>
  </section>

  <!-- GUÍAS RECIENTES Y ARTÍCULOS -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Guías y Análisis Recientes</h2>
        <p class="text-xs sm:text-sm text-slate-400">Artículos prácticos redactados para resolver dudas reales de televisión en Chile</p>
      </div>
      <a href="/smart-tv/" class="text-xs font-semibold text-brand-400 hover:text-brand-300 hidden sm:inline-block">
        Ver todas →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {featuredArticles.map((article) => {
        const slug = article.id.replace(/\.(md|mdx)$/, '');
        return (
          <article class="flex flex-col bg-surface-card border border-slate-800 rounded-2xl overflow-hidden hover:border-brand-500/50 hover:shadow-xl transition-all duration-300 group">
            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between text-xs text-slate-400 mb-3">
                  <span class="text-brand-400 font-semibold uppercase tracking-wider">{article.data.categoryName}</span>
                  <span>{article.data.publishDate}</span>
                </div>
                <h3 class="text-lg sm:text-xl font-bold text-white group-hover:text-brand-300 transition-colors mb-3 leading-snug">
                  <a href={`/${article.data.category}/${slug}/`}>
                    {article.data.title}
                  </a>
                </h3>
                <p class="text-slate-400 text-xs sm:text-sm leading-relaxed mb-4 line-clamp-3">
                  {article.data.description}
                </p>
              </div>
              <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between text-xs">
                <span class="text-slate-400">⏱️ {article.data.readTime}</span>
                <a
                  href={`/${article.data.category}/${slug}/`}
                  class="font-bold text-brand-400 hover:text-brand-300 group-hover:translate-x-0.5 transition-transform"
                >
                  Leer guía →
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- ESPACIO PUBLICITARIO PROGRAMÁTICO -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <AdSlot format="banner" label="Espacio Patrocinado" />
  </div>

  <!-- SECCIÓN FAQ GENERAL -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <FAQSection
      title="Preguntas Frecuentes sobre Televisión en Chile"
      items={[
        {
          question: "¿Qué es HogarTV.cl y qué tipo de contenidos publica?",
          answer: "HogarTV.cl es un portal digital independiente chileno enfocado en ayudar a las familias y usuarios a optimizar su experiencia de televisión en casa. Publicamos guías de compra de Smart TVs, comparativas de plataformas de streaming por internet (Zapping, DGO, etc.) y manuales paso a paso para sintonizar canales HD gratuitos mediante la Televisión Digital Abierta (TVD)."
        },
        {
          question: "¿Los precios de los televisores y accesorios están en moneda chilena?",
          answer: "Sí, todos los precios mostrados en HogarTV.cl están expresados en Pesos Chilenos (CLP). Corresponden a valores referenciales tomados en la fecha indicada junto a cada producto en comercios electrónicos como Mercado Libre Chile. Dado que las ofertas y el stock fluctúan con frecuencia, recomendamos siempre verificar el precio final y las condiciones de compra directamente en la tienda oficial antes de adquirir un producto."
        },
        {
          question: "¿Cómo puedo contactar o sugerir un tema para analizar?",
          answer: "Puedes escribirnos a través de nuestra página de contacto con tus dudas sobre modelos de televisores, compatibilidad de aplicaciones o sintonización en tu región. Actualizamos continuamente las guías técnicas según las consultas de la comunidad chilena."
        }
      ]}
    />
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
</BaseLayout>
