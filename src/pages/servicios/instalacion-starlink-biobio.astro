    <!-- ======================================================================= -->
    <!-- 3. CÓMO FUNCIONA (3 PASOS CLAROS)                                       -->
    <!-- ======================================================================= -->
    <section id="como-trabajamos" class="max-w-6xl mx-auto px-3.5 sm:px-6 lg:px-8 py-9 sm:py-12 border-b border-slate-800/70">
