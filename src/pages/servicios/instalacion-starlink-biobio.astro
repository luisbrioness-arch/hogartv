          <span class="text-xs font-black uppercase tracking-wider text-emerald-400 block mb-1">Estándar de Terminaciones</span>
          <h2 class="text-xl sm:text-3xl font-black text-white tracking-tight">
            Galería de Trabajos en el Biobío
          </h2>
        </div>
        <a href={waUrl} target="_blank" rel="noopener noreferrer" class="text-xs font-extrabold text-emerald-400 hover:text-emerald-300">
          Pedir fotos de trabajos por WhatsApp →
        </a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4">
        {galeriaTrabajos.map((item) => (
          <figure class="rounded-2xl overflow-hidden bg-surface-card border border-slate-800 shadow-lg flex flex-col m-0 group">
            <div class="relative aspect-[3/2] w-full overflow-hidden bg-slate-950 border-b border-slate-800">
              <Image
                src={item.img}
                alt={item.alt}
                width={800}
                height={533}
                format="webp"
                quality={85}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
