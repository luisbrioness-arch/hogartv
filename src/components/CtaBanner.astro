---
interface Props {
  title?: string;
  description?: string;
  buttonText?: string;
  buttonUrl?: string;
}

const { 
  title = "¿Buscas el mejor dispositivo para tu TV?", 
  description = "Descubre nuestra selección de antenas, decodificadores y Smart TVs más recomendados para disfrutar del contenido en Full HD.",
  buttonText = "Ver Tienda de Recomendados",
  buttonUrl = "/recomendados"
} = Astro.props;
---

<div class="my-10 bg-gradient-to-br from-indigo-900/40 via-slate-900 to-slate-900 border border-indigo-500/20 rounded-2xl p-6 sm:p-8 flex flex-col md:flex-row items-center justify-between gap-6 overflow-hidden relative">
  <!-- Decoración de fondo -->
  <div class="absolute -top-24 -right-24 w-48 h-48 bg-indigo-500/10 rounded-full blur-3xl"></div>
  <div class="absolute -bottom-24 -left-24 w-48 h-48 bg-sky-500/10 rounded-full blur-3xl"></div>
  
  <div class="flex-1 relative z-10 text-center md:text-left">
    <h3 class="text-xl sm:text-2xl font-bold text-white mb-2">{title}</h3>
    <p class="text-slate-300 text-sm sm:text-base leading-relaxed">{description}</p>
  </div>
  
  <div class="relative z-10 shrink-0 w-full md:w-auto">
    <a href={buttonUrl} class="flex items-center justify-center gap-2 w-full md:w-auto bg-indigo-600 hover:bg-indigo-500 text-white font-semibold py-3 px-6 rounded-xl transition-all duration-300 hover:shadow-lg hover:shadow-indigo-500/25 group">
      <span>{buttonText}</span>
      <svg class="w-5 h-5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
      </svg>
    </a>
  </div>
</div>
