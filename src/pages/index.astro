    subPrice: 'o $ 44.990 en AliExpress',
    image: imgMagcubic,
    reviewUrl: '/smart-tv/review-proyector-magcubic-hy320-vs-hy300-chile/',
    reviewLabel: 'Ver pruebas y detalles →',
    primaryCtaText: 'Comprar en M. Libre',
    primaryCtaUrl: afiliadosData['proyector-magcubic-hy320'].url,
    primaryCtaClass: 'bg-[#FFE600] hover:bg-[#F5D600] text-slate-950 border-yellow-400',
    secondaryCtaText: 'Ver en AliExpress',
    secondaryCtaUrl: afiliadosData['proyector-magcubic-aliexpress'].url,
    secondaryCtaClass: 'bg-[#FF4747] hover:bg-[#E03030] text-white border-rose-400',
  },
