---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página no encontrada (Error 404)"
  description="La página que buscas no existe o ha sido movida."
  breadcrumbs={[{ name: 'Página no encontrada', url: '/' }]}
>
  <div class="min-h-[60vh] flex flex-col items-center justify-center text-center px-4 py-16">
    <div class="w-16 h-16 rounded-2xl bg-brand-900/40 border border-brand-700/50 flex items-center justify-center text-3xl mb-6 shadow-lg shadow-brand-500/10">
      📡
    </div>
    <span class="text-xs font-mono font-bold uppercase tracking-widest text-brand-400 mb-2">Error 404 - Sin Señal</span>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-white mb-4">Parece que este canal no está sintonizado</h1>
    <p class="text-sm sm:text-base text-slate-400 max-w-md mb-8 leading-relaxed">
      La guía o producto que estás buscando ha cambiado de lugar o ya no se encuentra disponible.
    </p>
    <div class="flex flex-wrap gap-4 justify-center">
      <a
        href="/"
        class="px-6 py-3 rounded-xl bg-brand-600 hover:bg-brand-500 text-white font-bold text-xs sm:text-sm transition-all"
      >
        Volver a la Portada
      </a>
      <a
        href="/smart-tv/"
        class="px-6 py-3 rounded-xl bg-surface-card hover:bg-slate-800 text-slate-300 border border-slate-700 text-xs sm:text-sm font-semibold transition-all"
      >
        Ver Smart TVs Recomendados
      </a>
    </div>
  </div>
</BaseLayout>
