              <span class="text-[10px] font-bold uppercase text-emerald-400 block">{item.tag}</span>
              <span class="text-xs sm:text-sm font-extrabold text-white block leading-snug">{item.title}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- ======================================================================= -->
    <!-- 5. COBERTURA LOCAL BIOBÍO + QUIÉN INSTALA (100% MARCA HOGARTV)          -->
    <!-- ======================================================================= -->
    <section id="cobertura-biobio" class="max-w-6xl mx-auto px-3.5 sm:px-6 lg:px-8 py-9 sm:py-12 border-b border-slate-800/70 space-y-6">
      <!-- Cobertura clara + desplegable completo -->
      <div class="rounded-3xl bg-surface-card border border-slate-800 p-5 sm:p-7 space-y-4 shadow-xl">
        <div>
          <span class="text-xs font-black uppercase tracking-wider text-emerald-400 block mb-1">Cobertura 8ª Región</span>
          <h2 class="text-xl sm:text-2xl font-black text-white">
            Comunas donde Instalamos en la Región del Biobío
          </h2>
        </div>

        <ul class="flex flex-wrap gap-2">
          {comunasDestacadas.map((c) => (
            <li class="px-3 py-1.5 rounded-xl bg-slate-900 border border-slate-700/80 text-xs font-bold text-white">
              📍 {c}
            </li>
          ))}
        </ul>

        <details class="rounded-xl bg-slate-950/75 border border-slate-800 overflow-hidden group">
          <summary class="flex items-center justify-between gap-2 px-4 py-2.5 cursor-pointer list-none select-none text-xs font-extrabold text-sky-300 hover:text-white">
            <span>Ver lista completa de las 17 comunas y sectores rurales</span>
            <svg class="w-4 h-4 text-sky-400 group-open:rotate-180 transition-transform shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
            </svg>
          </summary>
          <div class="p-4 border-t border-slate-800 grid grid-cols-1 sm:grid-cols-3 gap-4">
            {coberturaZonas.map((z) => (
              <div class="space-y-1.5">
                <h3 class="text-xs font-black text-emerald-400 uppercase tracking-wider">{z.zone}</h3>
                <p class="text-xs text-slate-300 leading-relaxed m-0">{z.communes.join(' · ')}</p>
              </div>
            ))}
          </div>
        </details>
      </div>

      <!-- Quién instala: 100% marca técnica HogarTV.cl (sin exponer nombre personal) -->
      <div class="rounded-3xl bg-gradient-to-br from-slate-900 via-surface-card to-emerald-950/20 border border-slate-700/80 p-5 sm:p-7 shadow-xl flex flex-col sm:flex-row items-center sm:items-start gap-5">
        <Image
          src={hogarTvLogo}
          alt="Logo oficial del Equipo Técnico HogarTV.cl"
          width={88}
          height={88}
          format="webp"
          quality={90}
          loading="lazy"
          class="w-20 h-20 sm:w-24 sm:h-24 rounded-full object-contain shrink-0 drop-shadow-lg"
        />
        <div class="flex-1 min-w-0 text-center sm:text-left space-y-2.5">
          <div>
            <span class="text-[11px] font-black uppercase tracking-wider text-emerald-400 block">Respaldo Técnico Local</span>
            <h2 class="text-lg sm:text-2xl font-black text-white">
              Equipo Técnico HogarTV.cl — Especialistas en Terreno
            </h2>
          </div>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Contamos con más de <strong class="text-white">8 años de experiencia real en terreno en la Región del Biobío</strong> trabajando en redes de fibra óptica FTTH, enlaces satelitales Starlink, cableado estructurado Cat6/Cat6A con canalización limpia y seguridad IP/PoE. Atención directa sin intermediarios.
          </p>
          <ul class="flex flex-wrap justify-center sm:justify-start gap-1.5 text-[11px] font-semibold text-slate-200">
            <li class="px-2.5 py-1 rounded-lg bg-slate-950 border border-slate-800">✓ Especialistas FTTH y Starlink</li>
            <li class="px-2.5 py-1 rounded-lg bg-slate-950 border border-slate-800">✓ Canalización prolija</li>
            <li class="px-2.5 py-1 rounded-lg bg-slate-950 border border-slate-800">✓ Garantía en terreno</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ======================================================================= -->
    <!-- 6. PREGUNTAS FRECUENTES (FAQPage JSON-LD SINCRONIZADO)                  -->
    <!-- ======================================================================= -->
    <section id="preguntas-frecuentes" class="max-w-4xl mx-auto px-3.5 sm:px-6 lg:px-8 pt-2 pb-4">
