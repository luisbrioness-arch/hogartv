---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import afiliadosData from '../data/afiliados.json';
import preciosData from '../data/precios.json';
import AffiliateLink from './AffiliateLink.astro';
import Precio from './Precio.astro';

interface Props {
  productKey: string;
  title: string;
  brand?: string;
  badge?: string;
  rating?: number;
  reviewCount?: number;
  price?: string;
  specs?: string[];
  pros: string[];
  cons: string[];
  image?: ImageMetadata;
  imageUrl?: string;
  alt?: string;
  isFirst?: boolean;
  tiendas?: {
    tienda: string;
    precio: string;
    badge?: string;
    destacada?: boolean;
    envio?: string;
    url?: string;
    urlKey?: string;
  }[];
}

const {
  productKey,
  title,
  brand,
  badge = '⭐ Elección Recomendada',
  rating,
  reviewCount,
  price,
  specs = [],
  pros = [],
  cons = [],
  image,
  imageUrl,
  alt,
  isFirst = false,
  tiendas: tiendasProp,
} = Astro.props;

// Validación de accesibilidad: alt es obligatorio y no puede estar vacío
const imageAlt = (alt || title)?.trim();
if (!imageAlt) {
  throw new Error(`[ProductCard] Atributo "alt" o "title" es obligatorio para el producto "${productKey}".`);
}

// Búsqueda dinámica de imagen en src/assets/ si no se pasó una por prop
const allAssets = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{png,jpg,jpeg,webp,avif}', { eager: true });
const matchedEntry = Object.entries(allAssets).find(([path]) => {
  const filename = path.split('/').pop()?.split('.')[0];
  return filename === productKey;
});
const resolvedImage: ImageMetadata | undefined = image || matchedEntry?.[1]?.default;

type AfiliadoItem = {
  nombre: string;
  url: string;
  tienda: string;
  actualizado: string;
  TODO?: string;
};

const afiliadosMap: Record<string, any> = afiliadosData;
const product = (afiliadosData as Record<string, AfiliadoItem>)[productKey];
if (!product) {
  throw new Error(`[ProductCard] productKey "${productKey}" no existe en src/data/afiliados.json`);
}

const tienda = product.tienda;
const precioItem = (preciosData as Record<string, any>)[productKey];
const comparativa = (tiendasProp && tiendasProp.length > 0) ? tiendasProp : (precioItem?.comparativaTiendas || []);

// Helper para clasificar enlaces y asignar estilo de marca de alta conversión
function getStoreAffiliateTheme(url: string, storeName?: string) {
  const safeUrl = url || '';
  const isMeli = safeUrl.includes('meli.la') || safeUrl.includes('mercadolibre.cl');
  const isFalabella = safeUrl.includes('creators.falabella.com');
  const isAliExpress = safeUrl.includes('s.click.aliexpress.com') || (safeUrl.includes('aliexpress.com') && safeUrl.includes('aff_platform'));

  if (isMeli) {
    return {
      isOperative: true,
      network: 'mercadolibre',
      storeName: 'Mercado Libre',
      btnBg: 'bg-[#FFE600] hover:bg-[#F5D600] !text-slate-950 border-yellow-400 shadow-md shadow-yellow-500/25',
      btnText: 'Comprar',
      btnFullText: 'Comprar en Mercado Libre',
      badgeText: '⚡ Envío Full Garantizado',
      badgeClass: 'bg-yellow-500/20 text-yellow-300 border-yellow-500/40',
      rowBorder: 'border-l-4 border-yellow-400 bg-yellow-950/20 hover:bg-yellow-950/30',
      dotClass: 'bg-yellow-400 animate-pulse shadow-sm shadow-yellow-400/50',
      iconColor: 'text-slate-950',
      tagIcon: '⚡',
    };
  }

  if (isFalabella) {
    return {
      isOperative: true,
      network: 'falabella',
      storeName: 'Falabella',
      btnBg: 'bg-[#008A00] hover:bg-[#007000] !text-white border-emerald-400 shadow-md shadow-emerald-700/30',
      btnText: 'Comprar',
      btnFullText: 'Comprar en Falabella',
      badgeText: '⭐ Enlace Oficial Falabella',
      badgeClass: 'bg-emerald-500/20 text-emerald-300 border-emerald-500/40',
      rowBorder: 'border-l-4 border-emerald-500 bg-emerald-950/25 hover:bg-emerald-950/35',
      dotClass: 'bg-emerald-400 animate-pulse shadow-sm shadow-emerald-400/50',
      iconColor: 'text-white',
      tagIcon: '🛍️',
    };
  }

  if (isAliExpress) {
    return {
      isOperative: true,
      network: 'aliexpress',
      storeName: 'AliExpress',
      btnBg: 'bg-[#FF4747] hover:bg-[#E03030] !text-white border-rose-400 shadow-md shadow-rose-700/30',
      btnText: 'Comprar',
      btnFullText: 'Comprar en AliExpress',
      badgeText: '🔥 Oferta Directa Fábrica',
      badgeClass: 'bg-rose-500/20 text-rose-300 border-rose-500/40',
      rowBorder: 'border-l-4 border-rose-500 bg-rose-950/25 hover:bg-rose-950/35',
      dotClass: 'bg-rose-400 animate-pulse shadow-sm shadow-rose-400/50',
      iconColor: 'text-white',
      tagIcon: '📦',
    };
  }

  // Tienda de referencia no monetizada
  return {
    isOperative: false,
    network: 'reference',
    storeName: storeName || 'Tienda',
    btnBg: 'bg-slate-800/80 hover:bg-slate-700 !text-slate-400 hover:!text-slate-200 border-slate-700/70 shadow-none',
    btnText: 'Cotizar',
    btnFullText: `Cotizar en ${storeName || 'Tienda'}`,
    badgeText: 'Precio Referencial',
    badgeClass: 'bg-slate-800 text-slate-500 border-slate-700/60',
    rowBorder: 'border-l-4 border-transparent hover:bg-slate-900/40 opacity-75 hover:opacity-100',
    dotClass: 'bg-slate-600',
    iconColor: 'text-slate-400',
    tagIcon: '🏢',
  };
}

const primaryTheme = getStoreAffiliateTheme(product.url, tienda);

// Identificar tiendas secundarias con enlaces de afiliados operativos (ej: Falabella Creators o AliExpress)
const rawSecondaryAffiliates = comparativa
  .map((t: any) => {
    const storeProductKey = t.urlKey || productKey;
    const storeInfo = afiliadosMap[storeProductKey];
    const targetUrl = t.url || storeInfo?.url || product.url;
    const theme = getStoreAffiliateTheme(targetUrl, t.tienda);
    return {
      tienda: t.tienda,
      precio: t.precio,
      targetUrl,
      theme,
    };
  })
  .filter((item: any) => item.theme.isOperative && item.targetUrl !== product.url);

// Deduplicar para los botones de cabecera por red comercial (evita mostrar 2 botones idénticos de Falabella arriba)
const seenNetworks = new Set<string>();
const secondaryAffiliates = rawSecondaryAffiliates.filter((item: any) => {
  if (seenNetworks.has(item.theme.network)) {
    return false;
  }
  seenNetworks.add(item.theme.network);
  return true;
});

// Reviews y análisis en profundidad con video para modelos específicos
const reviewsMap: Record<string, { url: string; label: string; videoId: string }> = {
  'tcl-c655-55': {
    url: '/smart-tv/review-tcl-c655-p8l-55-chile/',
    label: 'Review a Fondo & Video Test',
    videoId: 'Wzf2fIcIK-I',
  },
  'hisense-u6k-55': {
    url: '/smart-tv/review-hisense-u6k-55-mini-led-chile/',
    label: 'Review a Fondo & Video Test',
    videoId: '-uuiFpxgzPA',
  },
  'samsung-du7000-55': {
    url: '/smart-tv/review-samsung-crystal-du7000-55-chile/',
    label: 'Review a Fondo & Video Test',
    videoId: '93NJU4dE2yw',
  },
  'proyector-magcubic-hy320': {
    url: '/smart-tv/review-proyector-magcubic-hy320-vs-hy300-chile/',
    label: 'Review HY320 vs HY300 & Video Test',
    videoId: 'nS5rBywQF1I',
  },
  'lagartija-chillona-bicicleta': {
    url: '/accesorios/lagarto-verde-auto-movimiento-viral-tiktok-chile/',
    label: 'Review a Fondo & Ficha Técnica',
  },
  'onn-google-tv-4k': {
    url: '/accesorios/mejores-tv-box-android-baratos-buenos-chile/',
    label: 'Guía y Comparativa TV Box Baratos',
  },
  'tv-box-android-economico': {
    url: '/accesorios/mejores-tv-box-android-baratos-buenos-chile/',
    label: 'Guía y Comparativa TV Box Baratos',
  },
  'conversor-hdmi-rca': {
    url: '/accesorios/conectar-tv-box-televisor-antiguo-tubo-chile/',
    label: 'Guía para Teles Antiguas y TV Box',
  },
};

const reviewInfo = reviewsMap[productKey];

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  'name': title,
  'image': resolvedImage ? `https://hogartv.cl${resolvedImage.src}` : undefined,
  'description': specs.length > 0 ? specs.join(' · ') : title,
  'brand': {
    '@type': 'Brand',
    'name': brand || 'Genérica',
  },
  'offers': {
    '@type': 'Offer',
    'url': product.url,
    'priceCurrency': 'CLP',
    'price': precioItem?.precioCLP,
    'priceValidUntil': '2026-12-31',
    'availability': 'https://schema.org/InStock',
    'itemCondition': 'https://schema.org/NewCondition',
    'seller': {
      '@type': 'Organization',
      'name': tienda,
    },
  },
};
---

<div id={productKey} class="my-8 rounded-2xl bg-surface-card border border-slate-700/80 shadow-xl overflow-hidden hover:border-brand-500/50 transition-all duration-300 scroll-mt-24 not-prose">
  <!-- Badge superior de recomendación -->
  {badge && (
    <div class="bg-gradient-to-r from-brand-600 to-indigo-600 px-4 py-1.5 flex items-center justify-between text-xs font-semibold text-white tracking-wide">
      <span>{badge}</span>
      <span class="text-brand-200">Actualizado Chile 2026</span>
    </div>
  )}

  <div class="p-6">
    <div class="flex flex-col md:flex-row gap-6 items-start">
      
      <!-- Contenedor con dimensiones fijas para evitar Cumulative Layout Shift (CLS = 0) -->
      <div class="w-full md:w-56 h-48 md:h-52 bg-slate-900 rounded-xl flex items-center justify-center p-4 border border-slate-800 shrink-0 relative overflow-hidden group">
        {resolvedImage ? (
          <Image
            src={resolvedImage}
            alt={imageAlt}
            width={400}
            height={300}
            format="webp"
            loading={isFirst ? 'eager' : 'lazy'}
            fetchpriority={isFirst ? 'high' : undefined}
            class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300"
          />
        ) : imageUrl ? (
          <img
            src={imageUrl}
            alt={imageAlt}
            width="400"
            height="300"
            loading={isFirst ? 'eager' : 'lazy'}
            fetchpriority={isFirst ? 'high' : undefined}
            class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300"
          />
        ) : (
          <!-- Placeholder documentado para imagen de producto -->
          <div class="text-center">
            <svg class="w-16 h-16 text-slate-600 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <span class="text-xs text-slate-500 uppercase tracking-wider font-semibold block">{brand || 'Equipamiento'}</span>
            <span class="text-[10px] text-slate-600 block mt-1">HogarTV Chile</span>
          </div>
        )}
        <div class="absolute bottom-2 left-2 bg-slate-950/80 backdrop-blur-sm px-2 py-0.5 rounded text-[10px] text-slate-300 font-mono">
          {tienda}
        </div>
      </div>

      <!-- Info del Producto -->
      <div class="flex-1 w-full flex flex-col justify-between">
        <div>
          {brand && (
            <span class="text-xs uppercase tracking-wider font-bold text-brand-400 mb-1 inline-block">
              {brand}
            </span>
          )}
          <h3 class="text-xl md:text-2xl font-bold text-white mb-2 leading-snug">
            {title}
          </h3>

          <!-- Rating con estrellas -->
          {rating && (
            <div class="flex items-center gap-2 mb-4">
              <div class="flex items-center text-accent-gold text-sm" aria-hidden="true">
                {'★'.repeat(Math.floor(rating))}
                <span class="text-slate-500">{'★'.repeat(5 - Math.floor(rating))}</span>
              </div>
              <span class="text-xs font-semibold text-white">{rating}</span>
              {reviewCount && <span class="text-xs text-slate-400">({reviewCount} opiniones)</span>}
            </div>
          )}

          <!-- Especificaciones clave -->
          {specs.length > 0 && (
            <div class="flex flex-wrap gap-1.5 mb-3">
              {specs.map((spec) => (
                <span class="text-xs px-2.5 py-1 rounded-md bg-slate-800 text-slate-300 border border-slate-700/60">
                  {spec}
                </span>
              ))}
            </div>
          )}

          <!-- Enlace a Review Dedicado con Video si existe -->
          {reviewInfo && (
            <div class="mb-4">
              <a
                href={reviewInfo.url}
                class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-indigo-950/70 hover:bg-indigo-900 border border-indigo-500/40 text-indigo-300 hover:text-white text-xs font-bold transition-all shadow-sm hover:scale-[1.02] !no-underline group"
                title={`Ver review técnico completo y prueba en video de ${title}`}
              >
                <span class="w-5 h-5 rounded-lg bg-rose-600 text-white flex items-center justify-center text-[10px] shrink-0 font-mono">▶</span>
                <span>Ver Review a Fondo & Ficha Técnica Completa</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </a>
            </div>
          )}
        </div>

        <!-- Precio y Botones de Acción / Compartir -->
        <div class="pt-6 mt-4 border-t border-slate-700 flex flex-col gap-5">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-5">
            
            <!-- Bloque Precio Principal -->
            <div class="flex flex-col min-w-[180px]">
              <span class="text-xs text-slate-400 font-semibold uppercase tracking-wider mb-1 flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                Precio Referencial
              </span>
              {price ? (
                <div class="text-3xl sm:text-4xl font-black text-emerald-400 tracking-tight font-mono">
                  {price}
                </div>
              ) : (
                <div class="text-3xl sm:text-4xl font-black text-emerald-400 tracking-tight font-mono">
                  <Precio productKey={productKey} showVerification={false} priceClass="text-3xl sm:text-4xl font-black text-emerald-400 tracking-tight font-mono" />
                </div>
              )}
            </div>

            <!-- Botones de Acción (Directos a Tiendas y Copiar) -->
            <div class="flex flex-wrap items-center gap-2.5">
              <!-- Botón Copiar Link -->
              <button
                type="button"
                data-share-url={product.url}
                class="copy-share-btn inline-flex items-center gap-1.5 px-3.5 py-3.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 !text-slate-200 font-semibold text-xs shadow-sm transition-all hover:scale-[1.02] active:scale-[0.98] !no-underline"
                title="Copiar enlace de recomendación" aria-label="Copiar enlace de recomendación"
              >
                <svg class="w-4 h-4 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                <span class="btn-text">Copiar</span>
              </button>

              <!-- Botón CTA Comprar en Tienda Principal Oficial -->
              <AffiliateLink
                productKey={productKey}
                class={`inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl font-black text-sm sm:text-base shadow-lg hover:scale-[1.03] active:scale-[0.98] transition-all !no-underline border ${primaryTheme.btnBg}`}
              >
                <span class={`font-black tracking-tight ${primaryTheme.iconColor}`}>{primaryTheme.btnFullText}</span>
                <svg class={`w-5 h-5 shrink-0 ${primaryTheme.iconColor}`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
              </AffiliateLink>

              <!-- Botones Directos de Tiendas de Afiliados Alternativas Operativas (ej: Falabella Creators o AliExpress Choice) -->
              {secondaryAffiliates.map((sec: any) => (
                <a
                  href={sec.targetUrl}
                  target="_blank"
                  rel="nofollow sponsored noopener noreferrer"
                  class={`inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl font-black text-sm shadow-md hover:scale-[1.03] active:scale-[0.98] transition-all !no-underline border ${sec.theme.btnBg}`}
                  title={`Comprar también en ${sec.tienda}`}
                >
                  <span class={`font-black tracking-tight ${sec.theme.iconColor}`}>{sec.theme.btnFullText}</span>
                  <svg class={`w-4 h-4 shrink-0 ${sec.theme.iconColor}`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </a>
              ))}
            </div>
          </div>

          <!-- Rango de Precios Inteligente (Diseño modernizado tipo tags) -->
          {precioItem && (
            <div class="flex flex-wrap items-center gap-3 pt-4 border-t border-slate-700/50">
              <div class="flex items-center bg-slate-800/80 rounded-lg overflow-hidden border border-slate-700 shadow-inner">
                <div class="bg-slate-700/80 px-3 py-1.5 flex items-center gap-1.5">
                  <span class="text-amber-400 text-sm">🎯</span>
                  <span class="text-xs font-bold text-slate-200 uppercase tracking-wide">Rango Normal</span>
                </div>
                <div class="px-4 py-1.5 font-mono text-sm font-semibold text-slate-300">
                  {precioItem.rango || 'Varía según tienda'}
                </div>
              </div>
              
              <div class="flex items-center bg-emerald-950/30 rounded-lg overflow-hidden border border-emerald-900/50 shadow-inner">
                <div class="bg-emerald-900/50 px-3 py-1.5 flex items-center gap-1.5">
                  <span class="text-emerald-400 text-sm">🔥</span>
                  <span class="text-xs font-bold text-emerald-100 uppercase tracking-wide">Mejor Oferta</span>
                </div>
                <div class="px-4 py-1.5 font-mono text-sm font-black text-emerald-400">
                  {precioItem.precioMinVisto || precioItem.rango?.split('-')[0]?.trim() || precioItem.precioFormateado}
                </div>
              </div>
            </div>
          )}

          <!-- MÓDULO COMPARADOR DE PRECIOS MULTI-TIENDA CHILE (PRICE ANCHORING) -->
          {comparativa.length > 0 && (
            <div class="mt-2 pt-4 border-t border-slate-700/60">
              <div class="flex items-center justify-between mb-2.5">
                <div class="flex items-center gap-1.5">
                  <span class="text-sm">⚖️</span>
                  <span class="text-xs font-bold text-slate-200 uppercase tracking-wide">
                    Comparativa de Precios en Tiendas (Chile)
                  </span>
                </div>
                <span class="text-[10px] text-slate-400 font-mono hidden sm:inline-block">
                  Actualizado Octubre 2026
                </span>
              </div>

              <div class="rounded-xl border border-slate-700/70 bg-slate-950/60 divide-y divide-slate-800/80 overflow-hidden shadow-sm">
                {comparativa.map((t: any) => {
                  const storeProductKey = t.urlKey || productKey;
                  const storeInfo = afiliadosMap[storeProductKey];
                  const targetUrl = t.url || storeInfo?.url || product.url;
                  const theme = getStoreAffiliateTheme(targetUrl, t.tienda);
                  const isAffiliate = theme.isOperative;

                  return (
                    <div class={`px-3 sm:px-4 py-2.5 flex items-center justify-between gap-3 transition-colors ${theme.rowBorder}`}>
                      <div class="flex items-center gap-2.5 min-w-0">
                        <span class={`w-2.5 h-2.5 rounded-full shrink-0 ${theme.dotClass}`}></span>
                        <div class="min-w-0">
                          <div class="flex items-center gap-1.5 flex-wrap">
                            <span class={`text-xs sm:text-sm font-bold ${isAffiliate ? 'text-white' : 'text-slate-400'}`}>
                              {theme.tagIcon} {t.tienda}
                            </span>
                            <span class={`text-[10px] font-black px-1.5 py-0.5 rounded ${
                              t.badge && isAffiliate
                                ? theme.badgeClass
                                : isAffiliate
                                ? theme.badgeClass
                                : 'bg-slate-800 text-slate-500 border border-slate-700/60'
                            }`}>
                              {t.badge || theme.badgeText}
                            </span>
                          </div>
                          {t.envio && (
                            <span class={`text-[10px] sm:text-[11px] block truncate ${isAffiliate ? 'text-slate-300' : 'text-slate-500'}`}>
                              {t.envio}
                            </span>
                          )}
                        </div>
                      </div>

                      <div class="flex items-center gap-2.5 shrink-0">
                        <span class={`text-xs sm:text-sm font-black font-mono ${
                          isAffiliate ? 'text-emerald-400' : 'text-slate-400'
                        }`}>
                          {t.precio}
                        </span>
                        <a
                          href={targetUrl}
                          target="_blank"
                          rel="nofollow sponsored noopener noreferrer"
                          class={`inline-flex items-center gap-1 px-3.5 py-1.5 rounded-xl text-xs font-black transition-all !no-underline border ${
                            isAffiliate
                              ? `${theme.btnBg} hover:scale-105 active:scale-95 shadow-md`
                              : 'bg-slate-800/80 hover:bg-slate-700 !text-slate-400 hover:!text-slate-200 border-slate-700/60 shadow-none'
                          }`}
                          title={`Ver precio en ${t.tienda}`}
                        >
                          <span>{theme.btnText}</span>
                          <svg class={`w-3.5 h-3.5 shrink-0 ${theme.iconColor}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                          </svg>
                        </a>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>

    <!-- Video Review Expandible si existe -->
    {reviewInfo?.videoId && (
      <div class="mt-6">
        <details class="group rounded-2xl bg-slate-900/90 border border-slate-800 overflow-hidden shadow-md">
          <summary class="cursor-pointer px-4 sm:px-5 py-3.5 flex items-center justify-between text-xs sm:text-sm font-bold text-slate-200 hover:text-white select-none bg-slate-900/80 hover:bg-slate-800/80 transition-colors">
            <span class="flex items-center gap-2.5">
              <span class="w-6 h-6 rounded-lg bg-rose-600 text-white flex items-center justify-center text-xs shrink-0 shadow-sm shadow-rose-600/40">▶</span>
              <span>Ver Video Review y Test de Imagen en Español ({brand || 'Smart TV'})</span>
            </span>
            <span class="text-xs font-semibold text-brand-400 group-open:rotate-180 transition-transform">▼ Desplegar Video</span>
          </summary>
          <div class="p-4 sm:p-5 border-t border-slate-800/80 bg-slate-950/80 space-y-3">
            <div class="aspect-video w-full rounded-xl overflow-hidden border border-slate-800 bg-black shadow-inner">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${reviewInfo.videoId}`}
                title={`Video Review de ${title}`}
                class="w-full h-full border-0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs text-slate-400 pt-1">
              <span class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>Video review independiente en español para evaluar nitidez, contraste y fluidez.</span>
              </span>
              <a href={reviewInfo.url} class="text-brand-300 hover:text-white font-bold inline-flex items-center gap-1 hover:underline shrink-0">
                <span>Leer ficha técnica completa</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </details>
      </div>
    )}

    <!-- Pros y Contras -->
    {(pros.length > 0 || cons.length > 0) && (
      <div class={`mt-8 grid grid-cols-1 ${pros.length > 0 && cons.length > 0 ? 'md:grid-cols-2' : ''} gap-5`}>
        
        {pros.length > 0 && (
          <div class="bg-gradient-to-br from-emerald-900/20 to-emerald-950/10 border border-emerald-800/40 rounded-2xl p-6 shadow-sm">
            <div class="flex items-center gap-2 text-emerald-400 font-black text-[13px] uppercase tracking-widest mb-4">
              <div class="bg-emerald-500/20 p-1.5 rounded-lg">
                <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
              </div>
              <span>Por qué elegirlo</span>
            </div>
            <ul class="space-y-3">
              {pros.map((pro) => (
                <li class="flex items-start gap-3">
                  <span class="text-emerald-500 mt-0.5 text-lg leading-none font-bold">✓</span>
                  <span class="text-[14px] text-slate-200 leading-snug font-medium">{pro}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {cons.length > 0 && (
          <div class="bg-gradient-to-br from-rose-900/20 to-rose-950/10 border border-rose-800/40 rounded-2xl p-6 shadow-sm">
            <div class="flex items-center gap-2 text-rose-400 font-black text-[13px] uppercase tracking-widest mb-4">
              <div class="bg-rose-500/20 p-1.5 rounded-lg">
                <svg class="w-4 h-4 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"></path></svg>
              </div>
              <span>A considerar</span>
            </div>
            <ul class="space-y-3">
              {cons.map((con) => (
                <li class="flex items-start gap-3">
                  <span class="text-rose-500 mt-0.5 text-lg leading-none font-bold">×</span>
                  <span class="text-[14px] text-slate-300 leading-snug">{con}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}

  </div>
</div>
<!-- Product Schema JSON-LD para Rich Snippets en Google (Precio CLP, Stock y Marca) -->
<script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

<script>
  document.querySelectorAll('.copy-share-btn').forEach((button) => {
    button.addEventListener('click', async () => {
      const url = button.getAttribute('data-share-url');
      if (!url) return;
      try {
        await navigator.clipboard.writeText(url);
        const textSpan = button.querySelector('.btn-text');
        if (textSpan) {
          const original = textSpan.textContent;
          textSpan.textContent = '¡Copiado!';
          button.classList.add('bg-emerald-800', 'text-white');
          setTimeout(() => {
            textSpan.textContent = original;
            button.classList.remove('bg-emerald-800', 'text-white');
          }, 2000);
        }
      } catch (err) {
        prompt('Copia el siguiente enlace:', url);
      }
    });
  });
</script>
