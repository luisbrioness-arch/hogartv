          <!-- Esquema 50/50 -->
          <div class="p-4 rounded-2xl bg-slate-950 border border-emerald-500/30 space-y-2 text-center">
            <h3 class="text-xs sm:text-sm font-black text-emerald-300">🤝 1 Antena Starlink → 2 Casas Independientes</h3>
            <div class="p-2.5 rounded-xl bg-sky-950/50 border border-sky-500/35 text-xs font-bold text-white">
              📡 Antena Starlink en Altura (150–250 Mbps)
            </div>
            <div class="text-emerald-400 font-black text-xs" aria-hidden="true">↓</div>
            <div class="p-2.5 rounded-xl bg-emerald-950/50 border border-emerald-500/40 text-xs font-bold text-white">
              ⚙️ Control de Red 50/50 (Velocidad pareja y privada)
            </div>
            <div class="text-slate-500 font-black text-xs" aria-hidden="true">↙ &nbsp;&nbsp;&nbsp;&nbsp;&nbsp; ↘</div>
            <div class="grid grid-cols-2 gap-2 text-[11px]">
