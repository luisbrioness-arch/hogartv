    reviewUrl: '/smart-tv/review-tcl-c655-p8l-55-chile/',
    reviewLabel: 'Ver review técnico →',
    primaryCtaText: 'Mercado Libre',
    primaryCtaUrl: afiliadosData['tcl-c655-55'].url,
    primaryCtaClass: 'bg-[#FFE600] hover:bg-[#F5D600] text-slate-950 border-yellow-400',
    secondaryCtaText: 'Falabella',
    secondaryCtaUrl: afiliadosData['falabella-tcl-t6d-55'].url,
    secondaryCtaClass: 'bg-[#008A00] hover:bg-[#007000] text-white border-emerald-400',
  },
  {
    badge: '🔊 Cine en tu Living',
    badgeClass: 'bg-purple-500 text-white',
    title: 'Barra de Sonido Samsung HW-B550 2.1ch (410W)',
