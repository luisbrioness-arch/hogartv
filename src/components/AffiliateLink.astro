---
import afiliadosData from '../data/afiliados.json';

interface Props {
  productKey: string;
  class?: string;
  text?: string;
  showIcon?: boolean;
}

const {
  productKey,
  class: className = '',
  text,
  showIcon = true,
} = Astro.props;

type AfiliadoItem = {
  nombre: string;
  url: string;
  tienda: string;
  actualizado: string;
  TODO?: string;
};

const product = (afiliadosData as Record<string, AfiliadoItem>)[productKey];

if (!product) {
  throw new Error(`[AffiliateLink] La clave "${productKey}" no existe en src/data/afiliados.json`);
}

// Soporte opcional para sobreescribir la URL desde .env (ej. PUBLIC_CHROMECAST_GOOGLE_TV_URL)
const envKey = `PUBLIC_${productKey.replace(/-/g, '_').toUpperCase()}_URL`;
const envUrl = (import.meta.env as Record<string, string | undefined>)[envKey]?.trim();
const targetUrl = envUrl || product.url;

const displayText = text || `Ver precio en ${product.tienda}`;

const isMeli = targetUrl.includes('meli.la') || targetUrl.includes('mercadolibre.cl');
const isFalabella = targetUrl.includes('creators.falabella.com');
const isAliExpress = targetUrl.includes('s.click.aliexpress.com') || (targetUrl.includes('aliexpress.com') && targetUrl.includes('aff_platform'));

let defaultButtonClass = 'inline-flex items-center gap-2 px-4 py-2.5 rounded-xl font-black text-sm shadow-md transition-all hover:scale-105 active:scale-95 !no-underline border';
if (isFalabella) {
  defaultButtonClass += ' bg-[#008A00] hover:bg-[#007000] !text-white border-emerald-400 shadow-emerald-700/30';
} else if (isAliExpress) {
  defaultButtonClass += ' bg-[#FF4747] hover:bg-[#E03030] !text-white border-rose-400 shadow-rose-700/30';
} else if (isMeli) {
  defaultButtonClass += ' bg-[#FFE600] hover:bg-[#F5D600] !text-slate-950 border-yellow-400 shadow-yellow-500/25';
} else {
  defaultButtonClass += ' bg-brand-600 hover:bg-brand-500 !text-white border-brand-500';
}

const finalClass = className || defaultButtonClass;
---

<a
  href={targetUrl}
  target="_blank"
  rel="nofollow sponsored noopener noreferrer"
  class={finalClass}
>
  <slot>
    <span>{displayText}</span>
    {showIcon && (
      <svg class="w-4 h-4 inline-block ml-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    )}
  </slot>
</a>
