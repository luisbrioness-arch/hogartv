  },
  {
    title: 'Roku Express 4K con Control Remoto',
    desc: 'El sistema más fácil para adultos mayores y niños',
    price: '$ 44.990 CLP',
    image: imgRoku4k,
    buyUrl: afiliadosData['roku-express-4k'].url,
    guideUrl: '/accesorios/roku-vs-chromecast-chile-cual-conviene/',
