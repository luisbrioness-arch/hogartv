            </details>
          </article>
        ))}
      </div>

      <!-- Esquema visual opcional plegable (para clientes que quieren entender cómo funciona el 50/50 y portones) -->
      <details class="mt-4 rounded-2xl bg-slate-900/90 border border-slate-800 open:border-sky-500/40 overflow-hidden group">
        <summary class="flex items-center justify-between gap-2 px-4 sm:px-5 py-3.5 cursor-pointer list-none select-none text-xs sm:text-sm font-black text-white hover:text-sky-300 transition-colors">
          <span class="flex items-center gap-2">
            <span aria-hidden="true">🗺️</span>
            <span>Ver esquema fácil: ¿Cómo se comparte Starlink 50/50 y cómo llega una cámara al portón?</span>
