  </div>

  <!-- Botón Flotante Limpio de WhatsApp en Celular (sin número visible) -->
  <div class="md:hidden fixed bottom-3 inset-x-3 z-40 pointer-events-none">
    <a
      id="floating-wa-cta"
      href={waUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="pointer-events-auto w-full flex items-center justify-center gap-2 px-5 py-3.5 rounded-2xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-sm shadow-[0_10px_28px_rgba(16,185,129,0.45)] border border-emerald-300/60"
    >
      <span>📲 Cotizar por WhatsApp</span>
    </a>
  </div>

  <!-- Actualiza el mensaje de WhatsApp con la comuna elegida -->
  <script is:inline>
    (function() {
      const select = document.getElementById('hero-comuna-select');
      const heroCta = document.getElementById('hero-wa-cta');
      const floatCta = document.getElementById('floating-wa-cta');
      if (!select || !heroCta) return;

      const base = 'https://wa.me/56931926886?text=';
      select.addEventListener('change', function() {
        const comuna = select.value;
        const msg = comuna
          ? `Hola HogarTV, quiero cotizar una instalación de Starlink o redes en ${comuna} (Región del Biobío).`
          : 'Hola HogarTV, quiero cotizar una instalación de Starlink o redes en mi comuna en la Región del Biobío.';
        const fullUrl = base + encodeURIComponent(msg);
        heroCta.setAttribute('href', fullUrl);
        if (floatCta) floatCta.setAttribute('href', fullUrl);
      });
    })();
  </script>

  <!-- JSON-LD LocalBusiness / ProfessionalService & Service Catalog -->
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
</BaseLayout>
