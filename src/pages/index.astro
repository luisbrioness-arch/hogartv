const quickNeeds = [
  {
    icon: '🏷️',
    question: 'Quiero ver las ofertas reales de Smart TVs y Gadgets hoy',
    solution: 'Radar actualizado con los descuentos verificados en Mercado Libre Full, Falabella y AliExpress.',
    link: '/ofertas-tv-chile/',
  },
  {
