---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import StoreLogo from '../components/StoreLogo.astro';
import FAQSection from '../components/FAQSection.astro';
import afiliadosData from '../data/afiliados.json';
import preciosData from '../data/precios.json';

import heroBusImg from '../assets/accesorios/proyecto-bus-rescate-yumbel-coronel-restauracion-camper-chile/hero.jpg';
import busLateralImg from '../assets/accesorios/proyecto-bus-rescate-yumbel-coronel-restauracion-camper-chile/bus-lateral-yumbel.jpg';
import busFrenteImg from '../assets/accesorios/proyecto-bus-rescate-yumbel-coronel-restauracion-camper-chile/bus-frente-yumbel.jpg';

const breadcrumbs = [
  { name: 'Reviviendo un Dinosaurio', url: '/dinosaurio/' },
];

const herramientas = [
  {
    badge: '🔋 Baterías 12V / 24V',
    badgeClass: 'bg-amber-500 text-slate-950',
    borderClass: 'border-amber-500/40',
    title: 'Cargador y Partidor Inteligente 12V / 24V',
    desc: 'Fundamental para vehículos que llevan tiempo parados. Reconoce 12V y 24V y trae modo pulso para recuperar baterías descargadas.',
    price: preciosData['partidor-baterias-12v-24v'].precioFormateado,
    url: afiliadosData['partidor-baterias-12v-24v'].url,
  },
  {
    badge: '💦 Lavado Profundo',
    badgeClass: 'bg-sky-500 text-slate-950',
    borderClass: 'border-sky-500/40',
    title: 'Hidrolavadora Alta Presión (1800W - 2000W)',
    desc: 'Para sacar barro seco, musgo de campo y grasa vieja de carrocería, chasis y pasos de rueda sin gastar agua de más.',
    price: preciosData['hidrolavadora-alta-presion'].precioFormateado,
    url: afiliadosData['hidrolavadora-alta-presion'].url,
  },
  {
    badge: '🛠️ Latonería y Corte',
    badgeClass: 'bg-brand-600 text-white',
    borderClass: 'border-brand-500/40',
    title: 'Esmeril Angular / Galletera 4 1/2"',
    desc: 'Para desbaste, limpiar sectores picados y trabajar chapa con disco flap o cepillo copa de alambre.',
    price: preciosData['esmeril-angular-galletera'].precioFormateado,
    url: afiliadosData['esmeril-angular-galletera'].url,
  },
  {
    badge: '🛡️ Control de Óxido',
    badgeClass: 'bg-rose-600 text-white',
    borderClass: 'border-rose-500/40',
    title: 'Convertidor de Óxido Automotriz',
    desc: 'Clave en zona costera como Coronel. Neutraliza el óxido superficial y deja la lata protegida antes del imprimante.',
    price: preciosData['convertidor-oxido-automotriz'].precioFormateado,
    url: afiliadosData['convertidor-oxido-automotriz'].url,
  },
];

const pautaCapitulos = [
  {
    status: 'listo',
    tag: '✅ Publicado · +14,3K vistas',
    title: 'Parte 1: El rescate en Yumbel',
    desc: 'Fuimos a buscar la micro al campo en Yumbel, revisamos baterías, agua y dimos los primeros intentos de arranque.',
  },
  {
    status: 'listo',
    tag: '✅ Publicado · +48,6K vistas',
    title: 'Parte 2: ¿Llegó andando o en grúa a Coronel?',
    desc: 'El viaje por carretera cruzando el Biobío hasta Coronel, vigilando temperatura, frenos y su primer lavado a fondo.',
  },
  {
    status: 'curso',
    tag: '🔧 En proceso · Pauta de la comunidad',
    title: 'Parte 3: Mecánica a fondo (radiador, mazas y aceites)',
    desc: 'Siguiendo los datos que nos dejaron en comentarios: embarillar el radiador, cambiar depósito de agua y mangueras con sus banjos por el óxido, mantención de mazas y calipers, y cambio de aceites (motor, caja y corona).',
  },
  {
    status: 'proximo',
    tag: '🎨 Próxima etapa · Carrocería y Pintura',
    title: 'Parte 4: Latonería, Tratamiento de Óxido y Pintura Completa',
    desc: 'Tratamiento de óxido con convertidor automotriz, corte y parche de latas picadas, enmasillado, lijado, imprimante y la pintura exterior completa para renovar la imagen del dinosaurio.',
  },
  {
    status: 'proximo',
    tag: '⚡ Sello HogarTV · Tecnología a bordo',
    title: 'Fase Tech: Cámaras, sensores, luces, pantallas y Wi-Fi',
    desc: 'Con la mecánica lista y la pintura terminada, pasamos a nuestro terreno: iluminación LED, cámaras de retroceso y seguridad, sensores, pantallas y conectividad a bordo.',
  },
];
---

<BaseLayout
  title="Reviviendo un Dinosaurio 🦖🚌 | Bitácora Oficial @HogarTV.cl"
  description="Serie oficial de @hogartv.cl en TikTok e Instagram: rescate y restauración mecánica de una micro antigua traída de Yumbel a Coronel, más integración tecnológica y herramientas."
  breadcrumbs={breadcrumbs}
>
  <!-- HERO DE BIENVENIDA TIKTOK / INSTAGRAM -->
  <section class="relative overflow-hidden pt-8 pb-12 border-b border-slate-800/80 bg-gradient-to-b from-slate-950 via-surface-dark to-surface-dark">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="rounded-3xl border-2 border-amber-500/50 bg-gradient-to-br from-slate-900 via-slate-950 to-amber-950/25 shadow-2xl p-5 sm:p-8 relative overflow-hidden">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-5 pb-3 border-b border-slate-800/90">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500 text-slate-950 text-xs font-black uppercase tracking-wider shadow-md">
            <span>🦖🚌</span>
            <span>Reviviendo un Dinosaurio · @HogarTV.cl</span>
          </div>
          <span class="text-xs font-bold text-emerald-400">📍 Yumbel ➔ Coronel · Región del Biobío</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-7 items-center">
          <div class="lg:col-span-5">
            <div class="rounded-2xl overflow-hidden border border-slate-700/80 shadow-xl bg-slate-950">
              <Image
                src={heroBusImg}
                alt="Micro Mercedes-Benz Metalpar del proyecto Reviviendo un Dinosaurio traída de Yumbel a Coronel"
                width={720}
                height={540}
                format="webp"
                quality={88}
                class="w-full h-auto object-cover"
                loading="eager"
              />
            </div>
          </div>

          <div class="lg:col-span-7 space-y-4">
            <h1 class="text-2xl sm:text-3xl md:text-4xl font-black text-white leading-tight tracking-tight">
              Reviviendo un Dinosaurio: de Yumbel a Coronel paso a paso
            </h1>
            <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
              Si llegaste desde <strong class="text-white">TikTok</strong> o <strong class="text-white">Instagram (@hogartv.cl)</strong>, estás en el lugar correcto. Somos el equipo detrás de <strong class="text-brand-300">HogarTV</strong>, técnicos en conectividad del Biobío: hacemos guías de internet, Smart TVs y tecnología, y además nos metimos en el desafío de rescatar y restaurar esta micro antigua en Coronel.
            </p>
            <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
              El plan es simple y real: <strong class="text-amber-300">recuperación mecánica completa</strong> (radiador, mangueras, frenos y aceites), <strong class="text-rose-300">latonería y pintura completa</strong>, y <strong class="text-sky-300">fase tecnológica</strong> (cámaras, sensores, pantallas, luces y Wi-Fi).
            </p>

            <div class="flex flex-wrap gap-2.5 pt-2">
              <a
                href="#capitulos"
                class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-xs sm:text-sm shadow-lg transition-all"
              >
                <span>📋 Ver Pauta Parte 3</span>
                <span>↓</span>
              </a>
              <a
                href="#herramientas"
                class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-white border border-slate-600 font-bold text-xs sm:text-sm transition-all"
              >
                <span>🛠️ Herramientas Usadas</span>
                <span>↓</span>
              </a>
              <a
                href="#talleres-biobio"
                class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-emerald-950/80 hover:bg-emerald-900/80 text-emerald-300 border border-emerald-500/40 font-bold text-xs sm:text-sm transition-all"
              >
                <span>🤝 ¿Quieres aportar o tienes taller?</span>
              </a>
            </div>

            <!-- Botones Oficiales Redes Sociales con Logos y Colores -->
            <div class="pt-3 border-t border-slate-800/80 flex flex-wrap items-center gap-3">
              <span class="text-xs font-bold text-slate-400">Síguenos y escríbenos en:</span>
              <a
                href="https://www.tiktok.com/@hogartv.cl"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-black hover:bg-zinc-900 text-white font-black text-xs border border-[#25F4EE]/60 shadow-[0_0_15px_rgba(254,44,85,0.25)] transition-all hover:scale-[1.02]"
              >
                <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
                </svg>
                <span>TikTok @hogartv.cl</span>
              </a>
              <a
                href="https://www.instagram.com/hogartv.cl/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-gradient-to-r from-[#833ab4] via-[#fd1d1d] to-[#fcb045] hover:opacity-95 text-white font-black text-xs shadow-lg shadow-rose-500/20 transition-all hover:scale-[1.02]"
              >
                <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
                <span>Instagram @hogartv.cl</span>
              </a>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- HOJA DE RUTA / CAPÍTULOS -->
  <section id="capitulos" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 border-b border-slate-800/70">
    <div class="mb-8">
      <span class="text-xs font-bold uppercase tracking-wider text-amber-400 block mb-1">Bitácora Real</span>
      <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
        Avance de Capítulos y Pauta Mecánica de la Comunidad
      </h2>
      <p class="text-xs sm:text-sm text-slate-400 mt-1">
        Cada paso lo vamos armando con lo que aparece en terreno y los consejos que nos dejan mecánicos y choferes en los comentarios.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {pautaCapitulos.map((cap) => (
        <div
          class={`rounded-2xl p-5 sm:p-6 border shadow-lg ${
            cap.status === 'curso'
              ? 'bg-amber-950/20 border-amber-500/60'
              : cap.status === 'listo'
              ? 'bg-surface-card border-slate-800'
              : 'bg-slate-900/60 border-sky-500/30'
          }`}
        >
          <span
            class={`inline-block px-2.5 py-1 rounded-full text-[11px] font-black uppercase tracking-wide mb-3 ${
              cap.status === 'curso'
                ? 'bg-amber-500 text-slate-950'
                : cap.status === 'listo'
                ? 'bg-emerald-950 text-emerald-300 border border-emerald-700/50'
                : 'bg-sky-950 text-sky-300 border border-sky-700/50'
            }`}
          >
            {cap.tag}
          </span>
          <h3 class="text-lg font-extrabold text-white mb-2">{cap.title}</h3>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed m-0">{cap.desc}</p>
        </div>
      ))}
    </div>

    <!-- GALERÍA DE FOTOS REALES -->
    <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-5">
      <figure class="rounded-2xl overflow-hidden border border-slate-800 bg-slate-900/90 shadow-lg m-0">
        <Image
          src={busLateralImg}
          alt="Vista lateral del bus rescatado en Yumbel antes del viaje hacia Coronel"
          width={720}
          height={540}
          format="webp"
          quality={85}
          class="w-full h-64 sm:h-72 object-cover"
          loading="lazy"
        />
        <figcaption class="px-4 py-3 text-xs text-slate-300 bg-slate-950/90 border-t border-slate-800">
          📍 Así estaba en el campo en Yumbel revisando compartimentos y baterías antes de echarlo a andar.
        </figcaption>
      </figure>
      <figure class="rounded-2xl overflow-hidden border border-slate-800 bg-slate-900/90 shadow-lg m-0">
        <Image
          src={busFrenteImg}
          alt="Frente del bus Mercedes-Benz Metalpar en Yumbel antes del lavado"
          width={576}
          height={768}
          format="webp"
          quality={85}
          class="w-full h-64 sm:h-72 object-cover object-bottom"
          loading="lazy"
        />
        <figcaption class="px-4 py-3 text-xs text-slate-300 bg-slate-950/90 border-t border-slate-800">
          🚌 Frente del Dinosaurio antes de salir a carretera y pasar por la hidrolavadora en Coronel.
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- HERRAMIENTAS Y CHICHES (AFILIADOS MERCADO LIBRE) -->
  <section id="herramientas" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 border-b border-slate-800/70">
    <div class="mb-8">
      <span class="text-xs font-bold uppercase tracking-wider text-emerald-400 block mb-1">Datos de Taller · Mercado Libre Chile</span>
      <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
        Herramientas que nos han salvado en la restauración
      </h2>
      <p class="text-xs sm:text-sm text-slate-400 mt-1 max-w-3xl">
        Varios nos preguntaron en comentarios qué equipos conviene tener para revivir vehículos o trabajar en casa sin gastar de más. Aquí iremos dejando las herramientas y, más adelante, las cámaras, luces y pantallas que instalemos.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {herramientas.map((item) => (
        <div class={`rounded-2xl border ${item.borderClass} bg-surface-card p-5 flex flex-col justify-between shadow-xl`}>
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class={`px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase ${item.badgeClass}`}>
                {item.badge}
              </span>
              <span class="text-xs font-mono font-bold text-emerald-400">{item.price}</span>
            </div>
            <h3 class="text-base font-black text-white mb-2 leading-snug">{item.title}</h3>
            <p class="text-xs text-slate-300 leading-relaxed mb-4">{item.desc}</p>
          </div>
          <div class="pt-3 border-t border-slate-800">
            <a
              href={item.url}
              target="_blank"
              rel="nofollow sponsored noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 px-3 py-2.5 rounded-xl bg-[#FFE600] hover:bg-[#F5D600] text-slate-950 font-black text-xs shadow-md transition-all"
            >
              <StoreLogo network="mercadolibre" class="h-6" />
              <span>Ver Oferta ↗</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- BLOQUE PARA APORTAR A LA AVENTURA / TALLERES LOCALES (SOLO TIKTOK E INSTAGRAM) -->
  <section id="talleres-biobio" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 border-b border-slate-800/70">
    <div class="rounded-3xl bg-gradient-to-r from-slate-900 via-slate-900 to-emerald-950/40 border-2 border-emerald-500/40 p-6 sm:p-10 shadow-2xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7 space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/40 text-emerald-300 text-xs font-black uppercase tracking-wider">
            <span>🦖 Súmate al Proyecto · Región del Biobío</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-white leading-tight">
            ¿Te gustaría aportar a esta aventura, tirar un buen dato o tienes algún taller?
          </h2>
          <p class="text-sm text-slate-300 leading-relaxed">
            Esta restauración la estamos sacando adelante paso a paso en <strong class="text-white">Coronel</strong> junto a toda la comunidad que se ha ido sumando en los videos.
          </p>
          <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
            Si tienes un <strong class="text-slate-200">taller de radiadores, lubricentro, casa de repuestos, baterías, frenos, latonería o ferretería</strong> en la zona (Coronel, Lota, San Pedro de la Paz, Concepción o Yumbel), o simplemente quieres aportar con un dato mecánico o colaboración para los próximos capítulos, <strong class="text-white">háblanos directo por mensaje en TikTok o Instagram</strong>:
          </p>
        </div>
        <div class="lg:col-span-5 flex flex-col gap-3.5">
          <a
            href="https://www.tiktok.com/@hogartv.cl"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-3 px-6 py-4 rounded-2xl bg-black hover:bg-zinc-900 text-white font-black text-sm sm:text-base border-2 border-[#25F4EE] shadow-[0_0_25px_rgba(254,44,85,0.35)] transition-all hover:scale-[1.02]"
          >
            <svg class="w-6 h-6 shrink-0 text-[#25F4EE]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
            </svg>
            <span>Hablar por TikTok (@hogartv.cl)</span>
            <span>↗</span>
          </a>
          <a
            href="https://www.instagram.com/hogartv.cl/"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-3 px-6 py-4 rounded-2xl bg-gradient-to-r from-[#833ab4] via-[#fd1d1d] to-[#fcb045] hover:opacity-95 text-white font-black text-sm sm:text-base shadow-xl shadow-rose-500/25 transition-all hover:scale-[1.02]"
          >
            <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
