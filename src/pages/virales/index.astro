---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import FAQSection from '../../components/FAQSection.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import lagartijaImg from '../../assets/products/lagartija-chillona-bicicleta.webp';

const breadcrumbs = [
  { name: 'Gadgets Virales de TikTok e Internet en Chile', url: '/virales/' },
];

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'name': 'Los Gadgets y Productos Más Virales de TikTok e Internet en Chile (2026)',
  'description': 'Ranking de los productos virales que son tendencia en redes sociales en Chile: desde el lagarto verde de tablero hasta el mini proyector de techo para dormitorios.',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Adorno Lagarto Verde Impreso en 3D con Resorte para Tablero de Auto y Moto',
      'url': 'https://hogartv.cl/accesorios/lagarto-verde-auto-movimiento-viral-tiktok-chile/',
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': 'Mini Proyector Smart Portátil Magcubic HY320 Full HD 1080p Android 11',
      'url': 'https://hogartv.cl/smart-tv/review-proyector-magcubic-hy320-vs-hy300-chile/',
    },
    {
      '@type': 'ListItem',
      'position': 3,
      'name': 'Kit Tira Luces LED RGBIC TV Ambilight USB reactiva al sonido',
      'url': 'https://hogartv.cl/accesorios/como-armar-cine-en-casa-barato-pieza-chile/',
    },
    {
      '@type': 'ListItem',
      'position': 4,
      'name': 'Xiaomi TV Box S (2nd Gen) 4K Ultra HD con Google TV',
      'url': 'https://hogartv.cl/accesorios/mejores-tv-box-android-baratos-buenos-chile/',
    },
    {
      '@type': 'ListItem',
      'position': 5,
      'name': 'Antena Digital HDTV Interior / Exterior Amplificada 360°',
      'url': 'https://hogartv.cl/tv-abierta/mejores-antenas-tvd-digital-chile/',
    },
  ],
};

const viralesFaqs = [
  {
    question: '¿Por qué todos buscan el lagarto verde de auto en TikTok?',
    answer: 'Se hizo popular en TikTok e Instagram Reels por su diseño cómico de ojos saltones y boca abierta: va montado sobre un resorte y se sacude con el movimiento del auto, la moto o el viento. No emite sonido; su gracia es visual. Se compra desde unos $3.000 CLP en AliExpress o con entrega rápida en Mercado Libre.',
  },
  {
    question: '¿Conviene comprar productos virales en AliExpress o Mercado Libre desde Chile?',
    answer: 'Depende de la urgencia: si quieres el producto para el fin de semana o como regalo inmediato, Mercado Libre Full te lo entrega en 24 a 48 horas en tu casa con garantía nacional. Si no tienes apuro y quieres pagar el precio mínimo de fábrica (ahorrando hasta 50%), AliExpress Choice es excelente y llega por vía aérea entre 10 y 14 días a todo Chile.',
  },
  {
    question: '¿Cómo evitar estafas en anuncios de TikTok e Instagram de productos virales?',
    answer: 'Muchos anuncios en redes sociales te redirigen a tiendas temporales de Shopify extranjeras que cobran en dólares y triplican el valor real del producto (dropshipping). Nunca compres en enlaces desconocidos de historias patrocinadas: busca siempre los enlaces directos de tiendas oficiales con reputación verificada en Mercado Libre Chile o AliExpress Choice, pagando en pesos chilenos y con protección al comprador.',
  },
  {
    question: '¿Qué enchufe pedir en compras de gadgets chinos para Chile?',
    answer: 'En Chile la corriente es de 220V con enchufes de clavijas redondas (Tipo C y L). Siempre que compres un gadget eléctrico en AliExpress (como el proyector Magcubic), selecciona la opción "EU Plug". Jamás elijas "US Plug" (110V patas planas) para no requerir adaptadores adicionales.',
  },
];
---

<BaseLayout
  title="Gadgets Virales de TikTok en Chile (2026): Precios Reales"
  description="Los productos y gadgets más virales de TikTok en Chile. Precios reales, comparativa entre Mercado Libre y AliExpress, y consejos para no pagar de más."
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">

    <!-- HEADER COMPACTO CON LLAMADO A LA ACCIÓN INMEDIATO -->
    <header class="max-w-4xl mx-auto text-center mb-8">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-gradient-to-r from-rose-950 via-purple-950 to-cyan-950 border border-rose-500/40 text-rose-300 text-xs font-black uppercase tracking-wider mb-3 shadow-lg shadow-rose-950/50">
        <span class="w-2.5 h-2.5 rounded-full bg-rose-400 animate-ping"></span>
        <span>Tendencias Virales Chile 2026 · TikTok, Reels y Redes Sociales</span>
      </div>
      
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight mb-3 leading-tight">
        Los Gadgets y Monos Virales que <span class="bg-clip-text text-transparent bg-gradient-to-r from-rose-400 via-fuchsia-400 to-cyan-400">Todos Buscan en Chile</span>
      </h1>
      
      <p class="text-sm sm:text-base text-slate-300 max-w-2xl mx-auto">
        Compara precios reales entre tiendas para comprar los productos del momento al precio más bajo sin caer en sobreprecios de reventa.
      </p>
    </header>

    <!-- ========================================================================= -->
    <!-- HERO CALL TO ACTION: EL VIRAL DEL MOMENTO (LAGARTIJA VERDE CON MOVIMIENTO) -->
    <!-- ========================================================================= -->
    <section id="lagartija-chillona-bicicleta" class="scroll-mt-24 max-w-4xl mx-auto mb-16 p-5 sm:p-8 rounded-3xl bg-gradient-to-br from-emerald-950/60 via-slate-900 to-surface-card border-2 border-emerald-500/80 shadow-2xl relative overflow-hidden">
      <!-- Glow ambiental de fondo -->
      <div class="absolute -top-24 -right-24 w-72 h-72 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

      <!-- Badges de estado superior -->
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="px-3.5 py-1.5 rounded-full bg-emerald-500 text-slate-950 text-xs font-black uppercase tracking-wider flex items-center gap-1.5 shadow-md">
          <span>🦎</span>
          <span>EL VIRAL DEL MOMENTO</span>
        </span>
        <span class="px-3 py-1 rounded-full bg-rose-500/20 text-rose-300 border border-rose-500/40 text-xs font-bold flex items-center gap-1">
          <span>🔥</span> #1 en TikTok e Instagram
        </span>
        <span class="px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/40 text-xs font-bold flex items-center gap-1">
          <span>🌀</span> Se Mueve con el Auto y el Viento
        </span>
      </div>

      <!-- Título del Viral del Momento -->
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-black text-white mb-4 leading-tight">
        Adorno Lagarto Verde Impreso en 3D con Resorte para Tablero de Auto y Moto
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
        <!-- Imagen del Lagarto -->
        <div class="md:col-span-5 flex flex-col items-center">
          <div class="w-full aspect-square max-w-[320px] bg-slate-950/80 rounded-2xl p-4 border border-emerald-500/30 flex items-center justify-center relative overflow-hidden group shadow-inner">
            <Image
              src={lagartijaImg}
              alt="Adorno Lagarto Verde Impreso en 3D con Resorte para Tablero de Auto y Moto Viral TikTok"
              width={400}
              height={400}
              format="webp"
              loading="eager"
              fetchpriority="high"
              class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute bottom-2.5 left-2.5 bg-slate-900/90 border border-slate-700/80 backdrop-blur-sm px-2.5 py-1 rounded-lg text-[11px] text-emerald-300 font-bold">
              Foto Real del Producto
            </div>
          </div>
          <span class="text-[11px] text-slate-400 mt-2 text-center">
            Incluye base de fijación rápida adhesiva sin dejar marcas
          </span>
        </div>

        <!-- Información y LLAMADOS A LA ACCIÓN INMEDIATOS -->
        <div class="md:col-span-7 flex flex-col justify-between">
          <p class="text-sm sm:text-base text-slate-200 leading-relaxed mb-4">
            El mono que todos buscan en redes: un <strong>lagarto verde de ojos saltones y boca abierta montado sobre un resorte ultrasensible</strong>. Al acelerar, tomar curvas o recibir el viento por la ventana, se sacude y baila solo. <strong>No emite ruidos molestos</strong>; su gracia es 100% visual y cómica.
          </p>

          <!-- Precios verificados -->
          <div class="p-3.5 rounded-2xl bg-slate-950/70 border border-slate-800 mb-5">
            <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
              <span>💰</span> Precios Reales Verificados en Chile:
            </div>
            <div class="grid grid-cols-2 gap-2 text-center">
              <div class="p-2 rounded-xl bg-slate-900 border border-slate-800">
                <div class="text-[11px] text-slate-400 font-semibold">AliExpress Choice</div>
                <div class="text-lg sm:text-xl font-black text-rose-400 font-mono">$ 2.990 CLP</div>
                <div class="text-[10px] text-slate-500">Precio fábrica (10-14 días)</div>
              </div>
              <div class="p-2 rounded-xl bg-slate-900 border border-slate-800">
                <div class="text-[11px] text-slate-400 font-semibold">Mercado Libre Full</div>
                <div class="text-lg sm:text-xl font-black text-amber-400 font-mono">$ 5.990 CLP</div>
                <div class="text-[10px] text-slate-500">Llega en 24 a 48 horas</div>
              </div>
            </div>
          </div>

          <!-- ENLACES DE ACCIÓN INMEDIATA -->
          <div class="flex flex-col gap-3">
            <!-- Botón Mercado Libre -->
            <a
              href="https://meli.la/1Yu8FCP"
              target="_blank"
              rel="nofollow sponsored noopener noreferrer"
              class="w-full flex items-center justify-between px-5 py-3.5 rounded-xl bg-[#FFE600] hover:bg-[#F5D600] text-slate-950 font-black text-sm sm:text-base shadow-lg shadow-yellow-500/20 hover:scale-[1.02] active:scale-[0.98] transition-all !no-underline border border-yellow-400"
            >
              <div class="flex items-center gap-2.5">
                <span class="text-lg">⚡</span>
                <div class="text-left">
                  <div class="leading-none font-black">Comprar en Mercado Libre</div>
                  <div class="text-[11px] font-semibold text-slate-800 mt-0.5">Entrega rápida 24-48h en Chile ($5.990)</div>
                </div>
              </div>
              <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </a>

            <!-- Botón AliExpress Choice -->
            <a
              href="https://s.click.aliexpress.com/e/_c44gTIiT"
              target="_blank"
              rel="nofollow sponsored noopener noreferrer"
              class="w-full flex items-center justify-between px-5 py-3.5 rounded-xl bg-[#FF4747] hover:bg-[#E03A3A] text-white font-black text-sm sm:text-base shadow-lg shadow-rose-500/20 hover:scale-[1.02] active:scale-[0.98] transition-all !no-underline border border-rose-500"
            >
              <div class="flex items-center gap-2.5">
                <span class="text-lg">🏭</span>
                <div class="text-left">
                  <div class="leading-none font-black">Comprar en AliExpress Choice</div>
                  <div class="text-[11px] font-semibold text-rose-100 mt-0.5">Precio de fábrica desde $2.990 CLP</div>
                </div>
              </div>
              <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </a>

            <!-- Enlace Review Detallada -->
            <div class="pt-2 text-center sm:text-left">
              <a
                href="/accesorios/lagarto-verde-auto-movimiento-viral-tiktok-chile/"
                class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-400 hover:text-emerald-300 underline underline-offset-4 transition-colors"
              >
                <span>👉 ¿Quieres ver fotos reales y guía de fijación? Lee la review a fondo aquí</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- OTROS VIRALES MÁS ANTIGUOS QUE SIGUEN SIENDO TENDENCIA EN CHILE -->
    <!-- ========================================================================= -->
    <section class="max-w-4xl mx-auto mb-16">
      <div class="flex items-center gap-3 mb-2">
        <span class="w-3 h-3 rounded-full bg-cyan-400"></span>
        <h2 class="text-2xl sm:text-3xl font-black text-white">
          Otros Gadgets Virales que Siguen Siendo Tendencia en Chile
        </h2>
      </div>
      <p class="text-sm sm:text-base text-slate-400 mb-8">
        Productos que saltaron a la fama en redes sociales por su gran utilidad en el hogar, cine en el dormitorio y entretenimiento:
      </p>

      <div class="space-y-12">

        <!-- VIRAL 2: PROYECTOR MAGCUBIC HY320 -->
        <div id="proyector-magcubic-hy320" class="scroll-mt-28 p-6 sm:p-8 rounded-3xl bg-surface-card border border-slate-800 shadow-xl">
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <span class="px-3 py-1 rounded-full bg-brand-600 text-white text-xs font-black uppercase tracking-wider">
              🎬 CINE EN EL TECHO
            </span>
            <span class="px-2.5 py-0.5 rounded-full bg-brand-500/20 text-brand-300 border border-brand-500/30 text-[11px] font-bold">
              Full HD 1080p Nativo
            </span>
            <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-[11px] font-bold">
              WiFi 6 + Android 11
            </span>
          </div>

          <h3 class="text-2xl sm:text-3xl font-black text-white mb-3">
            Mini Proyector Smart Magcubic HY320 (El Rey de las Piezas en TikTok)
          </h3>
          
          <p class="text-sm sm:text-base text-slate-300 leading-relaxed mb-6">
            Un gadget muy visto en videos de dormitorios aesthetic: gracias a su cabezal giratorio de 180°, permite proyectar una pantalla gigante de 100 a 150 pulgadas directo en el techo de tu cama para ver Netflix o YouTube acostado sin cansar el cuello.
          </p>

          <ProductCard
            productKey="proyector-magcubic-hy320"
            title="Proyector Inteligente Portátil Magcubic HY320 Full HD 1080p Nativo Android 11"
            brand="Magcubic"
            badge="🔥 N°1 en Ventas: Disponible en Mercado Libre y AliExpress"
            specs={["Full HD 1080p Nativo", "390 ANSI Lúmenes", "Android 11 Integrado", "WiFi 6 & Bluetooth 5.0", "Giro 180° a Techo"]}
            pros={[
              "Doble opción de compra activa: botón amarillo para envío 24h en Mercado Libre Chile o botón rojo para precio de fábrica en AliExpress",
              "Resolución nativa 1080p real (mucho más nítido que el modelo básico HY300 de 720p)",
              "Corrección trapezoidal automática que endereza la imagen sola al inclinar el proyector",
              "Bluetooth 5.0 para vincular parlantes externos o barras de sonido de forma inalámbrica"
            ]}
            cons={[
              "Como todo proyector LED compacto, requiere usarse de noche o con cortinas blackout para máximo contraste"
            ]}
          />
        </div>

        <!-- VIRAL 3: LUCES LED TV AMBILIGHT -->
        <div id="luces-led-tv-ambilight" class="scroll-mt-28 p-6 sm:p-8 rounded-3xl bg-surface-card border border-slate-800 shadow-xl">
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <span class="px-3 py-1 rounded-full bg-purple-600 text-white text-xs font-black uppercase tracking-wider">
              ✨ SETUP CINEMATOGRÁFICO
            </span>
            <span class="px-2.5 py-0.5 rounded-full bg-purple-500/20 text-purple-300 border border-purple-500/30 text-[11px] font-bold">
              Alimentación USB Directa
            </span>
          </div>

          <h3 class="text-2xl sm:text-3xl font-black text-white mb-3">
            Kit Tira Luces LED RGBIC TV Ambilight USB Reactiva
          </h3>
          
          <p class="text-sm sm:text-base text-slate-300 leading-relaxed mb-6">
            El truco visual que hace que cualquier Smart TV económico de 43 a 65 pulgadas luzca como un televisor premium de $800.000: ilumina la pared trasera al ritmo de la música y reduce la fatiga ocular nocturna al ver películas a oscuras.
          </p>

          <ProductCard
            productKey="luces-led-tv-ambilight"
            title="Kit Tira Luces LED RGBIC TV Ambilight USB 55 a 65 Pulgadas con Control y App"
            brand="Smart RGBIC"
            badge="💡 El Gadget Barato de Mayor Impacto Visual"
            specs={["Conexión USB Directa a TV", "Para TVs de 43\" a 65\"", "Control por App + Mando", "Sincronización con Sonido", "Adhesivo 3M"]}
            pros={[
              "Se enciende y apaga automáticamente junto con el televisor gracias a su alimentación USB de 5V",
              "Reduce el cansancio ocular nocturno y hace que los negros de tu Smart TV luzcan más profundos",
              "Se controla desde el celular vía Bluetooth o con su control remoto incluido (millones de colores y modo música)"
            ]}
            cons={[
              "Limpia bien el polvo de la tapa trasera del televisor antes de pegar la cinta adhesiva para que no se despegue con el calor"
            ]}
          />
        </div>

        <!-- VIRAL 4: XIAOMI TV BOX S 4K -->
        <div id="xiaomi-tv-box-s-4k" class="scroll-mt-28 p-6 sm:p-8 rounded-3xl bg-surface-card border border-slate-800 shadow-xl">
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <span class="px-3 py-1 rounded-full bg-amber-500 text-slate-950 text-xs font-black uppercase tracking-wider">
              🚀 REVIVE TU TELE VIEJA
            </span>
            <span class="px-2.5 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30 text-[11px] font-bold">
              Google TV 4K Oficial
            </span>
          </div>

          <h3 class="text-2xl sm:text-3xl font-black text-white mb-3">
            Xiaomi TV Box S (2nd Gen) 4K Ultra HD
          </h3>
          
          <p class="text-sm sm:text-base text-slate-300 leading-relaxed mb-6">
            El salvavidas viral para evitar botar un televisor que todavía funciona pero cuyas aplicaciones de fábrica ya no abren: le otorga la velocidad, el control por voz y la tienda de aplicaciones completa de Google TV.
          </p>

          <ProductCard
            productKey="xiaomi-tv-box-s-4k"
            title="Xiaomi TV Box S (2nd Gen) 4K Ultra HD con Google TV y Dolby Vision"
            brand="Xiaomi"
            badge="📦 La Mejor TV Box Certificada con Puerto USB"
            specs={["Google TV Oficial", "4K UHD + Dolby Vision", "Puerto USB 2.0 + Audio", "HDMI 2.1", "Control Bluetooth 360°"]}
            pros={[
              "Incluye puerto USB físico para reproducir películas desde pendrive o conectar adaptador de cable de red",
              "Procesador Quad-Core de 2da generación un 25% más rápido que la Mi Box S original",
              "Certificación oficial Google Widevine L1 y Netflix 4K (a diferencia de las cajas chinas genéricas)",
              "Soporta Dolby Vision, HDR10+ y sonido inmersivo Dolby Atmos / DTS-HD"
            ]}
            cons={[
              "Por su formato de caja requiere apoyarse sobre el mueble o repisa junto al televisor"
            ]}
          />
        </div>

        <!-- VIRAL 5: ANTENA DIGITAL HDTV -->
        <div id="antena-tvd-chile" class="scroll-mt-28 p-6 sm:p-8 rounded-3xl bg-surface-card border border-slate-800 shadow-xl">
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <span class="px-3 py-1 rounded-full bg-cyan-600 text-white text-xs font-black uppercase tracking-wider">
              📡 CANALES ABIERTOS GRATIS HD
            </span>
            <span class="px-2.5 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 text-[11px] font-bold">
              Norma ISDB-Tb Chile
            </span>
          </div>

          <h3 class="text-2xl sm:text-3xl font-black text-white mb-3">
            Antena Digital HDTV 360° Interior / Exterior Amplificada
          </h3>
          
          <p class="text-sm sm:text-base text-slate-300 leading-relaxed mb-6">
            El viral definitivo para cortar el cable: capta todos los canales nacionales abiertos en Full HD 1080p sin pagar mensualidades (Mega HD, Chilevisión HD, Canal 13 HD, TVN HD, TV Educa Chile).
          </p>

          <ProductCard
            productKey="antena-tvd-chile"
            title="Antena Digital HDTV Interior / Exterior Amplificada 360° Norma ISDB-Tb"
            brand="HDTV Chile"
            badge="📡 Corta el Cable: Canales Nacionales en HD Gratis"
            specs={["Recepción 360°", "Cable Coaxial 3m", "Base Magnética", "Soporta 1080p y 4K", "Norma ISDB-Tb Chile"]}
            pros={[
              "Cero costo mensual: conecta al puerto ANTENA IN y sintoniza de inmediato",
              "Base magnética que se adhiere a ventanas de metal o rejas para máxima ganancia de señal",
              "Compatible con cualquier Smart TV vendido en Chile desde 2014 (sintonizador digital integrado)"
            ]}
            cons={[
              "En departamentos interiores o subterráneos puede requerir colocarla pegada al marco de la ventana"
            ]}
          />
        </div>

      </div>
    </section>

    <!-- TABLA COMPARATIVA DE PRECIOS VIRALES -->
    <section aria-labelledby="tabla-virales" class="max-w-5xl mx-auto mb-16">
      <h2 id="tabla-virales" class="sr-only">Tabla Comparativa de Gadgets Virales en Chile</h2>
      <ComparisonTable
        title="Comparativa de Gadgets Virales: Mercado Libre vs AliExpress Choice"
        headers={["Producto Viral", "Precio M. Libre (24h)", "Precio AliExpress Choice", "Veredicto Rápido"]}
        rows={[
          {
            feature: "1. Adorno Lagarto Verde con Movimiento para Auto (Bailarín 3D)",
            values: ["$ 5.990 CLP", "$ 2.990 CLP", "M. Libre para regalar este finde / Ali para comprar de a 2"],
            productKey: "lagartija-chillona-bicicleta",
            secondaryProductKey: "lagartija-chillona-aliexpress"
          },
          {
            feature: "2. Mini Proyector Smart Magcubic HY320 1080p Nativo",
            values: ["$ 59.990 CLP", "$ 44.990 CLP", "Ambos: M. Libre por garantía inmediata / Ali por ahorro de $15.000"],
            productKey: "proyector-magcubic-hy320",
            secondaryProductKey: "proyector-magcubic-aliexpress"
          },
          {
            feature: "3. Kit Tira Luces LED RGBIC USB Ambilight TV",
            values: ["$ 12.990 CLP", "$ 8.990 CLP", "Mercado Libre (Llega al día siguiente para tu setup)"],
            productKey: "luces-led-tv-ambilight"
          },
          {
            feature: "4. Xiaomi TV Box S (2nd Gen) 4K Google TV",
            values: ["$ 52.990 CLP", "$ 56.990 CLP", "Mercado Libre (100% Original Certificado con USB)"],
            productKey: "xiaomi-tv-box-s-4k"
          },
          {
