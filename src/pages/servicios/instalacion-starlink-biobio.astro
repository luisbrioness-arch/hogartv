---

<BaseLayout
  title="Instalación Starlink Biobío y Concepción | Redes HogarTV"
  description="Técnico instalador de Starlink (Gen 3 y Mini), cableado estructurado con canaletas y cámaras en Concepción y todo el Biobío. Cotiza por WhatsApp hoy."
  canonical={pageUrl}
  ogImage={heroImage.src}
  disableAds={true}
  breadcrumbs={[
    { name: 'Instalación Starlink Biobío', url: '/servicios/instalacion-starlink-biobio/' },
  ]}
>
  <div class="w-full max-w-full overflow-x-clip pb-24 md:pb-12">

    <!-- ======================================================================= -->
    <!-- 1. HERO DE ALTO IMPACTO (CRO ABOVE THE FOLD · SIN DISTRACCIONES BLOG)   -->
    <!-- ======================================================================= -->
    <section class="relative pt-4 sm:pt-8 pb-10 sm:pb-14 border-b border-slate-800/80 bg-gradient-to-b from-slate-950 via-surface-dark to-surface-dark">
      <div class="max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8">

        <!-- Breadcrumb limpio -->
        <nav class="flex flex-wrap items-center gap-2 text-xs text-slate-400 font-medium mb-4" aria-label="Migas de pan">
          <a href="/" class="hover:text-white transition-colors">Inicio</a>
          <span class="text-slate-600" aria-hidden="true">/</span>
          <span class="text-emerald-400 font-bold">Servicios Biobío · Instalación Starlink y Redes</span>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-9 items-center">

          <!-- Columna Izquierda: Propuesta de Valor + CTAs Directos -->
          <div class="lg:col-span-7 space-y-4 sm:space-y-5 min-w-0">
            <div class="inline-flex flex-wrap items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/40 text-emerald-300 text-[11px] sm:text-xs font-black uppercase tracking-wider">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse" aria-hidden="true"></span>
              <span>Técnico en Terreno · 8ª Región del Biobío</span>
            </div>

            <h1 class="text-2xl sm:text-4xl lg:text-[2.65rem] font-black text-white tracking-tight leading-[1.12]">
              Instalación Profesional de <span class="text-emerald-400">Starlink</span> y Redes en la Región del Biobío
            </h1>

            <p class="text-sm sm:text-base lg:text-lg text-slate-300 leading-relaxed max-w-2xl">
              Soluciones llave en mano para <strong class="text-white">parcelas, casas y empresas</strong> en Concepción, Coronel, San Pedro, Santa Juana, Yumbel, Los Ángeles y toda la 8ª Región: montaje <strong class="text-white">Starlink Gen 3 / Mini</strong> en altura, <strong class="text-sky-300">cableado estructurado Cat6 con canaletas prolijas</strong>, enlaces compartidos 50/50 y <strong class="text-indigo-300">cámaras de seguridad IP PoE</strong>.
            </p>

            <!-- Selector rápido de comuna + CTA principal de WhatsApp (CRO) -->
            <div class="p-3.5 sm:p-4 rounded-2xl bg-slate-900/95 border border-emerald-500/35 shadow-xl space-y-3">
              <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5">
                <div class="sm:w-52 shrink-0">
                  <label for="hero-comuna-select" class="sr-only">Selecciona tu comuna en el Biobío</label>
                  <select
                    id="hero-comuna-select"
                    class="w-full px-3.5 py-3 rounded-xl bg-slate-950 border border-slate-700 text-slate-100 text-xs sm:text-sm font-semibold focus:outline-none focus:border-emerald-400 focus:ring-1 focus:ring-emerald-400"
                  >
                    <option value="">📍 Elige tu comuna (Opcional)</option>
                    {comunasBiobio.map((c) => (
                      <option value={c}>{c}</option>
                    ))}
                    <option value="otro sector de la Región del Biobío">Otro sector del Biobío</option>
                  </select>
                </div>
                <a
                  id="hero-wa-cta"
                  href={waUrl}
