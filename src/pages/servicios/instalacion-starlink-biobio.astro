                <p class="text-[11px] text-slate-400 bg-slate-900/90 px-3 py-2 rounded-lg border border-slate-800">
                  <strong class="text-slate-200">Ideal para:</strong> {srv.ideal}
                </p>
                <a
                  href={`${waBase}${encodeURIComponent(srv.waMsg)}`}
