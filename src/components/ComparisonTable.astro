---
import afiliadosData from '../data/afiliados.json';

interface ColumnCta {
  productKey?: string;
  ctaUrl?: string;
  ctaLabel?: string;
}

interface Props {
  title?: string;
  headers: string[];
  rows: {
    feature: string;
    values: string[];
    productKey?: string;
    ctaUrl?: string;
    ctaLabel?: string;
    secondaryProductKey?: string;
    secondaryCtaUrl?: string;
    secondaryCtaLabel?: string;
  }[];
  columnCtas?: ColumnCta[];
  verdict?: string;
}

const { title = 'Tabla Comparativa Rápida', headers, rows, columnCtas = [], verdict } = Astro.props;

// ID único para instanciar controles independientes si hay múltiples tablas
const tableId = 'comp-' + Math.random().toString(36).slice(2, 9);

// Detectar si la primera columna es "Característica", "Criterio", etc.
const firstHeaderLower = (headers[0] || '').toLowerCase();
const isFeatureComparison =
  firstHeaderLower.includes('característica') ||
  firstHeaderLower.includes('caracteristica') ||
  firstHeaderLower.includes('criterio') ||
  firstHeaderLower.includes('especificación') ||
  firstHeaderLower.includes('especificacion');

const optionCount = headers.length - 1;
const isTwoOptions = optionCount === 2;
const hasAnyRowCta = rows.some((r) => r.productKey || r.ctaUrl || r.secondaryProductKey || r.secondaryCtaUrl);
const hasColumnCtas = columnCtas && columnCtas.length > 0;
const afiliadosMap: Record<string, any> = afiliadosData;

// Helper para clasificar enlaces y asignar estilo de marca de alta conversión
function getStoreAffiliateTheme(url: string, storeName?: string) {
  const safeUrl = url || '';
  const isMeli = safeUrl.includes('meli.la') || safeUrl.includes('mercadolibre.cl');
  const isFalabella = safeUrl.includes('creators.falabella.com');
  const isAliExpress = safeUrl.includes('s.click.aliexpress.com') || (safeUrl.includes('aliexpress.com') && safeUrl.includes('aff_platform'));

  if (isMeli) {
    return {
      isOperative: true,
      network: 'mercadolibre',
      btnBg: 'bg-[#FFE600] hover:bg-[#F5D600] !text-slate-950 border-yellow-400 shadow-md shadow-yellow-500/25',
      btnText: 'Mercado Libre',
      btnFullText: 'Mercado Libre',
      iconColor: 'text-slate-950',
    };
  }

  if (isFalabella) {
    return {
      isOperative: true,
      network: 'falabella',
      btnBg: 'bg-[#008A00] hover:bg-[#007000] !text-white border-emerald-400 shadow-md shadow-emerald-700/30',
      btnText: 'Falabella',
      btnFullText: 'Falabella',
      iconColor: 'text-white',
    };
  }

  if (isAliExpress) {
    return {
      isOperative: true,
      network: 'aliexpress',
      btnBg: 'bg-[#FF4747] hover:bg-[#E03030] !text-white border-rose-400 shadow-md shadow-rose-700/30',
      btnText: 'AliExpress',
      btnFullText: 'AliExpress',
      iconColor: 'text-white',
    };
  }

  return {
    isOperative: false,
    network: 'reference',
    btnBg: 'bg-slate-800 hover:bg-slate-700 !text-slate-300 border-slate-700 shadow-none',
    btnText: 'Ver Oferta',
    btnFullText: 'Ver Oferta',
    iconColor: 'text-slate-400',
  };
}
---

<div class="my-8 rounded-2xl border border-slate-800 bg-surface-card shadow-xl overflow-hidden not-prose" id={tableId}>
  <!-- Encabezado de la Comparativa -->
  <div class="bg-slate-900/95 px-4 sm:px-6 py-3.5 border-b border-slate-800 flex items-center justify-between gap-3">
    <div class="flex items-center gap-2.5 min-w-0">
      <div class="w-8 h-8 rounded-lg bg-brand-500/10 border border-brand-500/20 flex items-center justify-center shrink-0">
        <svg class="w-4 h-4 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
        </svg>
      </div>
      <h3 class="text-sm sm:text-base md:text-lg font-bold text-white truncate m-0">
        {title}
      </h3>
    </div>

    <!-- Controles de Vista en Móvil (Por defecto Fichas sin scroll) -->
    <div class="flex items-center gap-2 shrink-0">
      <span class="text-[11px] text-slate-400 font-mono hidden sm:inline-block">Chile 2026</span>
      
      <div class="inline-flex items-center p-0.5 rounded-lg bg-slate-950/80 border border-slate-800 md:hidden" role="tablist" aria-label="Modo de visualización">
        <button
          type="button"
          class="comp-btn-cards px-2.5 py-1 rounded-md text-[11px] font-bold bg-brand-600 text-white shadow-sm transition-all"
          data-table-target={tableId}
          data-view="cards"
          title="Ver fichas adaptadas a la pantalla (sin scroll)"
        >
          📱 Fichas
        </button>
        <button
          type="button"
          class="comp-btn-table px-2.5 py-1 rounded-md text-[11px] font-medium text-slate-400 hover:text-slate-200 transition-all"
          data-table-target={tableId}
          data-view="table"
          title="Ver tabla completa con desplazamiento"
        >
          📊 Tabla
        </button>
      </div>
    </div>
  </div>

  <!-- AVISO SUTIL DE OPTIMIZACIÓN MÓVIL (Solo en pantallas pequeñas) -->
  <div class="md:hidden px-4 py-1.5 bg-slate-950/60 border-b border-slate-800/60 flex items-center justify-between text-[11px] text-slate-400">
    <span class="flex items-center gap-1.5">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>Ajustado a tu pantalla (sin scroll horizontal)</span>
    </span>
    <span class="text-slate-500 font-mono">{rows.length} filas</span>
  </div>

  <!-- ========================================================================= -->
  <!-- 1. VISTA MÓVIL ADAPTADA (FICHAS 100% EN PANTALLA SIN SCROLL HORIZONTAL)  -->
  <!-- ========================================================================= -->
  <div class="comp-cards-view block md:hidden p-3.5 sm:p-4 space-y-3 bg-slate-950/30">
    {isFeatureComparison ? (
      /* CASO A: Comparación por Característica (Zapping vs DGO, Roku vs Chromecast, TCL vs Hisense) */
      <>
        {rows.map((row) => (
          <div class="rounded-xl border border-slate-800/90 bg-slate-900/70 p-3.5 shadow-sm transition-all">
            <div class="flex items-center gap-2 mb-2.5 pb-2 border-b border-slate-800/80">
              <span class="w-2 h-2 rounded-full bg-brand-400 shrink-0"></span>
              <h4 class="text-xs sm:text-sm font-bold text-white tracking-tight leading-snug m-0">
                {row.feature}
              </h4>
            </div>

            {isTwoOptions ? (
              /* Lado a lado en 2 columnas exactas al 100% del ancho móvil */
              <div class="grid grid-cols-2 gap-2">
                {row.values.map((val, idx) => {
                  const optName = headers[idx + 1] || `Opción ${idx + 1}`;
                  const isPrice = val.includes('$') || row.feature.toLowerCase().includes('precio');
                  const isPrimary = idx === 0;

                  return (
                    <div class={`p-2.5 rounded-lg border flex flex-col justify-between ${
                      isPrimary
                        ? 'bg-slate-950/70 border-brand-500/30'
                        : 'bg-slate-950/70 border-indigo-500/30'
                    }`}>
                      <span class={`text-[10px] font-bold uppercase tracking-wider mb-1 line-clamp-1 ${
                        isPrimary ? 'text-brand-300' : 'text-indigo-300'
                      }`}>
                        {optName}
                      </span>
                      <span class={`text-xs leading-relaxed ${
                        isPrice ? 'font-bold font-mono text-emerald-400' : 'text-slate-200'
                      }`}>
                        {val}
                      </span>
                    </div>
                  );
                })}
              </div>
            ) : (
              /* Más de 2 opciones: lista apilada con identificador */
              <div class="space-y-2">
                {row.values.map((val, idx) => {
                  const optName = headers[idx + 1] || `Opción ${idx + 1}`;
                  const isPrice = val.includes('$') || row.feature.toLowerCase().includes('precio');

                  return (
                    <div class="flex items-start justify-between gap-3 text-xs pt-1.5 border-t border-slate-800/50 first:border-0 first:pt-0">
                      <span class="font-semibold text-brand-300 shrink-0 max-w-[45%] text-[11px]">
                        {optName}:
                      </span>
                      <span class={`text-right ${
                        isPrice ? 'font-bold font-mono text-emerald-400' : 'text-slate-200'
                      }`}>
                        {val}
                      </span>
                    </div>
                  );
                })}
              </div>
            )}
          </div>
        ))}

        {/* Botones de Compra por Columna en Móvil (si existen columnCtas) */}
        {hasColumnCtas && (
          <div class="rounded-xl border border-brand-500/30 bg-slate-900/90 p-3.5 shadow-md space-y-2">
            <span class="text-[11px] font-bold uppercase tracking-wider text-brand-300 block">
              🛒 Enlaces Oficiales de Compra:
            </span>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              {columnCtas.map((cta, idx) => {
                const pKey = cta?.productKey;
                const directUrl = cta?.ctaUrl;
                const productInfo = pKey ? afiliadosMap[pKey] : null;
                const targetUrl = directUrl || productInfo?.url;
                if (!targetUrl) return null;
                const theme = getStoreAffiliateTheme(targetUrl, productInfo?.tienda);
                const optName = headers[idx + 1] || `Opción ${idx + 1}`;
                const label = cta?.ctaLabel || `Ver ${optName}`;

                return (
                  <a
                    href={targetUrl}
                    target="_blank"
                    rel="nofollow sponsored noopener noreferrer"
                    class={`flex items-center justify-between gap-2 px-3.5 py-2.5 rounded-xl font-black text-xs shadow-md hover:scale-[1.02] active:scale-[0.98] transition-all !no-underline border ${theme.btnBg}`}
                  >
                    <span class="truncate">{label}</span>
                    <svg class={`w-3.5 h-3.5 shrink-0 ${theme.iconColor}`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                  </a>
                );
              })}
            </div>
          </div>
        )}
      </>
    ) : (
      /* CASO B: Fila es Producto, Gadget o Servicio */
      rows.map((row, rIdx) => {
        const priceIdx = headers.findIndex((h) => h.toLowerCase().includes('precio'));
        const priceVal = priceIdx > 0 ? row.values[priceIdx - 1] : null;

        const pKey = row.productKey;
        const directUrl = row.ctaUrl;
        const productInfo = pKey ? afiliadosMap[pKey] : null;
        const targetUrl = directUrl || productInfo?.url;
        const tiendaName = productInfo?.tienda || '';
        const hasDual = Boolean(row.secondaryProductKey || row.secondaryCtaUrl);
        const theme = getStoreAffiliateTheme(targetUrl, tiendaName);
        const label = row.ctaLabel || (hasDual ? theme.btnText : theme.btnFullText);

        const secKey = row.secondaryProductKey;
        const secDirectUrl = row.secondaryCtaUrl;
        const secInfo = secKey ? afiliadosMap[secKey] : null;
        const secTargetUrl = secDirectUrl || secInfo?.url;
        const secTheme = secTargetUrl ? getStoreAffiliateTheme(secTargetUrl, secInfo?.tienda) : null;
        const secLabel = row.secondaryCtaLabel || (secTheme ? secTheme.btnText : '');

        return (
          <div class="rounded-xl border border-slate-800/90 bg-slate-900/70 p-3.5 sm:p-4 shadow-sm relative overflow-hidden">
            <!-- Barra superior del producto -->
            <div class="flex items-start justify-between gap-2 mb-3 pb-2.5 border-b border-slate-800/80">
              <div class="min-w-0">
                <span class="text-[10px] font-bold uppercase tracking-wider text-brand-400 block mb-0.5">
                  {headers[0]} #{rIdx + 1}
                </span>
                <h4 class="text-xs sm:text-sm font-bold text-white leading-snug m-0">
                  {row.feature}
                </h4>
              </div>
              {priceVal && (
                <span class="shrink-0 px-2.5 py-1 rounded-lg bg-emerald-950/80 border border-emerald-800/60 text-emerald-300 font-bold font-mono text-xs">
                  {priceVal}
                </span>
              )}
            </div>

            <!-- Lista de atributos formateada -->
            <div class="space-y-2 text-xs">
              {row.values.map((val, idx) => {
                const headerLabel = headers[idx + 1] || '';
                const isPrice = headerLabel.toLowerCase().includes('precio');
                if (isPrice && priceVal) return null;

                return (
                  <div class="flex items-start justify-between gap-3 pt-1.5 border-t border-slate-800/50 first:border-0 first:pt-0">
                    <span class="text-slate-400 font-medium text-[11px] shrink-0 max-w-[45%]">
                      {headerLabel}:
                    </span>
                    <span class={`text-right font-semibold leading-relaxed ${
                      val.includes('$') ? 'text-emerald-400 font-mono font-bold' : 'text-slate-200'
                    }`}>
                      {val}
                    </span>
                  </div>
                );
              })}
            </div>

            <!-- Botones CTA de Compra Directa en Móvil CASO B -->
            {(targetUrl || secTargetUrl) && (
              <div class="mt-3.5 pt-2.5 border-t border-slate-800/80 flex flex-wrap items-center justify-end gap-2">
                {targetUrl && (
                  <a
                    href={targetUrl}
                    target="_blank"
                    rel="nofollow sponsored noopener noreferrer"
                    class={`inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl font-black text-xs shadow-md hover:scale-[1.02] active:scale-[0.98] transition-all !no-underline border ${theme.btnBg}`}
                  >
                    <span>{label}</span>
                    <svg class={`w-3.5 h-3.5 shrink-0 ${theme.iconColor}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                  </a>
                )}
                {secTargetUrl && secTheme && (
                  <a
                    href={secTargetUrl}
                    target="_blank"
                    rel="nofollow sponsored noopener noreferrer"
                    class={`inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl font-black text-xs shadow-md hover:scale-[1.02] active:scale-[0.98] transition-all !no-underline border ${secTheme.btnBg}`}
                  >
                    <span>{secLabel}</span>
                    <svg class={`w-3.5 h-3.5 shrink-0 ${secTheme.iconColor}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                  </a>
                )}
              </div>
            )}
          </div>
        );
      })
    )}
  </div>

  <!-- ========================================================================= -->
  <!-- 2. VISTA DE TABLA COMPLETA (VISIBLE EN ESCRITORIO O AL ACTIVAR TOGGLE)     -->
  <!-- ========================================================================= -->
  <div class="comp-table-view hidden md:block overflow-x-auto">
    <table class="w-full text-left text-xs sm:text-sm border-collapse m-0 table-auto">
      <thead class="bg-slate-950/90 text-slate-300 uppercase tracking-wider font-bold border-b border-slate-800 text-[11px]">
        <tr>
          {headers.map((h, idx) => (
            <th class={`px-3 sm:px-4 py-3.5 align-middle ${
              idx === 0
                ? 'text-slate-400 border-r border-slate-800/80 min-w-[150px]'
                : 'text-brand-300'
            }`}>
              {h}
            </th>
          ))}
          {hasAnyRowCta && (
            <th class="px-3 sm:px-4 py-3.5 text-center text-emerald-400 align-middle whitespace-nowrap min-w-[140px]">
              Dónde Comprar
            </th>
          )}
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800/80">
        {rows.map((row, rIdx) => {
          const pKey = row.productKey;
          const directUrl = row.ctaUrl;
          const productInfo = pKey ? afiliadosMap[pKey] : null;
          const targetUrl = directUrl || productInfo?.url;
          const tiendaName = productInfo?.tienda || '';
          const hasDual = Boolean(row.secondaryProductKey || row.secondaryCtaUrl);
          const theme = getStoreAffiliateTheme(targetUrl, tiendaName);
          const label = row.ctaLabel || theme.btnText;

          const secKey = row.secondaryProductKey;
          const secDirectUrl = row.secondaryCtaUrl;
          const secInfo = secKey ? afiliadosMap[secKey] : null;
          const secTargetUrl = secDirectUrl || secInfo?.url;
          const secTheme = secTargetUrl ? getStoreAffiliateTheme(secTargetUrl, secInfo?.tienda) : null;
          const secLabel = row.secondaryCtaLabel || (secTheme ? secTheme.btnText : '');

          return (
            <tr class={rIdx % 2 === 0 ? 'bg-surface-card hover:bg-slate-900/40 transition-colors' : 'bg-slate-900/30 hover:bg-slate-900/50 transition-colors'}>
              <td class="px-3 sm:px-4 py-3 font-semibold text-white bg-slate-900/50 border-r border-slate-800/70 leading-snug align-middle">
                {row.feature}
              </td>
              {row.values.map((val, vIdx) => {
                const headerName = headers[vIdx + 1] || '';
                const isPrice = val.includes('$') || headerName.toLowerCase().includes('precio');

                return (
                  <td class={`px-3 sm:px-4 py-3 leading-relaxed align-middle ${
                    isPrice ? 'font-bold font-mono text-emerald-400 whitespace-nowrap' : 'text-slate-200'
                  }`}>
                    {val}
                  </td>
                );
              })}
              {hasAnyRowCta && (
                <td class="px-3 sm:px-4 py-3 text-right align-middle">
                  <div class="flex flex-wrap items-center justify-end gap-1.5 min-w-[130px]">
                    {targetUrl ? (
                      <a
                        href={targetUrl}
                        target="_blank"
                        rel="nofollow sponsored noopener noreferrer"
                        class={`inline-flex items-center justify-center gap-1 px-2.5 py-1.5 rounded-lg font-black text-[11px] shadow-sm hover:scale-105 active:scale-95 transition-all !no-underline border ${theme.btnBg} whitespace-nowrap`}
                        title={`Ver oferta en ${tiendaName || 'tienda'}`}
                      >
                        <span>{label}</span>
                        <svg class={`w-3 h-3 shrink-0 ${theme.iconColor}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                      </a>
                    ) : (
                      !secTargetUrl && <span class="text-slate-600 text-xs">—</span>
                    )}
                    {secTargetUrl && secTheme && (
                      <a
                        href={secTargetUrl}
                        target="_blank"
                        rel="nofollow sponsored noopener noreferrer"
                        class={`inline-flex items-center justify-center gap-1 px-2.5 py-1.5 rounded-lg font-black text-[11px] shadow-sm hover:scale-105 active:scale-95 transition-all !no-underline border ${secTheme.btnBg} whitespace-nowrap`}
                        title="Ver oferta alternativa"
                      >
                        <span>{secLabel}</span>
                        <svg class={`w-3 h-3 shrink-0 ${secTheme.iconColor}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                      </a>
                    )}
                  </div>
                </td>
              )}
            </tr>
          );
        })}

        {/* Fila de cierre con CTAs por Columna (para tablas de Criterio vs Producto A vs Producto B) */}
        {hasColumnCtas && (
          <tr class="bg-slate-950/90 border-t-2 border-slate-800">
            <td class="px-4 sm:px-5 py-4 font-bold text-brand-300 bg-slate-950 border-r border-slate-800/80 align-middle text-xs uppercase tracking-wider">
              🛒 Ver Mejor Oferta
            </td>
            {headers.slice(1).map((h, idx) => {
              const cta = columnCtas[idx];
              const pKey = cta?.productKey;
              const directUrl = cta?.ctaUrl;
              const productInfo = pKey ? afiliadosMap[pKey] : null;
              const targetUrl = directUrl || productInfo?.url;
              const theme = getStoreAffiliateTheme(targetUrl, productInfo?.tienda);
              const label = cta?.ctaLabel || theme.btnFullText;

              return (
                <td class="px-4 sm:px-5 py-4 align-middle">
                  {targetUrl ? (
                    <a
                      href={targetUrl}
                      target="_blank"
                      rel="nofollow sponsored noopener noreferrer"
                      class={`inline-flex items-center gap-2 px-4 py-2 rounded-xl font-black text-xs shadow-md hover:scale-105 active:scale-95 transition-all !no-underline border ${theme.btnBg}`}
                    >
                      <span>{label}</span>
                      <svg class={`w-3.5 h-3.5 shrink-0 ${theme.iconColor}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                      </svg>
                    </a>
                  ) : (
                    <span class="text-slate-500 text-xs">—</span>
                  )}
                </td>
              );
            })}
            {hasAnyRowCta && <td class="px-4 sm:px-5 py-4"></td>}
          </tr>
        )}
      </tbody>
    </table>
  </div>

  <!-- Veredicto Editorial -->
  {verdict && (
    <div class="p-4 bg-brand-950/40 border-t border-brand-900/40 text-xs text-brand-200 flex items-start gap-2.5">
      <span class="text-brand-400 text-sm font-bold shrink-0">💡</span>
      <div class="leading-relaxed">
        <strong class="text-brand-300 mr-1 font-bold">Veredicto Técnico HogarTV:</strong>
        <span>{verdict}</span>
      </div>
    </div>
  )}
</div>

<!-- Script del selector Fichas / Tabla en Móvil -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[data-table-target]').forEach((button) => {
      button.addEventListener('click', () => {
        const targetId = button.getAttribute('data-table-target');
        const view = button.getAttribute('data-view');
        const container = document.getElementById(targetId);
        if (!container) return;

        const cardsView = container.querySelector('.comp-cards-view');
        const tableView = container.querySelector('.comp-table-view');
        const btnCards = container.querySelector('.comp-btn-cards');
        const btnTable = container.querySelector('.comp-btn-table');

        if (view === 'table') {
          cardsView?.classList.add('hidden');
          cardsView?.classList.remove('block');
          tableView?.classList.remove('hidden');
          tableView?.classList.add('block');

          btnTable?.classList.add('bg-brand-600', 'text-white', 'font-bold');
          btnTable?.classList.remove('text-slate-400', 'font-medium');
          btnCards?.classList.remove('bg-brand-600', 'text-white', 'font-bold');
          btnCards?.classList.add('text-slate-400', 'font-medium');
        } else {
          tableView?.classList.add('hidden');
          tableView?.classList.remove('block');
          cardsView?.classList.remove('hidden');
          cardsView?.classList.add('block');

          btnCards?.classList.add('bg-brand-600', 'text-white', 'font-bold');
          btnCards?.classList.remove('text-slate-400', 'font-medium');
          btnTable?.classList.remove('bg-brand-600', 'text-white', 'font-bold');
          btnTable?.classList.add('text-slate-400', 'font-medium');
        }
      });
    });
  });
</script>
