---
import BaseLayout from '../layouts/BaseLayout.astro';
import sitioData from '../data/sitio.json';

const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL || sitioData.emailContacto;
const { horarioAtencion, tiempoRespuesta, ubicacion } = sitioData;

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  'name': 'Contacto | HogarTV.cl',
  'description': 'Canales de contacto oficial de HogarTV.cl para consultas sobre Smart TV, televisión digital y streaming en Chile.',
  'url': 'https://hogartv.cl/contacto',
  'mainEntity': {
    '@type': 'Organization',
    'name': 'HogarTV.cl',
    'email': contactEmail,
    'contactPoint': {
      '@type': 'ContactPoint',
      'contactType': 'customer support',
      'email': contactEmail,
      'availableLanguage': ['Spanish'],
    },
  },
};
---

<BaseLayout
  title="Contacto | HogarTV.cl"
  description="Ponte en contacto con el equipo técnico de HogarTV.cl. Resolvemos dudas sobre televisores, sintonización de TVD en Chile y recomendaciones de compra."
  canonical="https://hogartv.cl/contacto/"
  breadcrumbs={[{ name: 'Contacto', url: '/contacto/' }]}
>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Migas de pan -->
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-8 font-medium">
      <a href="/" class="hover:text-white transition-colors">Inicio</a>
      <span>/</span>
      <span class="text-brand-400 font-semibold">Contacto</span>
    </nav>

    <header class="mb-10 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-950/60 border border-brand-800/40 text-brand-300 text-xs font-semibold uppercase tracking-wider mb-4">
        <span>✉️ Atención a la Comunidad</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
        Contacto y Soporte Técnico
      </h1>
      <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl">
        ¿Tienes dudas sobre qué televisor comprar, cómo orientar tu antena TVD o quieres sugerir un nuevo tutorial para Chile? Escríbenos directamente.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      <!-- Datos de Contacto Clave -->
      <div class="md:col-span-1 space-y-6">
        <div class="bg-surface-card border border-slate-700/80 rounded-2xl p-6 shadow-xl space-y-5">
          <div>
            <span class="text-[11px] uppercase tracking-wider font-bold text-brand-400 block mb-1">Correo Electrónico</span>
            <a
              href={`mailto:${contactEmail}`}
              class="text-sm font-semibold text-white hover:text-brand-300 break-all transition-colors inline-block"
            >
              {contactEmail}
            </a>
          </div>

          <div class="border-t border-slate-800 pt-4">
            <span class="text-[11px] uppercase tracking-wider font-bold text-brand-400 block mb-1">Horario de Atención</span>
            <p class="text-xs text-slate-300 leading-relaxed">
              {horarioAtencion}
            </p>
          </div>

          <div class="border-t border-slate-800 pt-4">
            <span class="text-[11px] uppercase tracking-wider font-bold text-brand-400 block mb-1">Tiempo de Respuesta</span>
            <p class="text-xs text-slate-300 leading-relaxed">
              {tiempoRespuesta}
            </p>
          </div>

          <div class="border-t border-slate-800 pt-4">
            <span class="text-[11px] uppercase tracking-wider font-bold text-brand-400 block mb-1">Ubicación</span>
            <p class="text-xs text-slate-300 leading-relaxed">
              {ubicacion} 🇨🇱
            </p>
          </div>
        </div>

        <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 text-xs text-slate-400">
          <strong class="text-slate-200 block mb-1">¿Qué consultas respondemos?</strong>
          <ul class="space-y-1.5 list-disc list-inside">
            <li>Instalación y orientación técnica en Región del Biobío</li>
            <li>Compatibilidad de Smart TVs con apps en Chile</li>
            <li>Problemas de recepción de TV Digital (TVD)</li>
            <li>Correcciones o sugerencias técnicas</li>
            <li>Contacto comercial o de prensa</li>
          </ul>
        </div>
      </div>

      <!-- Formulario de Contacto -->
      <div class="md:col-span-2">
        <div class="bg-surface-card border border-slate-700/80 rounded-2xl p-6 sm:p-8 shadow-xl">
          <h2 class="text-xl font-bold text-white mb-6">Envíanos un mensaje</h2>

          <form action={`mailto:${contactEmail}`} method="POST" enctype="text/plain" class="space-y-5">
            <div>
              <label for="nombre" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
                Tu Nombre *
              </label>
              <input
                type="text"
                id="nombre"
                name="nombre"
                required
                placeholder="Ej. Juan Pérez"
                class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-all"
              />
            </div>

            <div>
              <label for="email" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
                Tu Correo Electrónico *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="tu@correo.cl"
                class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-all"
              />
            </div>

            <div>
              <label for="motivo" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
                Tema de la Consulta *
              </label>
              <select
                id="motivo"
                name="motivo"
                class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white text-sm focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-all"
              >
                <option value="servicio-tecnico">🛠️ Servicio Técnico / Instalación en Terreno (Región del Biobío)</option>
                <option value="smart-tv">Duda sobre compra de Smart TV</option>
                <option value="tvd">Sintonización de Canales TVD en Chile</option>
                <option value="streaming">Dispositivos de Streaming (Roku, Chromecast, etc.)</option>
                <option value="editorial">Sugerencia editorial o corrección técnica</option>
                <option value="comercial">Contacto comercial o de afiliados</option>
              </select>
            </div>

            <div>
              <label for="mensaje" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
                Mensaje o Pregunta *
              </label>
              <textarea
                id="mensaje"
                name="mensaje"
                rows="5"
                required
                placeholder="Indícanos en qué comuna o región te encuentras y los detalles de tu consulta técnica..."
                class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-all resize-y"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-gradient-to-r from-brand-600 to-indigo-600 hover:from-brand-500 hover:to-indigo-500 text-white font-bold text-sm shadow-lg shadow-brand-600/30 hover:scale-[1.01] active:scale-[0.99] transition-all"
            >
              Enviar Mensaje vía Correo →
            </button>
          </form>
        </div>
      </div>
    </div>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} />
</BaseLayout>
