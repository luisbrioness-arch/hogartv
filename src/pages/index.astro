    secondaryCtaText: 'Alternativa Roku 4K',
    secondaryCtaUrl: afiliadosData['roku-express-4k'].url,
    secondaryCtaClass: 'bg-slate-800 hover:bg-slate-700 text-slate-200 border-slate-600',
