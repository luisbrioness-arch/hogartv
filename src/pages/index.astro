---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import StoreLogo from '../components/StoreLogo.astro';
import AdSlot from '../components/AdSlot.astro';
import sitioData from '../data/sitio.json';
import afiliadosData from '../data/afiliados.json';
import preciosData from '../data/precios.json';

import heroBus from '../assets/accesorios/proyecto-bus-rescate-yumbel-coronel-restauracion-camper-chile/hero.jpg';
import heroSatelital from '../assets/accesorios/instalacion-internet-satelital-rural-chile-redes-parcelas/hero.jpg';
import imgTcl55 from '../assets/smart-tv/mejores-smart-tv-calidad-precio-chile/tcl-c655-55.webp';
import imgXiaomiBox from '../assets/products/xiaomi-tv-box-s-4k.webp';
import imgMagcubic from '../assets/accesorios/proyector-magcubic-hy320.webp';
import imgHuaweiWifi from '../assets/products/router-huawei-wifi7-be3.webp';
import imgRoku4k from '../assets/accesorios/roku-vs-chromecast-chile-cual-conviene/roku-express-4k.webp';
import imgTapoC500 from '../assets/products/camara-wifi-exterior-360.webp';
import imgOnnBox from '../assets/products/onn-google-tv-4k.webp';
import imgFireTv from '../assets/products/amazon-fire-tv-stick-hd.webp';
import imgTvBoxEcono from '../assets/products/tv-box-android-economico.webp';

const allArticles = await getCollection('articles');
const sortedArticles = allArticles.sort((a, b) => {
  const dateDiff = new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime();
  if (dateDiff !== 0) return dateDiff;
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return 0;
});

const latestGuides = sortedArticles.slice(0, 6);
const archiveGuides = sortedArticles.slice(6);

const allHeroes = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/hero.{png,jpg,jpeg,webp,avif}', { eager: true });
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL || sitioData.emailContacto;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  'name': 'HogarTV.cl',
  'url': 'https://hogartv.cl',
  'logo': 'https://hogartv.cl/favicon-512x512.png',
  'description': 'Guías de Smart TVs, TV Box, redes, instalación de Starlink en la Región del Biobío y la serie Reviviendo un Dinosaurio en Chile.',
  'address': {
    '@type': 'PostalAddress',
    'addressCountry': 'CL',
    'addressRegion': 'Región del Biobío',
    'addressLocality': 'Coronel y Gran Concepción, Región del Biobío, Chile',
  },
  'contactPoint': {
    '@type': 'ContactPoint',
    'contactType': 'customer support',
    'email': contactEmail,
    'availableLanguage': ['Spanish'],
  },
  'sameAs': [
    'https://www.tiktok.com/@hogartv.cl',
    'https://www.instagram.com/hogartv.cl/',
    'https://hogartv.cl/sobre-nosotros/',
  ],
};

// Los 6 Equipos Estrella (sin repeticiones, optimizados para vista móvil limpia)
const featuredGear = [
  {
    badge: '🏆 Top TV 55"',
    badgeClass: 'bg-emerald-500 text-slate-950',
    title: 'Smart TV TCL 55" QLED T6D',
    desc: 'Panel QLED 4K real, Google TV oficial sin bloqueos y 120Hz Game Accelerator.',
    price: '$299.990',
    priceSub: 'Falabella · $311.271 M. Libre',
    image: imgTcl55,
    reviewUrl: '/smart-tv/tcl-qled-t6d-55-pulgadas-chile/',
    reviewText: 'Ver análisis',
    primaryNetwork: 'falabella' as const,
    primaryUrl: afiliadosData['falabella-tcl-t6d-55'].url,
    secondaryNetwork: 'mercadolibre' as const,
    secondaryUrl: afiliadosData['tcl-c655-55'].url,
  },
  {
    badge: '👑 Mejor TV Box',
    badgeClass: 'bg-brand-500 text-white',
    title: 'Xiaomi TV Box S 4K (2da Gen)',
    desc: 'Revive cualquier tele lenta en 2 minutos. Google TV fluido y puerto USB.',
    price: preciosData['xiaomi-tv-box-s-4k'].precioFormateado,
    priceSub: 'Envío Full Chile',
    image: imgXiaomiBox,
    reviewUrl: '/accesorios/mejores-tv-box-android-baratos-buenos-chile/',
    reviewText: 'Guía TV Box',
    primaryNetwork: 'mercadolibre' as const,
    primaryUrl: afiliadosData['xiaomi-tv-box-s-4k'].url,
    secondaryNetwork: 'falabella' as const,
    secondaryUrl: afiliadosData['falabella-xiaomi-tv-box'].url,
  },
  {
    badge: '🎬 Cine 100"',
    badgeClass: 'bg-amber-400 text-slate-950',
    title: 'Proyector Magcubic HY320',
    desc: 'Full HD 1080p, Android integrado y giro de 180° al techo para tu pieza.',
    price: preciosData['proyector-magcubic-hy320'].precioFormateado,
    priceSub: 'Picada cine en casa',
    image: imgMagcubic,
    reviewUrl: '/accesorios/como-armar-cine-en-casa-barato-pieza-chile/',
    reviewText: 'Cómo armarlo',
    primaryNetwork: 'mercadolibre' as const,
    primaryUrl: afiliadosData['proyector-magcubic-hy320'].url,
  },
  {
    badge: '🚀 Wi-Fi 7',
    badgeClass: 'bg-indigo-500 text-white',
    title: 'Router Huawei BE3 Wi-Fi 7',
    desc: 'Multiplica tu fibra óptica con puerto 2.5G y acaba con el Wi-Fi lento en casa.',
    price: preciosData['router-huawei-wifi7-be3'].precioFormateado,
    priceSub: 'Top ventas M. Libre',
    image: imgHuaweiWifi,
    reviewUrl: '/accesorios/como-mejorar-wifi-casa-lenta-repetidores-mesh-chile/',
    reviewText: 'Guía Wi-Fi',
    primaryNetwork: 'mercadolibre' as const,
    primaryUrl: afiliadosData['router-huawei-wifi7-be3'].url,
  },
  {
    badge: '👴 Fácil Uso',
    badgeClass: 'bg-purple-500 text-white',
    title: 'Roku Express HD / 4K',
    desc: 'Menú simple con íconos grandes, ideal para papás y adultos mayores.',
    price: preciosData['roku-express-4k'].precioFormateado,
    priceSub: 'Control simplificado',
    image: imgRoku4k,
    reviewUrl: '/accesorios/roku-vs-chromecast-chile-cual-conviene/',
    reviewText: 'Roku vs Stick',
    primaryNetwork: 'mercadolibre' as const,
    primaryUrl: afiliadosData['roku-express-4k'].url,
  },
  {
    badge: '📹 Sin Mensualidad',
    badgeClass: 'bg-sky-500 text-slate-950',
    title: 'Cámara Exterior Wi-Fi 360°',
    desc: 'Visión nocturna, resistencia a lluvia y grabación directa en MicroSD.',
    price: preciosData['camara-wifi-exterior-360'].precioFormateado,
    priceSub: 'Control desde celular',
    image: imgTapoC500,
    reviewUrl: '/accesorios/mejores-camaras-seguridad-wifi-sin-mensualidad-chile/',
    reviewText: 'Ver guía',
    primaryNetwork: 'mercadolibre' as const,
    primaryUrl: afiliadosData['camara-wifi-exterior-360'].url,
  },
];

// Opciones económicas extra de TV Box (plegables en móvil para mantener la portada limpia)
const extraTvBoxes = [
  {
    title: 'Onn. Google TV 4K',
    tag: '🇨🇳 AliExpress Choice',
    price: '$34.990 CLP',
    image: imgOnnBox,
    network: 'aliexpress' as const,
    url: afiliadosData['onn-google-tv-4k'].url,
    btnText: 'Ver en AliExpress',
  },
  {
    title: 'Amazon Fire TV Stick HD',
    tag: '✈️ Envío USA · Alexa',
    price: '$31.443 CLP',
    image: imgFireTv,
    network: 'mercadolibre' as const,
    url: afiliadosData['amazon-fire-tv-stick'].url,
    btnText: 'Ver Oferta',
  },
  {
    title: 'TV Box Android 14 4K',
    tag: '⭐ Económico · 2GB/16GB',
    price: '$29.990 CLP',
    image: imgTvBoxEcono,
    network: 'mercadolibre' as const,
    url: afiliadosData['tv-box-android-economico'].url,
    btnText: 'Ver Oferta',
  },
];

const categories = [
  { icon: '📺', name: 'Smart TVs', sub: '32" a 65" Chile', href: '/smart-tv/' },
  { icon: '📦', name: 'TV Box y Wi-Fi', sub: 'Redes y guías', href: '/accesorios/' },
  { icon: '⚽', name: 'Streaming', sub: 'Zapping, DGO', href: '/streaming/' },
  { icon: '🆓', name: 'TV Abierta HD', sub: 'Antenas TVD', href: '/tv-abierta/' },
  { icon: '🏷️', name: 'Ofertas Hoy', sub: 'Descuentos TV', href: '/ofertas-tv-chile/' },
  { icon: '🛒', name: 'Recomendados', sub: 'Top equipos', href: '/recomendados/' },
];

const waStarlinkUrl =
  'https://wa.me/56931926886?text=Hola%20HogarTV,%20quiero%20consultar%20por%20la%20instalaci%C3%B3n%20de%20Starlink%20o%20redes%20en%20mi%20hogar%20en%20el%20Biob%C3%ADo.';
---

<BaseLayout
  title="HogarTV.cl | Reviviendo un Dinosaurio, Starlink Biobío y Tecnología Chile"
  description="Bitácora oficial de Reviviendo un Dinosaurio (@hogartv.cl), instalación profesional de Starlink y redes en el Biobío, y las mejores guías de Smart TV, TV Box y Wi-Fi en Chile."
>

  <!-- ======================================================================= -->
  <!-- 1. PORTADA LIMPIA MOBILE-FIRST: ACCESO DIRECTO + LOS 2 PILARES          -->
  <!-- ======================================================================= -->
  <section class="pt-4 sm:pt-7 pb-8 sm:pb-12 border-b border-slate-800/80 bg-gradient-to-b from-slate-950 via-surface-dark to-surface-dark w-full max-w-full overflow-x-clip">
    <div class="max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8 space-y-5 sm:space-y-7">

      <!-- Saludo compacto + Accesos Rápidos 2x2 en celular -->
      <div class="space-y-3">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-1.5">
          <div>
            <h1 class="text-xl sm:text-3xl font-black text-white tracking-tight leading-tight">
              Hogar<span class="text-orange-400">TV</span><span class="text-sky-400">.cl</span> — Tech, Starlink y el Dinosaurio
            </h1>
            <p class="text-xs sm:text-sm text-slate-400 mt-0.5">
              Elige rápido a dónde entrar desde tu celular:
            </p>
          </div>
          <a href="/recomendados/" class="hidden sm:inline-flex items-center gap-1 text-xs font-bold text-amber-400 hover:text-amber-300 shrink-0">
            <span>⭐ Ver escaparate de recomendados</span>
            <span>→</span>
          </a>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-2 sm:gap-3">
          <a
            href="/dinosaurio/"
            class="flex items-center gap-2.5 p-2.5 sm:p-3.5 rounded-2xl bg-gradient-to-br from-orange-500/20 to-amber-500/10 border border-amber-500/50 hover:border-amber-400 transition-all group"
          >
            <span class="text-xl sm:text-2xl shrink-0 leading-none">🦖</span>
            <div class="min-w-0">
              <span class="block text-xs sm:text-sm font-black text-amber-300 group-hover:text-white truncate">El Dinosaurio</span>
              <span class="block text-[10px] sm:text-xs text-slate-300 truncate">Capítulos y pauta</span>
            </div>
          </a>

          <a
            href="/servicios/instalacion-starlink-biobio/"
            class="flex items-center gap-2.5 p-2.5 sm:p-3.5 rounded-2xl bg-gradient-to-br from-emerald-500/20 to-teal-500/10 border border-emerald-500/50 hover:border-emerald-400 transition-all group"
          >
            <span class="text-xl sm:text-2xl shrink-0 leading-none">📡</span>
            <div class="min-w-0">
              <span class="block text-xs sm:text-sm font-black text-emerald-300 group-hover:text-white truncate">Starlink Biobío</span>
              <span class="block text-[10px] sm:text-xs text-slate-300 truncate">Desde $95.000 · Cotizar</span>
            </div>
          </a>

          <a
            href="#destacados-tech"
            class="flex items-center gap-2.5 p-2.5 sm:p-3.5 rounded-2xl bg-slate-900/90 border border-brand-500/40 hover:border-brand-400 transition-all group"
          >
            <span class="text-xl sm:text-2xl shrink-0 leading-none">📺</span>
            <div class="min-w-0">
              <span class="block text-xs sm:text-sm font-black text-white group-hover:text-brand-300 truncate">TV Box y TVs</span>
              <span class="block text-[10px] sm:text-xs text-slate-400 truncate">TCL 55" y ofertas</span>
            </div>
          </a>

          <a
            href="/accesorios/como-mejorar-wifi-casa-lenta-repetidores-mesh-chile/"
            class="flex items-center gap-2.5 p-2.5 sm:p-3.5 rounded-2xl bg-slate-900/90 border border-slate-700/80 hover:border-sky-400 transition-all group"
          >
            <span class="text-xl sm:text-2xl shrink-0 leading-none">📶</span>
            <div class="min-w-0">
              <span class="block text-xs sm:text-sm font-black text-white group-hover:text-sky-300 truncate">Mejorar Wi-Fi</span>
              <span class="block text-[10px] sm:text-xs text-slate-400 truncate">Routers y Mesh</span>
            </div>
          </a>
        </div>
      </div>

      <!-- LOS 2 PILARES PRINCIPALES (Lado a lado en PC / 2 tarjetas claras en celular) -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6 items-stretch">

        <!-- PILAR 1: SERIE VIRAL REVIVIENDO UN DINOSAURIO -->
        <article id="proyecto-bus-tiktok" class="rounded-3xl border-2 border-amber-500/60 bg-gradient-to-br from-slate-900 via-slate-950 to-amber-950/25 shadow-2xl overflow-hidden flex flex-col justify-between">
          <div>
            <a href="/dinosaurio/" class="block relative aspect-[16/9] overflow-hidden bg-slate-950 group">
              <Image
                src={heroBus}
                alt="Proyecto rescate y restauración Reviviendo un Dinosaurio desde Yumbel hacia Coronel"
                width={720}
                height={405}
                format="webp"
                quality={86}
                loading="eager"
                fetchpriority="high"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/25 to-transparent"></div>
              <div class="absolute top-3 left-3 right-3 flex flex-wrap items-center justify-between gap-1.5">
                <span class="px-2.5 py-1 rounded-full bg-amber-500 text-slate-950 text-[10px] font-black uppercase tracking-wider shadow-lg">
                  🦖 Serie Viral · Yumbel ➔ Coronel
                </span>
                <span class="px-2.5 py-1 rounded-full bg-slate-950/90 border border-amber-400/50 text-amber-300 text-[10px] font-bold">
                  +62K vistas
                </span>
              </div>
            </a>

            <div class="p-4 sm:p-5 space-y-2">
              <h2 class="text-lg sm:text-xl font-black text-white leading-snug">
                <a href="/dinosaurio/" class="hover:text-amber-300 transition-colors">
                  «Reviviendo un Dinosaurio»: Bitácora, Pauta y Herramientas
                </a>
              </h2>
              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                Rescatamos y estamos restaurando esta micro paso a paso en Coronel: <strong class="text-white">mecánica pesada</strong>, <strong class="text-rose-300">latonería y pintura completa</strong>, y al final <strong class="text-sky-300">cámaras, pantallas, luces y Wi-Fi</strong>.
              </p>
            </div>
          </div>

          <div class="px-4 sm:px-5 pb-4 sm:pb-5 space-y-2.5">
            <a
              href="/dinosaurio/"
              class="w-full inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-gradient-to-r from-orange-500 to-amber-400 hover:from-orange-400 hover:to-amber-300 text-slate-950 font-black text-xs sm:text-sm shadow-lg transition-all"
            >
              <span>🦖 Entrar a hogartv.cl/dinosaurio</span>
              <span>→</span>
            </a>
            <div class="grid grid-cols-2 gap-2">
              <a
                href="https://www.tiktok.com/@hogartv.cl"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl bg-black hover:bg-zinc-900 text-white font-black text-[11px] sm:text-xs border border-[#25F4EE]/60 transition-colors"
              >
                <svg class="w-3.5 h-3.5 shrink-0 text-[#25F4EE]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
                </svg>
                <span>TikTok</span>
              </a>
              <a
                href="https://www.instagram.com/hogartv.cl/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl bg-gradient-to-r from-[#833ab4] via-[#fd1d1d] to-[#fcb045] hover:opacity-95 text-white font-black text-[11px] sm:text-xs transition-opacity"
              >
                <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
                <span>Instagram</span>
              </a>
            </div>
          </div>
        </article>

        <!-- PILAR 2: SERVICIO TÉCNICO STARLINK Y REDES EN EL BIOBÍO -->
        <article id="starlink-biobio" class="rounded-3xl border-2 border-emerald-500/60 bg-gradient-to-br from-slate-900 via-slate-950 to-emerald-950/30 shadow-2xl overflow-hidden flex flex-col justify-between">
          <div>
            <a href="/servicios/instalacion-starlink-biobio/" class="block relative aspect-[16/9] overflow-hidden bg-slate-950 group">
              <Image
                src={heroSatelital}
                alt="Instalación profesional de Starlink, cableado estructurado y cámaras en la Región del Biobío"
                width={720}
                height={405}
                format="webp"
                quality={86}
                loading="eager"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/25 to-transparent"></div>
              <div class="absolute top-3 left-3 right-3 flex flex-wrap items-center justify-between gap-1.5">
                <span class="px-2.5 py-1 rounded-full bg-emerald-500 text-slate-950 text-[10px] font-black uppercase tracking-wider shadow-lg">
                  📡 Servicio en Terreno · Biobío
                </span>
                <span class="px-2.5 py-1 rounded-full bg-slate-950/90 border border-emerald-400/50 text-emerald-300 text-[10px] font-mono font-bold">
                  ⚡ 100–250 Mbps
                </span>
              </div>
            </a>

            <div class="p-4 sm:p-5 space-y-2">
              <h2 class="text-lg sm:text-xl font-black text-white leading-snug">
                <a href="/servicios/instalacion-starlink-biobio/" class="hover:text-emerald-300 transition-colors">
                  Instalación de Starlink, Cableado Estructurado y Cámaras en el Biobío
                </a>
              </h2>
              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                Montaje profesional Gen 3 / Mini en altura, <strong class="text-white">cableado Cat6 con canaletas limpias</strong>, enlaces <strong class="text-emerald-300">compartidos 50/50</strong> y <strong class="text-emerald-300">cámaras PoE/fibra</strong> en Concepción, Coronel, San Pedro, Santa Juana, Yumbel y Los Ángeles.
              </p>
            </div>
          </div>

          <div class="px-4 sm:px-5 pb-4 sm:pb-5 space-y-2.5">
            <a
              href={waStarlinkUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-xs sm:text-sm shadow-lg shadow-emerald-500/20 transition-all"
            >
              <span>📲 Cotizar Instalación por WhatsApp</span>
            </a>
            <a
              href="/servicios/instalacion-starlink-biobio/"
              class="w-full inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-xl bg-slate-800/90 hover:bg-slate-700 text-slate-200 border border-slate-700 font-bold text-xs transition-colors"
            >
              <span>Ver Servicios, Cobertura y Preguntas</span>
              <span>→</span>
            </a>
          </div>
        </article>

      </div>
    </div>
  </section>

  <!-- ======================================================================= -->
  <!-- 2. LOS 6 EQUIPOS MÁS PEDIDOS (SIN DUPLICADOS, COMPACTO EN CELULAR)      -->
  <!-- ======================================================================= -->
  <section id="destacados-tech" class="max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8 py-8 sm:py-12 border-b border-slate-800/70">
    <div class="flex items-end justify-between gap-3 mb-5 sm:mb-7">
      <div>
        <span class="text-[11px] font-black uppercase tracking-wider text-brand-400 block mb-0.5">Selección Verificada Chile</span>
        <h2 class="text-lg sm:text-2xl font-black text-white tracking-tight">
          Lo Más Pedido de TikTok (TV, Wi-Fi y Cine)
        </h2>
      </div>
      <a href="/ofertas-tv-chile/" class="text-xs font-extrabold text-amber-400 hover:text-amber-300 shrink-0">
        Ver ofertas →
      </a>
    </div>

    <!-- Tarjetas horizontales compactas en celular / grilla 3 columnas en escritorio -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-5">
      {featuredGear.map((item) => (
        <article class="rounded-2xl bg-surface-card border border-slate-800 hover:border-brand-500/50 p-3 sm:p-4 flex flex-row md:flex-col gap-3 sm:gap-4 justify-between shadow-lg transition-all">
          <!-- Imagen -->
          <a
            href={item.reviewUrl}
            class="relative w-24 h-24 sm:w-28 sm:h-28 md:w-full md:h-44 rounded-xl bg-white p-2 sm:p-3 shrink-0 flex items-center justify-center overflow-hidden border border-slate-700/60 group"
          >
            <Image
              src={item.image}
              alt={item.title}
              width={260}
              height={200}
              format="webp"
              quality={85}
              loading="lazy"
              class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
            />
            <span class={`hidden md:inline-block absolute top-2 left-2 px-2 py-0.5 rounded-full text-[10px] font-black uppercase shadow ${item.badgeClass}`}>
              {item.badge}
            </span>
          </a>

          <!-- Contenido + Botones -->
          <div class="flex-1 min-w-0 flex flex-col justify-between gap-2">
            <div>
              <div class="flex items-center gap-1.5 mb-1 md:hidden">
                <span class={`px-2 py-0.5 rounded-full text-[9px] font-black uppercase ${item.badgeClass}`}>
                  {item.badge}
                </span>
              </div>
              <h3 class="text-sm sm:text-base font-black text-white leading-snug line-clamp-2">
                <a href={item.reviewUrl} class="hover:text-brand-300 transition-colors">
                  {item.title}
                </a>
              </h3>
              <p class="text-[11px] sm:text-xs text-slate-400 leading-snug line-clamp-2 mt-1">
                {item.desc}
              </p>
            </div>

            <div class="space-y-2 pt-1">
              <div class="flex items-baseline justify-between gap-2">
                <span class="text-sm sm:text-lg font-black font-mono text-emerald-400">{item.price}</span>
                <a href={item.reviewUrl} class="text-[11px] font-bold text-brand-300 hover:text-white underline shrink-0">
                  {item.reviewText} →
                </a>
              </div>

              <div class={`grid gap-1.5 ${item.secondaryUrl ? 'grid-cols-2' : 'grid-cols-1'}`}>
                <a
                  href={item.primaryUrl}
                  target="_blank"
                  rel="nofollow sponsored noopener noreferrer"
                  class={item.primaryNetwork === 'falabella'
                    ? 'inline-flex items-center justify-center gap-1 px-2.5 py-2 rounded-xl bg-[#FAFAFA] hover:bg-white text-slate-900 border-2 border-[#8FCA00] font-black text-[11px] shadow-sm transition-transform hover:scale-[1.01]'
                    : 'inline-flex items-center justify-center gap-1 px-2.5 py-2 rounded-xl bg-[#FFE600] hover:bg-[#F5D600] text-slate-950 font-black text-[11px] shadow-sm transition-transform hover:scale-[1.01]'}
                >
                  <StoreLogo network={item.primaryNetwork} class="h-5" />
                  <span>↗</span>
                </a>
                {item.secondaryUrl && item.secondaryNetwork && (
                  <a
                    href={item.secondaryUrl}
                    target="_blank"
                    rel="nofollow sponsored noopener noreferrer"
                    class={item.secondaryNetwork === 'falabella'
                      ? 'inline-flex items-center justify-center gap-1 px-2.5 py-2 rounded-xl bg-[#FAFAFA] hover:bg-white text-slate-900 border-2 border-[#8FCA00] font-black text-[11px] shadow-sm transition-transform hover:scale-[1.01]'
                      : 'inline-flex items-center justify-center gap-1 px-2.5 py-2 rounded-xl bg-[#FFE600] hover:bg-[#F5D600] text-slate-950 font-black text-[11px] shadow-sm transition-transform hover:scale-[1.01]'}
                  >
                    <StoreLogo network={item.secondaryNetwork} class="h-5" />
                    <span>↗</span>
                  </a>
                )}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Desplegable compacto para TV Box económicos extra (no estorba en celular, accesible en 1 toque) -->
    <details id="tv-box-tiktok" class="mt-4 rounded-2xl bg-slate-900/80 border border-slate-800 p-3.5 sm:p-4 group">
      <summary class="flex items-center justify-between gap-2 cursor-pointer list-none select-none text-xs sm:text-sm font-black text-white">
        <span class="flex items-center gap-2">
          <span>📦</span>
          <span>¿Buscas un TV Box más barato? (Onn 4K, Fire TV Stick, Android 14)</span>
        </span>
        <span class="text-brand-400 text-xs shrink-0 group-open:rotate-180 transition-transform">▼</span>
      </summary>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-4 pt-3 border-t border-slate-800">
        {extraTvBoxes.map((box) => (
          <div class="p-3 rounded-xl bg-slate-950 border border-slate-800 flex items-center gap-3">
            <Image
              src={box.image}
              alt={box.title}
              width={64}
              height={64}
              format="webp"
              loading="lazy"
              class="w-14 h-14 rounded-lg bg-white p-1 object-contain shrink-0"
            />
            <div class="min-w-0 flex-1 space-y-1">
              <div class="text-[10px] font-bold text-amber-300 truncate">{box.tag}</div>
              <div class="text-xs font-black text-white truncate">{box.title}</div>
              <div class="flex items-center justify-between gap-2">
                <span class="text-xs font-mono font-black text-emerald-400">{box.price}</span>
                <a
                  href={box.url}
                  target="_blank"
                  rel="nofollow sponsored noopener noreferrer"
                  class={box.network === 'aliexpress'
                    ? 'px-2.5 py-1 rounded-lg bg-[#E62E04] hover:bg-[#D02600] text-white font-black text-[10px]'
                    : 'px-2.5 py-1 rounded-lg bg-[#FFE600] hover:bg-[#F5D600] text-slate-950 font-black text-[10px]'}
                >
                  {box.btnText} ↗
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </details>
  </section>

  <!-- ======================================================================= -->
  <!-- 3. EXPLORAR POR TEMA (GRID COMPACTO 2x3 EN CELULAR)                     -->
  <!-- ======================================================================= -->
  <section class="max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8 py-7 sm:py-10 border-b border-slate-800/70">
    <h2 class="text-base sm:text-xl font-black text-white tracking-tight mb-4">
      Explorar por Categoría
    </h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5 sm:gap-3">
      {categories.map((cat) => (
        <a
          href={cat.href}
          class="p-3 rounded-2xl bg-surface-card border border-slate-800 hover:border-brand-500/60 flex items-center sm:flex-col sm:text-center gap-2.5 sm:gap-1.5 transition-all group"
        >
          <span class="text-xl sm:text-2xl shrink-0">{cat.icon}</span>
          <div class="min-w-0">
            <span class="block text-xs sm:text-sm font-extrabold text-white group-hover:text-brand-300 truncate">{cat.name}</span>
            <span class="block text-[10px] text-slate-400 truncate">{cat.sub}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ======================================================================= -->
  <!-- 4. GUÍAS RECIENTES (6 DESTACADAS + ARCHIVO PLEGABLE PARA CERO BLOAT)    -->
  <!-- ======================================================================= -->
  <section class="max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8 py-8 sm:py-12">
    <div class="flex items-end justify-between gap-2 mb-5">
      <div>
        <span class="text-[11px] font-bold uppercase tracking-wider text-brand-400 block">Guías Técnicas Chile</span>
        <h2 class="text-lg sm:text-2xl font-black text-white tracking-tight">Últimas Guías y Comparativas</h2>
      </div>
      <span class="text-[11px] text-slate-400 font-semibold shrink-0">{sortedArticles.length} guías</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-6">
      {latestGuides.map((article) => {
        const slug = article.id.replace(/\.(md|mdx)$/, '');
        const heroEntry = Object.entries(allHeroes).find(([filePath]) =>
          filePath.includes(`/${slug}/hero.`)
        );
        const heroImage = heroEntry ? heroEntry[1].default : null;

        return (
          <article class="flex flex-row md:flex-col bg-surface-card border border-slate-800 rounded-2xl overflow-hidden hover:border-brand-500/50 transition-all group">
            <a href={`/${article.data.category}/${slug}/`} class="block relative w-28 sm:w-36 md:w-full aspect-[4/3] md:aspect-video shrink-0 overflow-hidden bg-slate-900">
              {heroImage ? (
                <Image
                  src={heroImage}
                  alt={article.data.title}
                  width={480}
                  height={270}
                  format="webp"
                  quality={82}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center bg-slate-900 text-2xl">📺</div>
              )}
              <span class="hidden md:inline-block absolute top-2.5 left-2.5 bg-slate-950/85 border border-slate-800 text-brand-400 text-[10px] font-bold uppercase px-2 py-0.5 rounded-full">
                {article.data.categoryName}
              </span>
            </a>

            <div class="p-3 sm:p-4 flex-1 min-w-0 flex flex-col justify-between gap-1.5">
              <div>
                <span class="md:hidden text-[10px] font-bold uppercase text-brand-400 block mb-0.5">
                  {article.data.categoryName}
                </span>
                <h3 class="text-xs sm:text-sm md:text-base font-bold text-white group-hover:text-brand-300 transition-colors leading-snug line-clamp-2">
                  <a href={`/${article.data.category}/${slug}/`}>
                    {article.data.title}
                  </a>
                </h3>
                <p class="hidden md:block text-slate-400 text-xs leading-relaxed mt-1.5 line-clamp-2">
                  {article.data.description}
                </p>
              </div>
              <div class="flex items-center justify-between text-[11px] text-slate-400 pt-1">
                <span>⏱️ {article.data.readTime}</span>
                <a href={`/${article.data.category}/${slug}/`} class="font-bold text-brand-400 hover:text-brand-300">
                  Leer →
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Resto del catálogo plegable (mantiene 100% SEO sin alargar el scroll en celular) -->
    {archiveGuides.length > 0 && (
      <details class="mt-5 rounded-2xl bg-slate-900/70 border border-slate-800 p-4 group">
        <summary class="flex items-center justify-between gap-2 cursor-pointer list-none select-none text-xs sm:text-sm font-extrabold text-brand-300 hover:text-white">
          <span>📚 Ver todas las guías publicadas ({archiveGuides.length} artículos más)</span>
          <span class="text-xs group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <ul class="mt-4 pt-3 border-t border-slate-800 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2 text-xs">
          {archiveGuides.map((article) => {
            const slug = article.id.replace(/\.(md|mdx)$/, '');
            return (
              <li>
                <a
                  href={`/${article.data.category}/${slug}/`}
                  class="flex items-center justify-between gap-2 p-2.5 rounded-xl bg-slate-950/70 border border-slate-800/80 hover:border-brand-500/50 text-slate-200 hover:text-white transition-colors"
                >
                  <span class="line-clamp-1 font-medium">{article.data.title}</span>
                  <span class="text-brand-400 shrink-0">→</span>
                </a>
              </li>
            );
          })}
        </ul>
      </details>
    )}
  </section>

  <!-- ESPACIO PUBLICITARIO -->
  <div class="max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8">
    <AdSlot format="banner" label="Espacio Patrocinado" />
  </div>

  <!-- ======================================================================= -->
  <!-- 5. CIERRE COMPACTO: CONTACTO Y SOPORTE BIOBÍO                           -->
  <!-- ======================================================================= -->
  <section id="servicio-tecnico" class="max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8 pt-4 pb-6">
    <div class="rounded-3xl bg-gradient-to-r from-slate-900 via-slate-900 to-emerald-950/30 border border-slate-800 p-5 sm:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 shadow-xl">
      <div class="space-y-1.5">
        <span class="text-[11px] font-black uppercase tracking-wider text-emerald-400 block">🛠️ Región del Biobío</span>
        <h2 class="text-lg sm:text-2xl font-black text-white leading-snug">
          ¿Necesitas instalación de Starlink, redes o antena TVD en tu hogar?
        </h2>
        <p class="text-xs sm:text-sm text-slate-300 max-w-2xl">
          Atendemos en Coronel, San Pedro de la Paz, Concepción, Yumbel, Florida, Santa Juana y alrededores a cargo de la administración técnica de HogarTV.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row gap-2.5 w-full md:w-auto shrink-0">
        <a
          href={waStarlinkUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-xs sm:text-sm shadow-lg transition-all"
        >
          <span>📲 WhatsApp HogarTV</span>
        </a>
        <a
          href="/contacto/"
          class="inline-flex items-center justify-center gap-1.5 px-4 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-white border border-slate-700 font-bold text-xs transition-colors"
        >
          <span>✉️ Formulario Web</span>
        </a>
      </div>
    </div>
  </section>

  <!-- LocalBusiness Schema JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
</BaseLayout>
