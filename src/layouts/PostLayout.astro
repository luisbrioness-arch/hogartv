---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import AuthorAvatar from '../components/AuthorAvatar.astro';
import autoresData from '../data/autores.json';

interface Props {
  title: string;
  description: string;
  category: string;
  categoryName: string;
  publishDate: string;
  dateModified?: string;
  currentSlug?: string;
  readTime?: string;
  ogImage?: string;
  author?: string;
}

const {
  title,
  description,
  category,
  categoryName,
  publishDate,
  dateModified,
  currentSlug = '',
  readTime = '5 min de lectura',
  ogImage,
  author: authorSlug = 'luis-briones',
} = Astro.props;

type AuthorItem = {
  slug: string;
  nombre: string;
  rol: string;
  avatar: string;
  bioCorta: string;
  bioCompleta: string;
  metodologia: string;
  knowsAbout: string[];
  url: string;
};

const authorInfo: AuthorItem =
  (autoresData as Record<string, AuthorItem>)[authorSlug] ||
  (autoresData as Record<string, AuthorItem>)['luis-briones'];

const siteUrl = 'https://hogartv.cl';
const articleUrl = new URL(Astro.url.pathname, siteUrl).href;

// Búsqueda dinámica de imagen principal (hero) en src/assets/{seccion}/{slug}/hero.*
const allHeroes = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/hero.{png,jpg,jpeg,webp,avif}', { eager: true });
const heroEntry = Object.entries(allHeroes).find(([filePath]) => {
  return filePath.includes(`/${currentSlug}/hero.`);
});
const heroImage: ImageMetadata | undefined = heroEntry?.[1]?.default;
const heroAlt = `Guía técnica y comparativa: ${title}`.trim();
if (heroImage && !heroAlt) {
  throw new Error(`[PostLayout] Atributo "alt" es obligatorio para la imagen hero de "${currentSlug}".`);
}

// Obtener artículos relacionados excluyendo el actual
const allArticles = await getCollection('articles');
const relatedArticles = allArticles
  .filter((a) => a.id.replace(/\.(md|mdx)$/, '') !== currentSlug)
  .sort((a, b) => {
    if (a.data.category === category && b.data.category !== category) return -1;
    if (b.data.category === category && a.data.category !== category) return 1;
    return new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime();
  })
  .slice(0, 2);

// Schema.org Article con Person author, dateModified e imagen
const resolvedOgImage = ogImage || (heroImage ? heroImage.src : undefined);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  'headline': title,
  'description': description,
  'image': resolvedOgImage
    ? (resolvedOgImage.startsWith('http') ? resolvedOgImage : `${siteUrl}${resolvedOgImage.startsWith('/') ? '' : '/'}${resolvedOgImage}`)
    : `${siteUrl}/og-image.png`,
  'datePublished': publishDate,
  'dateModified': dateModified || publishDate,
  'mainEntityOfPage': {
    '@type': 'WebPage',
    '@id': articleUrl,
  },
  'publisher': {
    '@type': 'Organization',
    'name': 'HogarTV.cl',
    'url': siteUrl,
    'logo': {
      '@type': 'ImageObject',
      'url': `${siteUrl}/favicon.svg`,
    },
  },
  'author': {
    '@type': 'Person',
    'name': authorInfo.nombre,
    'jobTitle': authorInfo.rol,
    'description': authorInfo.bioCorta,
    'knowsAbout': authorInfo.knowsAbout,
    'url': authorInfo.url,
  },
};
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  publishedTime={publishDate}
  ogImage={resolvedOgImage}
  breadcrumbs={[
    { name: categoryName, url: `/${category}/` },
    { name: title, url: articleUrl },
  ]}
  <!-- Barra de Progreso de Lectura -->
  <div id="reading-progress" class="fixed top-0 left-0 h-1 bg-gradient-to-r from-brand-500 via-indigo-500 to-purple-500 z-50 transition-all duration-150 w-0" aria-hidden="true"></div>

  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Migas de pan (Breadcrumbs) -->
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-6 font-medium">
      <a href="/" class="hover:text-white transition-colors">Inicio</a>
      <span>/</span>
      <a href={`/${category}/`} class="text-brand-400 hover:text-brand-300 transition-colors">{categoryName}</a>
      <span>/</span>
      <span class="text-slate-500 truncate max-w-[200px] sm:max-w-none">{title}</span>
    </nav>

    <!-- Cabecera del Artículo -->
    <header class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-950/60 border border-brand-800/40 text-brand-300 text-xs font-semibold uppercase tracking-wider mb-4">
        <span>📍 {categoryName}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight leading-tight mb-4">
        {title}
      </h1>

      <p class="text-lg sm:text-xl text-slate-300 leading-relaxed mb-6 font-normal">
        {description}
      </p>

      <div class="flex flex-wrap items-center justify-between gap-4 py-4 border-y border-slate-800 text-xs text-slate-400">
        <div class="flex items-center gap-3">
          <a
            href={authorInfo.url}
            title={`Perfil de ${authorInfo.nombre}`}
            class="hover:opacity-90 transition-opacity shrink-0"
          >
            <AuthorAvatar slug={authorSlug} nombre={authorInfo.nombre} size="sm" />
          </a>
          <div>
            <a
              href={authorInfo.url}
              class="text-white font-medium block hover:text-brand-300 transition-colors"
            >
              {authorInfo.nombre}
            </a>
            <span class="text-slate-400 text-[11px] block">{authorInfo.rol}</span>
          </div>
        </div>

        <div class="flex items-center gap-4 text-slate-400">
          <span>📅 Actualizado: {dateModified || publishDate}</span>
          <span>⏱️ {readTime}</span>
        </div>
      </div>
    </header>

    <!-- Imagen Principal (Hero) del Artículo (si existe en src/assets/) -->
    {heroImage && (
      <div class="my-8 rounded-2xl overflow-hidden border border-slate-800 shadow-2xl bg-slate-900">
        <Image
          src={heroImage}
          alt={heroAlt}
          width={1200}
          height={675}
          format="webp"
          loading="eager"
          fetchpriority="high"
          class="w-full h-auto object-cover max-h-[460px]"
        />
      </div>
    )}

    <!-- Alerta de Divulgación de Afiliados (Requisito legal para monetización) -->
    <div class="my-6 p-4 rounded-xl bg-slate-900/90 border border-slate-800 text-xs text-slate-400 flex items-start gap-3">
      <span class="text-brand-400 text-base">💡</span>
      <p class="leading-relaxed">
        <strong class="text-slate-300">Nota de transparencia:</strong> En HogarTV.cl analizamos de forma independiente productos y servicios de televisión en Chile. Algunos enlaces de esta página pueden ser de afiliados (como Mercado Libre o Amazon), lo que nos permite recibir una pequeña comisión si decides comprar, sin costo extra para ti. Conoce más en nuestra <a href="/divulgacion-afiliados/" class="text-brand-400 underline hover:text-brand-300">divulgación de afiliados</a>.
      </p>
    </div>

    <!-- Índice de Contenidos Interactivo (TOC) para SEO y navegación rápida -->
    <details id="article-toc" class="my-6 p-4 sm:p-5 rounded-2xl bg-surface-card border border-slate-800 shadow-md group">
      <summary class="flex items-center justify-between cursor-pointer font-bold text-white text-xs sm:text-sm list-none select-none">
        <span class="flex items-center gap-2">
          <span class="text-brand-400">📑</span>
          <span>Índice del Contenido (Temas de la Guía)</span>
        </span>
        <span class="text-xs text-brand-400 group-open:rotate-180 transition-transform duration-200">▼</span>
      </summary>
      <nav id="toc-nav" class="mt-3 pt-3 border-t border-slate-800/80 text-xs sm:text-sm text-slate-300 space-y-1.5" aria-label="Índice de la página">
      </nav>
    </details>

    <!-- Contenido del Artículo -->
    <div class="article-content">
      <slot />
    </div>

    <!-- Caja de Autor E-E-A-T al final del artículo -->
    <section class="my-12 p-6 rounded-2xl bg-surface-card border border-slate-700/80 shadow-xl flex flex-col sm:flex-row items-center sm:items-start gap-5">
      <a
        href={authorInfo.url}
        class="shrink-0 hover:scale-105 transition-transform"
        title={`Perfil de ${authorInfo.nombre}`}
      >
        <AuthorAvatar slug={authorSlug} nombre={authorInfo.nombre} size="md" />
      </a>

      <div class="flex-1 text-center sm:text-left">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
          <div>
            <span class="text-[10px] text-brand-400 uppercase font-bold tracking-wider block">Autor de la guía</span>
            <a href={authorInfo.url} class="text-base font-bold text-white hover:text-brand-300 transition-colors">
              {authorInfo.nombre}
            </a>
            <span class="text-xs text-slate-400 block sm:inline sm:ml-2">({authorInfo.rol})</span>
          </div>
          <a
            href={authorInfo.url}
            class="text-xs text-brand-400 hover:text-brand-300 font-semibold inline-flex items-center gap-1 justify-center sm:justify-start"
          >
            Ver perfil y experiencia →
          </a>
        </div>

        <p class="text-xs text-slate-300 leading-relaxed mb-3">
          {authorInfo.bioCorta}
        </p>

        <div class="flex flex-wrap gap-1.5 justify-center sm:justify-start">
          {authorInfo.knowsAbout.map((area: string) => (
            <span class="text-[11px] px-2 py-0.5 rounded-md bg-slate-900 border border-slate-800 text-slate-400">
              ✓ {area}
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- Artículos Relacionados (D3) -->
    {relatedArticles.length > 0 && (
      <section class="my-14 pt-8 border-t border-slate-800" aria-labelledby="related-articles-heading">
        <div class="flex items-center justify-between mb-6">
          <div>
            <span class="text-[11px] font-bold text-brand-400 uppercase tracking-wider block mb-1">Continúa aprendiendo</span>
            <h2 id="related-articles-heading" class="text-2xl font-bold text-white tracking-tight">Artículos y Guías Relacionadas</h2>
          </div>
          <a href={`/${category}/`} class="text-xs font-semibold text-brand-400 hover:text-brand-300 transition-colors">
            Ver más en {categoryName} →
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {relatedArticles.map((rel) => {
            const relSlug = rel.id.replace(/\.(md|mdx)$/, '');
            return (
              <a
                href={`/${rel.data.category}/${relSlug}/`}
                class="group p-5 rounded-2xl bg-surface-card border border-slate-800 hover:border-brand-500/50 hover:shadow-xl transition-all duration-300 flex flex-col justify-between"
              >
                <div>
                  <div class="flex items-center justify-between text-xs text-slate-400 mb-2.5">
                    <span class="text-brand-400 font-semibold">{rel.data.categoryName}</span>
                    <span>⏱️ {rel.data.readTime}</span>
                  </div>
                  <h3 class="text-base font-bold text-white group-hover:text-brand-300 transition-colors mb-2 leading-snug">
                    {rel.data.title}
                  </h3>
                  <p class="text-xs text-slate-400 leading-relaxed line-clamp-2 mb-4">
                    {rel.data.description}
                  </p>
                </div>
                <span class="text-xs font-bold text-brand-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                  <span>Leer guía completa</span>
                  <span>→</span>
                </span>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <!-- Bloque de Compartir y Cierre -->
    <footer class="mt-10 pt-8 border-t border-slate-800">
      <div class="bg-gradient-to-r from-slate-900 to-brand-950/40 rounded-2xl p-6 sm:p-8 border border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <h3 class="text-lg font-bold text-white mb-1">¿Te sirvió esta guía?</h3>
          <p class="text-xs text-slate-400">Comparte este tutorial con quien lo necesite o explora más guías técnicas.</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <a
            href={`https://api.whatsapp.com/send?text=${encodeURIComponent(`Te comparto esta guía técnica de HogarTV: ${title} - ${articleUrl}`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition-all inline-flex items-center gap-2 shadow-lg shadow-emerald-950/40"
          >
            <span>💬 Compartir en WhatsApp</span>
          </a>
          <a
            href={`/${category}/`}
            class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-white text-xs font-semibold transition-colors"
          >
            Más en {categoryName}
          </a>
          <a
            href="/"
            class="px-4 py-2 rounded-xl bg-brand-600 hover:bg-brand-500 text-white text-xs font-semibold transition-colors"
          >
            Portada
          </a>
        </div>
      </div>
    </footer>

    <!-- Script de Barra de Progreso y TOC Dinámico -->
    <script is:inline>
      window.addEventListener('scroll', () => {
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = docHeight > 0 ? (window.scrollY / docHeight) * 100 : 0;
        const bar = document.getElementById('reading-progress');
        if (bar) bar.style.width = `${Math.min(progress, 100)}%`;
      }, { passive: true });

      function initTOC() {
        const headings = document.querySelectorAll('.article-content h2, .article-content h3');
        const tocNav = document.getElementById('toc-nav');
        const tocDetails = document.getElementById('article-toc');
        if (!tocNav || headings.length === 0) {
          if (tocDetails) tocDetails.style.display = 'none';
          return;
        }
        tocNav.innerHTML = '';
        headings.forEach((h, idx) => {
          if (!h.id) {
            const cleanText = h.textContent.toLowerCase().trim()
              .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
              .replace(/[^a-z0-9]+/g, '-')
              .replace(/^-|-$/g, '');
            h.id = cleanText || ('seccion-' + (idx + 1));
          }
          const isH3 = h.tagName.toLowerCase() === 'h3';
          const a = document.createElement('a');
          a.href = '#' + h.id;
          a.textContent = h.textContent.replace(/^[0-9]+\.\s*/, '');
          a.className = isH3
            ? 'block pl-4 py-1 text-slate-400 hover:text-brand-300 transition-colors border-l border-slate-800 hover:border-brand-500 text-xs'
            : 'block py-1 font-semibold text-slate-200 hover:text-brand-400 transition-colors text-xs sm:text-sm';
          tocNav.appendChild(a);
        });
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initTOC);
      } else {
        initTOC();
      }
    </script>

  </article>

  <!-- Article Schema JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
</BaseLayout>
