// Selección de Gadgets y Monos Virales (TikTok e Internet Chile)
const viralHighlights = [
  {
    badge: '🦎 Mono Viral #1 en TikTok',
    badgeClass: 'bg-emerald-500 text-slate-950',
    title: 'Lagarto Verde con Movimiento para Tablero de Auto y Moto',
    hook: 'Furor en TikTok e Instagram: adorno impreso en 3D con resorte que baila y se sacude al ritmo del auto y del viento. Se instala en 10 segundos.',
    priceMeli: '$ 5.990 CLP',
    priceAli: '$ 2.990 CLP',
    image: imgLagartija,
    meliUrl: afiliadosData['lagartija-chillona-bicicleta'].url,
    aliUrl: afiliadosData['lagartija-chillona-aliexpress'].url,
    detailUrl: '/accesorios/lagarto-verde-auto-movimiento-viral-tiktok-chile/',
  },
  {
    badge: '🎬 Cine en el Techo',
    badgeClass: 'bg-brand-600 text-white',
    title: 'Mini Proyector Smart Magcubic HY320 Full HD',
    hook: 'El proyector portátil 1080p con giro en 180° que convirtió las piezas en salas de cine gigante de 150\". Con Android 11 y WiFi 6.',
    priceMeli: '$ 59.990 CLP',
    priceAli: '$ 44.990 CLP',
    image: imgMagcubic,
    meliUrl: afiliadosData['proyector-magcubic-hy320'].url,
    aliUrl: afiliadosData['proyector-magcubic-aliexpress'].url,
    detailUrl: '/virales/#proyector-magcubic-hy320',
  },
  {
    badge: '✨ Setup Inmersivo',
    badgeClass: 'bg-purple-600 text-white',
    title: 'Kit Tiras Luces LED RGBIC TV Ambilight USB',
    hook: 'El truco viral para que tu tele económica luzca de $800.000: luces reactivas que se conectan directo al USB de la pantalla.',
    priceMeli: '$ 12.990 CLP',
    priceAli: '$ 8.990 CLP',
    image: imgLucesLed,
    meliUrl: afiliadosData['luces-led-tv-ambilight'].url,
    aliUrl: null,
    detailUrl: '/virales/#luces-led-tv-ambilight',
  },
  {
    badge: '🚀 Revive Cualquier Tele',
    badgeClass: 'bg-amber-500 text-slate-950',
    title: 'Xiaomi TV Box S (2nd Gen) 4K Ultra HD',
    hook: 'Convierte televisores viejos en un centro multimedia con Google TV, Netflix 4K certificado y puerto USB físico para pendrives.',
    priceMeli: '$ 52.990 CLP',
    priceAli: null,
    image: imgXiaomiBox,
    meliUrl: afiliadosData['xiaomi-tv-box-s-4k'].url,
    aliUrl: null,
    detailUrl: '/virales/#xiaomi-tv-box-s-4k',
  },
