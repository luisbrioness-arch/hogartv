---
import { Image } from 'astro:assets';
import hogarTvLogo from '../assets/brand/hogartv-logo.png';

const navLinks = [
  { name: '🦖 Dinosaurio', href: '/dinosaurio/', highlight: true },
  { name: '📡 Starlink Biobío', href: '/accesorios/instalacion-internet-satelital-rural-chile-redes-parcelas/' },
  { name: 'Smart TV', href: '/smart-tv/' },
  { name: 'Accesorios & Redes', href: '/accesorios/' },
  { name: 'Streaming', href: '/streaming/' },
  { name: 'TV Abierta', href: '/tv-abierta/' },
];
---

<!-- Barra Superior Oficial: Síguenos en nuestras redes sociales (visible arriba al entrar, no ocupa pantalla al scrollear) -->
<div class="bg-slate-950 border-b border-slate-800/90 py-2 px-3 sm:px-6 w-full max-w-full overflow-x-clip">
  <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-center sm:justify-between gap-x-3 gap-y-1.5">
    <div class="flex items-center gap-1.5 text-[11px] sm:text-xs font-extrabold text-white">
      <span class="inline-block w-2 h-2 rounded-full bg-[#25F4EE] animate-pulse shrink-0"></span>
      <span>Síguenos en nuestras redes sociales:</span>
    </div>
    <div class="flex items-center gap-2">
      <a
        href="https://www.tiktok.com/@hogartv.cl"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-black hover:bg-zinc-900 text-white font-black text-[11px] sm:text-xs border border-[#25F4EE] shadow-[0_0_10px_rgba(254,44,85,0.35)] transition-transform hover:scale-105"
      >
        <svg class="w-3.5 h-3.5 shrink-0 text-[#25F4EE]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
        </svg>
        <span>TikTok</span>
        <span class="hidden sm:inline text-slate-300 font-bold">@hogartv.cl</span>
      </a>
      <a
        href="https://www.instagram.com/hogartv.cl/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-gradient-to-r from-[#833ab4] via-[#fd1d1d] to-[#fcb045] hover:opacity-95 text-white font-black text-[11px] sm:text-xs shadow-md shadow-rose-500/20 transition-transform hover:scale-105"
      >
        <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
        <span>Instagram</span>
        <span class="hidden sm:inline text-white/90 font-bold">@hogartv.cl</span>
      </a>
    </div>
  </div>
</div>

<!-- Cabecera Principal Sticky Compacta -->
<header class="sticky top-0 z-50 bg-surface-dark/95 backdrop-blur-md border-b border-slate-800/90 w-full max-w-full">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14 sm:h-16 gap-2 min-w-0">

      <!-- Logo Nuevo Oficial HogarTV.cl -->
      <a href="/" class="flex items-center gap-2.5 group min-w-0 shrink-0">
        <Image
          src={hogarTvLogo}
          alt="Logo oficial HogarTV.cl"
          width={44}
          height={44}
          format="webp"
          quality={92}
          loading="eager"
          class="w-10 h-10 sm:w-11 sm:h-11 rounded-full object-contain shrink-0 drop-shadow-[0_0_8px_rgba(56,189,248,0.35)] group-hover:scale-105 transition-transform"
        />
        <div class="flex flex-col min-w-0">
          <span class="text-lg sm:text-xl font-black tracking-tight text-white flex items-baseline leading-none">
            Hogar<span class="text-orange-400">TV</span><span class="text-sky-400 text-sm sm:text-base font-extrabold">.cl</span>
          </span>
          <span class="text-[9px] sm:text-[10px] text-slate-400 tracking-wider uppercase font-semibold truncate">Tech · TV · Biobío</span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Navegación principal">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={link.highlight
              ? 'px-3 py-1.5 rounded-lg text-xs font-black text-slate-950 bg-gradient-to-r from-orange-400 to-amber-400 hover:from-orange-300 hover:to-amber-300 shadow-sm transition-all'
              : 'px-2.5 py-2 rounded-lg text-xs xl:text-sm font-semibold text-slate-300 hover:text-white hover:bg-slate-800/70 transition-colors'}
          >
            {link.name}
          </a>
        ))}
      </nav>

      <!-- Desktop Action Button -->
      <div class="hidden lg:flex items-center gap-2 shrink-0">
        <a
          href="/recomendados/"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-xs font-black text-slate-950 bg-gradient-to-r from-amber-400 via-yellow-400 to-amber-500 hover:from-amber-300 hover:to-yellow-400 shadow-md shadow-amber-500/20 transition-all"
        >
          <span>⭐ Recomendados</span>
        </a>
      </div>

      <!-- Mobile Quick CTA + Menu Toggle -->
      <div class="flex lg:hidden items-center gap-2 shrink-0">
        <a
          href="/dinosaurio/"
          class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg bg-gradient-to-r from-orange-500 to-amber-400 text-slate-950 font-black text-[11px] shadow-sm"
        >
          <span>🦖</span>
          <span>Dinosaurio</span>
        </a>
        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Abrir menú de navegación"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="w-10 h-10 inline-flex items-center justify-center rounded-xl bg-slate-900 border border-slate-700/80 text-slate-200 hover:text-white hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-sky-400"
        >
          <svg id="icon-menu-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg id="icon-menu-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Menú Desplegable Móvil Optimizado (App-style) -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-800 bg-slate-950/98 px-3 pt-3 pb-4 shadow-2xl">
    <div class="max-w-7xl mx-auto space-y-3">
      <!-- Accesos Estrella 2 Columnas -->
      <div class="grid grid-cols-2 gap-2">
        <a
          href="/dinosaurio/"
          class="flex flex-col justify-center p-3 rounded-xl bg-gradient-to-br from-orange-500/20 to-amber-500/10 border border-amber-500/50 text-white"
        >
          <span class="text-base leading-none mb-1">🦖</span>
          <span class="text-xs font-black text-amber-300 leading-tight">El Dinosaurio</span>
          <span class="text-[10px] text-slate-300">Capítulos y pauta</span>
        </a>
        <a
          href="/accesorios/instalacion-internet-satelital-rural-chile-redes-parcelas/"
          class="flex flex-col justify-center p-3 rounded-xl bg-gradient-to-br from-emerald-500/20 to-teal-500/10 border border-emerald-500/50 text-white"
        >
          <span class="text-base leading-none mb-1">📡</span>
          <span class="text-xs font-black text-emerald-300 leading-tight">Starlink Biobío</span>
          <span class="text-[10px] text-slate-300">Hogares y parcelas</span>
        </a>
      </div>

      <!-- Categorías en 2 Columnas -->
      <div class="grid grid-cols-2 gap-1.5 text-xs">
        <a href="/smart-tv/" class="px-3 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-slate-200 font-bold hover:text-white">📺 Smart TVs</a>
        <a href="/accesorios/" class="px-3 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-slate-200 font-bold hover:text-white">📦 TV Box y Wi-Fi</a>
        <a href="/streaming/" class="px-3 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-slate-200 font-bold hover:text-white">⚽ Streaming Chile</a>
        <a href="/tv-abierta/" class="px-3 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-slate-200 font-bold hover:text-white">🆓 TV Abierta HD</a>
        <a href="/recomendados/" class="px-3 py-2.5 rounded-xl bg-amber-400/15 border border-amber-500/40 text-amber-300 font-black">⭐ Recomendados</a>
        <a href="/contacto/" class="px-3 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-slate-200 font-bold hover:text-white">✉️ Contacto</a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('icon-menu-open');
    const iconClose = document.getElementById('icon-menu-close');
    if (!btn || !menu) return;
    btn.addEventListener('click', () => {
      const isHidden = menu.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(!isHidden));
      if (iconOpen && iconClose) {
        iconOpen.classList.toggle('hidden', !isHidden);
        iconClose.classList.toggle('hidden', isHidden);
      }
    });
  })();
</script>
