---
const navLinks = [
  { name: 'Smart TV', href: '/smart-tv/' },
  { name: 'Streaming', href: '/streaming/' },
  { name: 'TV Abierta Chile', href: '/tv-abierta/' },
  { name: 'Accesorios & Redes', href: '/accesorios/' },
  { name: 'Gadgets Hogar', href: '/gadgets-hogar/' },
  { name: 'Recomendados', href: '/recomendados/' },
];
---

<header class="sticky top-0 z-50 bg-surface-dark/95 backdrop-blur-md border-b border-slate-800">
  <!-- Barra Superior Oficial: Síguenos en nuestras redes sociales -->
  <div class="bg-slate-950 border-b border-slate-800/90 py-2 px-3 sm:px-6">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-center sm:justify-between gap-2.5">
      <div class="flex items-center gap-2 text-xs sm:text-sm font-extrabold text-white">
        <span class="inline-block w-2 h-2 rounded-full bg-[#25F4EE] animate-pulse"></span>
        <span>Síguenos en nuestras redes sociales:</span>
      </div>
      <div class="flex items-center gap-2 sm:gap-3">
        <a
          href="https://www.tiktok.com/@hogartv.cl"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-black hover:bg-zinc-900 text-white font-black text-xs border border-[#25F4EE] shadow-[0_0_12px_rgba(254,44,85,0.4)] transition-all hover:scale-105"
        >
          <svg class="w-3.5 h-3.5 shrink-0 text-[#25F4EE]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
          </svg>
          <span>TikTok @hogartv.cl</span>
        </a>
        <a
          href="https://www.instagram.com/hogartv.cl/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-gradient-to-r from-[#833ab4] via-[#fd1d1d] to-[#fcb045] hover:opacity-95 text-white font-black text-xs shadow-md shadow-rose-500/25 transition-all hover:scale-105"
        >
          <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          <span>Instagram @hogartv.cl</span>
        </a>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-indigo-400 flex items-center justify-center shadow-lg shadow-brand-500/25 group-hover:scale-105 transition-transform">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="text-xl font-extrabold tracking-tight text-white flex items-center gap-1">
            Hogar<span class="text-brand-400">TV</span><span class="text-xs px-1.5 py-0.5 rounded bg-brand-500/20 text-brand-300 font-semibold border border-brand-500/30">.cl</span>
          </span>
          <span class="text-[10px] text-slate-400 tracking-wider uppercase font-medium">Guía & Streaming Chile</span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="px-3 py-2 rounded-lg text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800/60 transition-colors"
          >
            {link.name}
          </a>
        ))}
      </nav>

      <!-- Action Button / Badge -->
      <div class="hidden sm:flex items-center gap-3">
        <a
          href="/recomendados/"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-bold text-slate-950 bg-gradient-to-r from-amber-400 via-yellow-400 to-amber-500 hover:from-amber-300 hover:to-yellow-400 shadow-md shadow-amber-500/20 transition-all hover:shadow-amber-500/40"
        >
          <span>⭐ Superventas Chile</span>
        </a>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <div class="flex md:hidden">
        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Abrir menú"
          class="p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 focus:outline-none"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-800 bg-surface-card px-4 pt-2 pb-4 space-y-1">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="block px-3 py-2.5 rounded-lg text-base font-medium text-slate-200 hover:text-white hover:bg-slate-800"
      >
        {link.name}
      </a>
    ))}
    <div class="pt-2">
      <a
        href="/recomendados/"
        class="block text-center w-full px-4 py-2.5 rounded-lg text-sm font-bold text-slate-950 bg-amber-400 hover:bg-amber-300"
      >
        ⭐ Superventas Chile
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
