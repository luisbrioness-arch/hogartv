---
interface Props {
  format?: 'banner' | 'rectangle' | 'in-feed';
  label?: string;
}

const { format = 'in-feed', label = 'Publicidad Recomendada' } = Astro.props;

const formatClasses = {
  'banner': 'min-h-[100px] sm:min-h-[120px] max-w-4xl',
  'rectangle': 'min-h-[250px] max-w-[336px]',
  'in-feed': 'min-h-[120px] max-w-2xl',
};
---

<div class={`my-8 mx-auto w-full ${formatClasses[format]} flex flex-col items-center justify-center rounded-xl bg-slate-900/40 border border-dashed border-slate-800 p-4 text-center text-slate-500 text-xs`}>
  <span class="text-[10px] uppercase tracking-widest text-slate-600 mb-1">{label}</span>
  <div class="flex items-center gap-2 text-slate-500">
    <svg class="w-4 h-4 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
    </svg>
    <span class="text-xs">Espacio optimizado para Google AdSense / Banners (CLS = 0)</span>
  </div>
</div>
