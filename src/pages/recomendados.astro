---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import FAQSection from '../components/FAQSection.astro';

const breadcrumbs = [
  { name: 'Recomendados', url: '/recomendados/' }
];

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'name': 'Equipos y Accesorios Recomendados para Televisión en Chile 2026',
  'description': 'Selección curada y categorizada de los mejores Smart TVs, Streaming Sticks, Antenas Digitales y Sistemas de Audio en Chile.',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Smart TV TCL 55" QD-Mini LED UHD 4K P8L',
      'url': 'https://hogartv.cl/recomendados/#tcl-c655-55'
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': 'Smart TV Samsung 55" 4K Crystal UHD DU7000',
      'url': 'https://hogartv.cl/recomendados/#samsung-du7000-55'
    },
    {
      '@type': 'ListItem',
      'position': 3,
      'name': 'Smart TV Hisense 55" 4K Mini-LED U6K',
      'url': 'https://hogartv.cl/recomendados/#hisense-u6k-55'
    },
    {
      '@type': 'ListItem',
      'position': 4,
      'name': 'Google Chromecast con Google TV 4K',
      'url': 'https://hogartv.cl/recomendados/#chromecast-google-tv'
