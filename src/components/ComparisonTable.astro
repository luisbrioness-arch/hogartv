---
interface Props {
  title?: string;
  headers: string[];
  rows: {
    feature: string;
    values: string[];
  }[];
  verdict?: string;
}

const { title = 'Tabla Comparativa Rápida', headers, rows, verdict } = Astro.props;

// ID único para instanciar controles independientes si hay múltiples tablas
const tableId = 'comp-' + Math.random().toString(36).slice(2, 9);

// Detectar si la primera columna es "Característica", "Criterio", etc.
const firstHeaderLower = (headers[0] || '').toLowerCase();
const isFeatureComparison =
  firstHeaderLower.includes('característica') ||
  firstHeaderLower.includes('caracteristica') ||
  firstHeaderLower.includes('criterio') ||
  firstHeaderLower.includes('especificación') ||
  firstHeaderLower.includes('especificacion');

const optionCount = headers.length - 1;
const isTwoOptions = optionCount === 2;
---

<div class="my-8 rounded-2xl border border-slate-800 bg-surface-card shadow-xl overflow-hidden" id={tableId}>
  <!-- Encabezado de la Comparativa -->
  <div class="bg-slate-900/95 px-4 sm:px-6 py-3.5 border-b border-slate-800 flex items-center justify-between gap-3">
    <div class="flex items-center gap-2.5 min-w-0">
      <div class="w-8 h-8 rounded-lg bg-brand-500/10 border border-brand-500/20 flex items-center justify-center shrink-0">
        <svg class="w-4 h-4 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
        </svg>
      </div>
      <h3 class="text-sm sm:text-base md:text-lg font-bold text-white truncate">
        {title}
      </h3>
    </div>

    <!-- Controles de Vista en Móvil (Por defecto Fichas sin scroll) -->
    <div class="flex items-center gap-2 shrink-0">
      <span class="text-[11px] text-slate-400 font-mono hidden sm:inline-block">Chile 2026</span>
      
      <div class="inline-flex items-center p-0.5 rounded-lg bg-slate-950/80 border border-slate-800 md:hidden" role="tablist" aria-label="Modo de visualización">
        <button
          type="button"
          class="comp-btn-cards px-2.5 py-1 rounded-md text-[11px] font-bold bg-brand-600 text-white shadow-sm transition-all"
          data-table-target={tableId}
          data-view="cards"
          title="Ver fichas adaptadas a la pantalla (sin scroll)"
        >
          📱 Fichas
        </button>
        <button
          type="button"
          class="comp-btn-table px-2.5 py-1 rounded-md text-[11px] font-medium text-slate-400 hover:text-slate-200 transition-all"
          data-table-target={tableId}
          data-view="table"
          title="Ver tabla completa con desplazamiento"
        >
          📊 Tabla
        </button>
      </div>
    </div>
  </div>

  <!-- AVISO SUTIL DE OPTIMIZACIÓN MÓVIL (Solo en pantallas pequeñas) -->
  <div class="md:hidden px-4 py-1.5 bg-slate-950/60 border-b border-slate-800/60 flex items-center justify-between text-[11px] text-slate-400">
    <span class="flex items-center gap-1.5">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>Ajustado a tu pantalla (sin scroll horizontal)</span>
    </span>
    <span class="text-slate-500 font-mono">{rows.length} puntos analizados</span>
  </div>

  <!-- ========================================================================= -->
  <!-- 1. VISTA MÓVIL ADAPTADA (FICHAS 100% EN PANTALLA SIN SCROLL HORIZONTAL)  -->
  <!-- ========================================================================= -->
  <div class="comp-cards-view block md:hidden p-3.5 sm:p-4 space-y-3 bg-slate-950/30">
    {isFeatureComparison ? (
      /* CASO A: Comparación por Característica (Zapping vs DGO, Roku vs Chromecast) */
      rows.map((row) => (
        <div class="rounded-xl border border-slate-800/90 bg-slate-900/70 p-3.5 shadow-sm transition-all">
          <div class="flex items-center gap-2 mb-2.5 pb-2 border-b border-slate-800/80">
            <span class="w-2 h-2 rounded-full bg-brand-400 shrink-0"></span>
            <h4 class="text-xs sm:text-sm font-bold text-white tracking-tight leading-snug">
              {row.feature}
            </h4>
          </div>

          {isTwoOptions ? (
            /* Lado a lado en 2 columnas exactas al 100% del ancho móvil */
            <div class="grid grid-cols-2 gap-2">
              {row.values.map((val, idx) => {
                const optName = headers[idx + 1] || `Opción ${idx + 1}`;
                const isPrice = val.includes('$') || row.feature.toLowerCase().includes('precio');
                const isPrimary = idx === 0;

                return (
                  <div class={`p-2.5 rounded-lg border flex flex-col justify-between ${
                    isPrimary
                      ? 'bg-slate-950/70 border-brand-500/30'
                      : 'bg-slate-950/70 border-indigo-500/30'
                  }`}>
                    <span class={`text-[10px] font-bold uppercase tracking-wider mb-1 line-clamp-1 ${
                      isPrimary ? 'text-brand-300' : 'text-indigo-300'
                    }`}>
                      {optName}
                    </span>
                    <span class={`text-xs leading-relaxed ${
                      isPrice ? 'font-bold text-emerald-400' : 'text-slate-200'
                    }`}>
                      {val}
                    </span>
                  </div>
                );
              })}
            </div>
          ) : (
            /* Más de 2 opciones: lista apilada con identificador */
            <div class="space-y-2">
              {row.values.map((val, idx) => {
                const optName = headers[idx + 1] || `Opción ${idx + 1}`;
                const isPrice = val.includes('$') || row.feature.toLowerCase().includes('precio');

                return (
                  <div class="flex items-start justify-between gap-3 text-xs pt-1.5 border-t border-slate-800/50 first:border-0 first:pt-0">
                    <span class="font-semibold text-brand-300 shrink-0 max-w-[45%] text-[11px]">
                      {optName}:
                    </span>
                    <span class={`text-right ${
                      isPrice ? 'font-bold text-emerald-400' : 'text-slate-200'
                    }`}>
                      {val}
                    </span>
                  </div>
                );
              })}
            </div>
          )}
        </div>
      ))
    ) : (
      /* CASO B: Fila es Producto o Servicio (Smart TVs TCL/Hisense/Samsung, Plataformas de streaming) */
      rows.map((row, rIdx) => {
        // Encontrar precio si existe en las cabeceras
        const priceIdx = headers.findIndex((h) => h.toLowerCase().includes('precio'));
        const priceVal = priceIdx > 0 ? row.values[priceIdx - 1] : null;

        return (
          <div class="rounded-xl border border-slate-800/90 bg-slate-900/70 p-3.5 sm:p-4 shadow-sm relative overflow-hidden">
            <!-- Barra superior del producto -->
            <div class="flex items-start justify-between gap-2 mb-3 pb-2.5 border-b border-slate-800/80">
              <div class="min-w-0">
                <span class="text-[10px] font-bold uppercase tracking-wider text-brand-400 block mb-0.5">
                  {headers[0]}: Opción {rIdx + 1}
                </span>
                <h4 class="text-xs sm:text-sm font-bold text-white leading-snug">
                  {row.feature}
                </h4>
              </div>
              {priceVal && (
                <span class="shrink-0 px-2.5 py-1 rounded-lg bg-emerald-950/80 border border-emerald-800/60 text-emerald-300 font-bold text-xs">
                  {priceVal}
                </span>
              )}
            </div>

            <!-- Lista de atributos formateada -->
            <div class="space-y-2 text-xs">
              {row.values.map((val, idx) => {
                const headerLabel = headers[idx + 1] || '';
                const isPrice = headerLabel.toLowerCase().includes('precio');
                if (isPrice && priceVal) return null; // Ya destacado en la cabecera

                return (
                  <div class="flex items-start justify-between gap-3 pt-1.5 border-t border-slate-800/50 first:border-0 first:pt-0">
                    <span class="text-slate-400 font-medium text-[11px] shrink-0 max-w-[45%]">
                      {headerLabel}:
                    </span>
                    <span class="text-right text-slate-200 font-semibold leading-relaxed">
                      {val}
                    </span>
                  </div>
                );
              })}
            </div>
          </div>
        );
      })
    )}
  </div>

  <!-- ========================================================================= -->
  <!-- 2. VISTA DE TABLA COMPLETA (VISIBLE EN ESCRITORIO O AL ACTIVAR TOGGLE)     -->
  <!-- ========================================================================= -->
  <div class="comp-table-view hidden md:block overflow-x-auto">
    <table class="w-full text-left text-xs sm:text-sm border-collapse">
      <thead class="bg-slate-950/80 text-slate-300 uppercase tracking-wider font-semibold border-b border-slate-800 text-[11px]">
        <tr>
          {headers.map((h, idx) => (
            <th class={`px-4 sm:px-6 py-3.5 ${
              idx === 0 ? 'text-slate-400' : 'text-brand-300'
            }`}>
              {h}
            </th>
          ))}
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800/80">
        {rows.map((row, rIdx) => (
          <tr class={rIdx % 2 === 0 ? 'bg-surface-card hover:bg-slate-900/40 transition-colors' : 'bg-slate-900/30 hover:bg-slate-900/50 transition-colors'}>
            <td class="px-4 sm:px-6 py-3.5 font-semibold text-slate-100 bg-slate-900/50 border-r border-slate-800/60 leading-snug">
              {row.feature}
            </td>
            {row.values.map((val, vIdx) => {
              const headerName = headers[vIdx + 1] || '';
              const isPrice = val.includes('$') || headerName.toLowerCase().includes('precio');

              return (
                <td class={`px-4 sm:px-6 py-3.5 leading-relaxed ${
                  isPrice ? 'font-bold text-emerald-400' : 'text-slate-300'
                }`}>
                  {val}
                </td>
              );
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <!-- Veredicto Editorial -->
  {verdict && (
    <div class="p-4 bg-brand-950/40 border-t border-brand-900/40 text-xs text-brand-200 flex items-start gap-2.5">
      <span class="text-brand-400 text-sm font-bold shrink-0">💡</span>
      <div class="leading-relaxed">
        <strong class="text-brand-300 mr-1 font-bold">Veredicto Técnico HogarTV:</strong>
        <span>{verdict}</span>
      </div>
    </div>
  )}
</div>

<!-- Script del selector Fichas / Tabla en Móvil -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[data-table-target]').forEach((button) => {
      button.addEventListener('click', () => {
        const targetId = button.getAttribute('data-table-target');
        const view = button.getAttribute('data-view');
        const container = document.getElementById(targetId);
        if (!container) return;

        const cardsView = container.querySelector('.comp-cards-view');
        const tableView = container.querySelector('.comp-table-view');
        const btnCards = container.querySelector('.comp-btn-cards');
        const btnTable = container.querySelector('.comp-btn-table');

        if (view === 'table') {
          // Mostrar tabla completa en móvil
          cardsView?.classList.add('hidden');
          cardsView?.classList.remove('block');
          tableView?.classList.remove('hidden');
          tableView?.classList.add('block');

          // Estilo botones
          btnTable?.classList.add('bg-brand-600', 'text-white', 'font-bold');
          btnTable?.classList.remove('text-slate-400', 'font-medium');
          btnCards?.classList.remove('bg-brand-600', 'text-white', 'font-bold');
          btnCards?.classList.add('text-slate-400', 'font-medium');
        } else {
          // Mostrar fichas adaptadas en móvil
          tableView?.classList.add('hidden');
          tableView?.classList.remove('block');
          cardsView?.classList.remove('hidden');
          cardsView?.classList.add('block');

          // Estilo botones
          btnCards?.classList.add('bg-brand-600', 'text-white', 'font-bold');
          btnCards?.classList.remove('text-slate-400', 'font-medium');
          btnTable?.classList.remove('bg-brand-600', 'text-white', 'font-bold');
          btnTable?.classList.add('text-slate-400', 'font-medium');
        }
      });
    });
  });
</script>
